<ui:FluentWindow
    x:Class="TCFModManager.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:TCFModManager.App.Views"
    xmlns:app="clr-namespace:TCFModManager.App"
    xmlns:core="clr-namespace:TCFModManager.Core.Services;assembly=TCFModManager.Core"
    Title="{x:Static core:AppVersion.DisplayTitle}"
    Icon="pack://application:,,,/Assets/AppIcon.ico"
    Height="900"
    Width="1500"
    MinHeight="480"
    MinWidth="720"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Both titles come from the assembly version (see AppVersion) rather than being typed
             here. They used to be two hardcoded strings, which had already drifted a release
             behind what dist\ was shipping - and a stale version number is exactly what would make
             a self-updater either never fire or offer an update the user already has. -->
        <ui:TitleBar
            Grid.Row="0"
            Title="{x:Static core:AppVersion.DisplayTitle}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/AppIcon.ico" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Both banners live in the same row, stacked, so raising one never overlaps the other. -->
        <StackPanel Grid.Row="1">

            <!-- Warning banner shown when no SPT install path is set. -->
            <ui:InfoBar
                Margin="12,8,12,0"
                IsClosable="True"
                Severity="Warning"
                Title="SPT install folder not set"
                Message="You must set your SPT root in the settings first"
                DataContext="{x:Static app:AppServices.SptEnvironment}"
                IsOpen="{Binding IsInstallPathMissing}" />

            <!-- New version of this app published on sp-mod.com. The action button sits beside the
                 InfoBar rather than inside it: InfoBar's own template button is the close button. -->
            <Grid
                Margin="12,8,12,0"
                DataContext="{x:Static app:AppServices.AppUpdate}"
                Visibility="{Binding IsBannerOpen, Converter={StaticResource BoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:InfoBar
                    Grid.Column="0"
                    IsClosable="True"
                    Severity="{Binding BannerSeverity}"
                    Title="{Binding BannerTitle}"
                    Message="{Binding ChangeSummary}"
                    IsOpen="{Binding IsBannerOpen, Mode=TwoWay}" />

                <ui:Button
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Appearance="Primary"
                    Content="See what's new"
                    Icon="{ui:SymbolIcon ArrowCircleUp24}"
                    Click="AppUpdateBanner_Click" />
            </Grid>
        </StackPanel>

        <ui:NavigationView
            x:Name="RootNavigationView"
            Grid.Row="2"
            IsPaneOpen="False">
            <!-- NavigationCacheMode is Disabled by default in WPF-UI, which builds a brand new
                 Page - fresh BAML load, fresh visual tree, fresh ViewModel - on every click of a
                 nav item, including going back to one you were just on. Required keeps one instance
                 of each page for the app's lifetime, so switching views is a content swap rather
                 than a rebuild. Each page's Loaded handler still runs on every visit, so anything
                 that has to refresh on return still does. -->
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    Content="Browse"
                    Icon="{ui:SymbolIcon Apps24}"
                    NavigationCacheMode="Required"
                    TargetPageType="{x:Type views:BrowsePage}" />
                <ui:NavigationViewItem
                    Content="Installed"
                    Icon="{ui:SymbolIcon CheckmarkCircle24}"
                    NavigationCacheMode="Required"
                    TargetPageType="{x:Type views:InstalledPage}" />
                <!-- Directly after Installed: a mod list is a named set of exactly what that page
                     shows, and applying one is how that page's contents get changed wholesale. -->
                <ui:NavigationViewItem
                    Content="Mod lists"
                    Icon="{ui:SymbolIcon AppsList24}"
                    NavigationCacheMode="Required"
                    TargetPageType="{x:Type views:ModListsPage}" />
                <!-- Sits next to Installed because it is about the mods already on disk, and before
                     Dependencies because it is the more everyday of the two. -->
                <ui:NavigationViewItem
                    Content="Configs"
                    Icon="{ui:SymbolIcon EditSettings24}"
                    NavigationCacheMode="Required"
                    TargetPageType="{x:Type views:ConfigsPage}" />
                <ui:NavigationViewItem
                    Content="Dependencies"
                    Icon="{ui:SymbolIcon Branch24}"
                    NavigationCacheMode="Required"
                    TargetPageType="{x:Type views:DependenciesPage}" />
                <ui:NavigationViewItem
                    Content="Downloads"
                    Icon="{ui:SymbolIcon ArrowDownload24}"
                    NavigationCacheMode="Required"
                    TargetPageType="{x:Type views:DownloadsPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <!-- The badge only appears when there's actually an update, and its colour matches
                     the banner's: informational for a bug fix, success for a feature release,
                     attention for a major one. DataContext is set explicitly because an InfoBadge
                     assigned to this property doesn't inherit one from the nav item. -->
                <ui:NavigationViewItem
                    Content="App update"
                    Icon="{ui:SymbolIcon ArrowCircleUp24}"
                    NavigationCacheMode="Required"
                    TargetPageType="{x:Type views:AppUpdatePage}">
                    <ui:NavigationViewItem.InfoBadge>
                        <!-- Width and Height are set, and equal, so the dot stays a circle: with
                             neither given, the badge stretches to whatever slot the nav item hands
                             it and comes out as an oval. Centred so the fixed size doesn't sit
                             against one edge of that slot. -->
                        <ui:InfoBadge
                            Width="10"
                            Height="10"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            DataContext="{x:Static app:AppServices.AppUpdate}"
                            Severity="{Binding BadgeSeverity}"
                            Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}" />
                    </ui:NavigationViewItem.InfoBadge>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem
                    Content="Options"
                    Icon="{ui:SymbolIcon Settings24}"
                    NavigationCacheMode="Required"
                    TargetPageType="{x:Type views:OptionsPage}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!-- Loading overlay shown during the first mod catalog fetch. The scrim stays a
             literal rather than a theme brush on purpose: its job is to dim whatever is
             behind it, which a translucent black does correctly in either theme. -->
        <Border
            Grid.Row="0"
            Grid.RowSpan="3"
            Background="#AA000000"
            DataContext="{x:Static app:AppServices.ModCache}"
            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <ui:Card
                Width="360"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource ApplicationBackgroundBrush}">
                <StackPanel>
                    <TextBlock
                        Text="Loading mod catalog..."
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,4" />
                    <TextBlock
                        TextWrapping="Wrap"
                        TextAlignment="Center"
                        Opacity="0.7"
                        Margin="0,0,0,12"
                        Text="Fetching the full sp-mod.com catalog - this only happens once, future launches load instantly from cache." />
                    <ProgressBar
                        Height="6"
                        Minimum="0"
                        Maximum="{Binding TotalCount}"
                        Value="{Binding LoadedCount, Mode=OneWay}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        Opacity="0.6"
                        Text="{Binding LoadedCount, StringFormat='{}{0:N0} mods loaded'}" />
                </StackPanel>
            </ui:Card>
        </Border>

        <!-- Host presenter for content dialogs, topmost in the grid. -->
        <ContentPresenter
            x:Name="RootContentDialogPresenter"
            Grid.Row="0"
            Grid.RowSpan="3" />
    </Grid>
</ui:FluentWindow>
