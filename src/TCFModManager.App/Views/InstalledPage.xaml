<!-- ScrollViewer.CanContentScroll="False" is the fix that actually made scroll-anywhere work (two
     earlier attempts at this - a bubble MouseWheel handler, then a tunnel PreviewMouseWheel one -
     both failed for a reason neither of them could have addressed): WPF-UI's NavigationView wraps
     every hosted Page's content in its own outer Wpf.Ui.Controls.DynamicScrollViewer by default
     (NavigationViewContentPresenter reads ScrollViewer.GetCanContentScroll(page) each navigation,
     and WPF-UI overrides that property's default for every Page to true app-wide - confirmed by
     decompiling Wpf.Ui.dll in the sandbox with ilspycmd). That outer wrapper sitting above our own
     GroupsScrollViewer is what made the wheel behave so strangely - only the visible scrollbar
     itself (the outer wrapper's) actually worked, not the wheel over our own content. Setting this
     to False here opts this page out of that automatic outer wrapping, leaving GroupsScrollViewer
     as the one and only scrolling container - after which the ordinary WPF wheel/scroll mechanics
     (plus the PreviewMouseWheel handler below, still needed for the unrelated TextBox/ComboBox
     wheel-swallowing issue) work as expected. -->
<Page
    x:Class="TCFModManager.App.Views.InstalledPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    xmlns:viewmodels="clr-namespace:TCFModManager.App.ViewModels"
    Title="Installed"
    Loaded="InstalledPage_Loaded"
    ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToCollapsed" />
        <converters:UpdateAvailableToVisibilityConverter x:Key="UpdateAvailableToVisible" />
        <converters:ModStatusToBrushConverter x:Key="StatusBrush" />
        <converters:FalseToVisibilityConverter x:Key="FalseToVisible" />
        <converters:CountToVisibilityConverter x:Key="HasItems" />
        <converters:BoolToButtonAppearanceConverter x:Key="BoolToAppearance" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- One chip per mod list a mod belongs to, shared by all three views so they can't drift
             apart. Membership comes from ModListMembership, which runs the real planner, so a chip
             here and what applying that list would do can't disagree. ShowLists folds in the
             page-wide toggle as well as "is it in any list at all". -->
        <DataTemplate x:Key="ModListBadges">
            <ItemsControl
                ItemsSource="{Binding Lists}"
                Visibility="{Binding ShowLists, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,2,4,0"
                            Padding="6,1"
                            CornerRadius="3"
                            ToolTip="This mod is in this mod list"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <TextBlock
                                Text="{Binding}"
                                FontSize="10"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis"
                                MaxWidth="140"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
    </Page.Resources>
    <!-- Scroll-anywhere for group view is wired up in code-behind (see the constructor and
         Page_PreviewMouseWheel in InstalledPage.xaml.cs), not via a XAML MouseWheel attribute here
         any more - a plain bubble MouseWheel handler on this Grid turned out not to be reliable:
         several controls (ui:TextBox, ComboBox, ...) have an internal ScrollViewer part that
         swallows the bubbling MouseWheel event and marks it handled even when there's nothing for
         *them* to scroll, so hovering the search box or a combo silently ate the event before it
         ever reached this Grid. Registering a PreviewMouseWheel (tunnel) handler directly on the
         Page runs before any of that - it's first in line for every wheel event over this page,
         full stop.
         Background="Transparent" is still load-bearing here though: a Grid with no Background at
         all only takes part in hit-testing where a child actually paints something, so without it
         the "empty" space in the toolbar rows (and any blank area below a short group list) would
         resolve the hit test to whatever's rendered behind this whole page instead of to anything
         inside it - meaning the event's route would never even pass through the Page, so it
         wouldn't matter where the handler was attached. -->
    <Grid
        x:Name="RootGrid"
        Margin="16"
        Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <ui:Button
                DockPanel.Dock="Right"
                Content="Rescan"
                Command="{Binding ScanCommand}" />

            <!-- Puts the last disable/enable back. A disable only moves folders, so undoing one is
                 just moving them back - shown only while there's something to put back. -->
            <ui:Button
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                Content="{Binding UndoLabel}"
                Icon="{ui:SymbolIcon ArrowUndo24}"
                Command="{Binding UndoCommand}"
                Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}" />

            <!-- Turns the card grid into a tick-list for disabling several mods at once. Cards
                 view only; group view has its own per-group buttons. -->
            <ui:Button
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                Content="Select"
                Icon="{ui:SymbolIcon SelectAllOn24}"
                ToolTip="Tick several mods to enable or disable them together"
                Appearance="{Binding SelectionMode, Converter={StaticResource BoolToAppearance}}"
                Visibility="{Binding ShowCards, Converter={StaticResource BoolToVis}}"
                Click="SelectMode_Click" />

            <!-- Cards/Groups view switcher - deliberately the first, most prominent thing on the
                 page rather than a small toggle buried among the filter row's other switches.
                 Whichever mode is active shows tinted with the theme accent (Appearance="Primary"
                 via BoolToAppearance); the other stays Secondary. -->
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                <ui:Button
                    Padding="12,7"
                    FontWeight="SemiBold"
                    Content="Cards"
                    Icon="{ui:SymbolIcon Apps24}"
                    Appearance="{Binding ShowCards, Converter={StaticResource BoolToAppearance}}"
                    Click="CardsView_Click" />
                <ui:Button
                    Margin="8,0,0,0"
                    Padding="12,7"
                    FontWeight="SemiBold"
                    Content="Groups"
                    Icon="{ui:SymbolIcon Folder24}"
                    Appearance="{Binding ShowGroups, Converter={StaticResource BoolToAppearance}}"
                    ToolTip="Sort mods into your own groups, MO2-separator style."
                    Click="GroupsView_Click" />
                <ui:Button
                    Margin="8,0,0,0"
                    Padding="12,7"
                    FontWeight="SemiBold"
                    Content="List"
                    Icon="{ui:SymbolIcon TextBulletListSquare24}"
                    Appearance="{Binding ShowList, Converter={StaticResource BoolToAppearance}}"
                    ToolTip="One scrollable row per mod, each opening onto its full details."
                    Click="ListView_Click" />
            </StackPanel>

            <TextBlock
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Opacity="0.8"
                Text="{Binding StatusMessage}" />
        </DockPanel>

        <!-- Search box and filter toggles. -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- The Fika / ads / AI toggles that used to sit along this row are now three of
                     the five tick boxes in the "Show" dropdown below, next to the other filters.
                     This one stays here because it is a display preference rather than a filter:
                     it changes what each row draws, not which rows are shown, so Clear filters
                     leaves it alone and it is remembered between sessions. -->
                <ui:ToggleSwitch
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    ToolTip="Show which mod lists each mod belongs to."
                    IsChecked="{Binding ShowListBadges}"
                    OnContent="List badges"
                    OffContent="List badges" />
            </StackPanel>

            <ui:TextBox
                Width="320"
                HorizontalAlignment="Left"
                PlaceholderText="Search mods... (@author for author)"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <DockPanel Grid.Row="2" Margin="0,0,0,8">
            <ui:Button
                DockPanel.Dock="Right"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Content="Clear filters"
                Command="{Binding ClearFiltersCommand}" />

            <!-- A WrapPanel: seven filters don't fit on one line at every window width, and a
                 filter that has run off the edge of the page may as well not exist. -->
            <WrapPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,4">
                    <TextBlock Text="Update status:" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox
                        MinWidth="120"
                        ItemsSource="{Binding UpdateFilterOptions}"
                        SelectedItem="{Binding SelectedUpdateFilter}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,4">
                    <TextBlock Text="Enabled:" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox
                        MinWidth="120"
                        ItemsSource="{Binding EnabledFilterOptions}"
                        SelectedItem="{Binding SelectedEnabledFilter}" />
                </StackPanel>

                <!-- The same five tick boxes Browse carries. "Has dependencies" is answered from
                     the dependency graph built off the scan, so unlike Browse's it covers
                     everything installed rather than what has been looked up so far. -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,4">
                    <TextBlock Text="Show:" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ToggleButton x:Name="AttributeToggle" MinWidth="170" Style="{StaticResource FilterDropDownToggle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding AttributeFilterSummary}" />
                            <ui:SymbolIcon
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{DynamicResource ComboBoxDropDownGlyphForeground}"
                                Symbol="ChevronDown24" />
                        </Grid>
                    </ToggleButton>
                </StackPanel>
                <Popup
                    IsOpen="{Binding IsChecked, ElementName=AttributeToggle, Mode=TwoWay}"
                    PlacementTarget="{Binding ElementName=AttributeToggle}"
                    Placement="Bottom"
                    StaysOpen="False"
                    AllowsTransparency="True">
                    <Border Style="{StaticResource FilterDropDownPopup}" MinWidth="{Binding ActualWidth, ElementName=AttributeToggle}">
                        <ItemsControl Margin="8,4" ItemsSource="{Binding AttributeOptions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox
                                        Margin="2"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                        Content="{Binding Label}"
                                        ToolTip="{Binding ToolTip}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Popup>

                <!-- Built from the categories actually present in this install, not the whole
                     catalog - a category none of your mods are in would only ever show nothing. -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,4">
                    <TextBlock Text="Category:" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox
                        MinWidth="150"
                        ItemsSource="{Binding CategoryOptions}"
                        SelectedItem="{Binding SelectedCategory}" />
                </StackPanel>

                <!-- Rebuilt from the group store whenever groups change, so it always lists exactly
                     the groups that exist. Applies to all three views, like every other filter here. -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,4">
                    <TextBlock Text="Group:" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox
                        MinWidth="130"
                        ItemsSource="{Binding GroupFilterOptions}"
                        SelectedItem="{Binding SelectedGroupFilter}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,4">
                    <TextBlock Text="Sort by:" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox
                        MinWidth="140"
                        ItemsSource="{Binding SortOptions}"
                        SelectedItem="{Binding SelectedSortOption}" />
                </StackPanel>

                <!-- Pagination is hidden in group view (see the pagination StackPanel's own
                     Visibility below), so "Per page" would have nothing to affect there. -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,4" Visibility="{Binding ShowCards, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Per page:" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox
                        MinWidth="60"
                        ItemsSource="{Binding PageSizeOptions}"
                        SelectedItem="{Binding PageSize}" />
                </StackPanel>
            </WrapPanel>
        </DockPanel>

        <!-- Multi-select bar. Shares row 3 with the group management bar below, which is safe
             because switching to group view turns selection mode off (see
             InstalledViewModel.OnViewModeChanged) - the two can never show together. -->
        <DockPanel
            Grid.Row="3"
            Margin="0,0,0,8"
            Visibility="{Binding SelectionMode, Converter={StaticResource BoolToVis}}">
            <ui:Button
                DockPanel.Dock="Right"
                Content="Clear"
                Command="{Binding ClearSelectionCommand}" />
            <ui:Button
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                Content="{Binding SelectAllLabel}"
                Icon="{ui:SymbolIcon SelectAllOn24}"
                ToolTip="Select everything the current filters match, across every page - not just the page on screen."
                Command="{Binding SelectAllCommand}" />
            <ui:Button
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                Appearance="Primary"
                Content="Update selected"
                Icon="{ui:SymbolIcon ArrowDownload24}"
                ToolTip="Queue an update for every selected mod that has one. Mods with no update, disabled mods and addons are skipped."
                Command="{Binding UpdateSelectedCommand}" />
            <ui:Button
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                Content="Enable selected"
                Icon="{ui:SymbolIcon PlugConnected24}"
                Command="{Binding EnableSelectedCommand}" />
            <ui:Button
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                Content="Disable selected"
                Icon="{ui:SymbolIcon PlugDisconnected24}"
                Command="{Binding DisableSelectedCommand}" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Opacity="0.8"
                Text="{Binding SelectedCountLabel}" />
        </DockPanel>

        <!-- Group management bar - only meaningful, so only shown, in group view. -->
        <DockPanel
            Grid.Row="3"
            Margin="0,0,0,8"
            Visibility="{Binding ShowGroups, Converter={StaticResource BoolToVis}}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Sort groups:" Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox
                    MinWidth="150"
                    ItemsSource="{Binding GroupSortOptions}"
                    SelectedItem="{Binding SelectedGroupSortOption}" />
            </StackPanel>
            <ui:Button
                DockPanel.Dock="Right"
                Margin="0,0,16,0"
                Content="Add group"
                Icon="{ui:SymbolIcon Add24}"
                Command="{Binding AddGroupCommand}" />
            <ui:TextBox
                Width="220"
                HorizontalAlignment="Left"
                PlaceholderText="New group name..."
                Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <!-- Installed mods grid; column count is set from code-behind based on width. Hidden in
             group view (see Sections below, occupying the same cell). -->
        <ListBox
            x:Name="ResultsListBox"
            Grid.Row="4"
            Padding="4"
            BorderThickness="0"
            Background="Transparent"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            Visibility="{Binding ShowCards, Converter={StaticResource BoolToVis}}"
            ItemsSource="{Binding Results}"
            SelectionChanged="ResultsListBox_SelectionChanged"
            SizeChanged="ResultsListBox_SizeChanged">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding Columns}" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="6" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="VerticalAlignment" Value="Stretch" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- Stretches card content so the icon column can pin to top/bottom edges. -->
                    <!-- Opacity is the whole-card cue for a disabled mod (CardOpacity is 1.0 when
                         enabled, so an enabled card is unaffected); the "Disabled" chip below and
                         the status icon carry the same state for anyone who can't read a dimming. -->
                    <ui:Card
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Opacity="{Binding CardOpacity}"
                        ClipToBounds="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Only shown in multi-select mode; a card click toggles it too. -->
                            <CheckBox
                                Grid.Column="0"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                IsChecked="{Binding IsSelected}"
                                Visibility="{Binding DataContext.SelectionMode, RelativeSource={RelativeSource AncestorType={x:Type Page}}, Converter={StaticResource BoolToVis}}" />

                            <!-- Mod title and details, one consistent text size throughout. -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <!-- Catalog title, falling back to the installed folder/package name. -->
                                <TextBlock
                                    Text="{Binding DisplayTitle}"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis" />

                                <Border
                                    HorizontalAlignment="Left"
                                    Margin="0,2,0,2"
                                    Padding="6,1"
                                    CornerRadius="3"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    Visibility="{Binding IsDisabled, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="DISABLED" FontSize="10" FontWeight="SemiBold" />
                                </Border>

                                <ContentPresenter
                                    ContentTemplate="{StaticResource ModListBadges}"
                                    Content="{Binding}" />

                                <!-- Says what an addon is attached to; an addon's own name rarely
                                     does, and it decides which versions of it can be installed. -->
                                <TextBlock
                                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    Text="{Binding AddonSubtitle}"
                                    Visibility="{Binding AddonSubtitle, Converter={StaticResource NullToCollapsed}}" />

                                <!-- On-disk folder/package name, shown only if different from the title. -->
                                <TextBlock
                                    Opacity="0.6"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{Binding FolderNameIfDifferent, Converter={StaticResource NullToCollapsed}}">
                                    <Run Text="Installed as: " />
                                    <Run Text="{Binding FolderNameIfDifferent, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Text="{Binding Guid}"
                                    Opacity="0.5"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{Binding Guid, Converter={StaticResource NullToCollapsed}}" />

                                <TextBlock TextTrimming="CharacterEllipsis" Opacity="0.6">
                                    <Run Text="Installed: " />
                                    <Run Text="{Binding InstalledVersion, TargetNullValue='unknown', Mode=OneWay}" />
                                </TextBlock>

                                <!-- Shown only when client and server versions disagree. -->
                                <TextBlock
                                    Text="{Binding InstalledVersionDetail}"
                                    Opacity="0.6"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{Binding InstalledVersionDetail, Converter={StaticResource NullToCollapsed}}" />

                                <TextBlock Opacity="0.6" TextTrimming="CharacterEllipsis">
                                    <Run Text="Latest published: " />
                                    <Run Text="{Binding LatestPublishedText, Mode=OneWay}" />
                                </TextBlock>

                                <!-- Shown only when the mod matched a catalog listing. -->
                                <TextBlock
                                    Opacity="0.6"
                                    Visibility="{Binding LatestUpdatedAt, Converter={StaticResource NullToCollapsed}}">
                                    <Run Text="Last updated: " />
                                    <Run Text="{Binding LatestUpdatedAt, StringFormat='{}{0:d}', Mode=OneWay}" />
                                </TextBlock>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Text="{Binding TargetSummary}"
                                        Opacity="0.6" />
                                    <TextBlock
                                        Text="{Binding InstalledAt, StringFormat=' • installed {0:d}'}"
                                        Opacity="0.6"
                                        Visibility="{Binding InstalledAt, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Update icon and action buttons, pinned to the card's top/bottom edges. -->
                            <Grid Grid.Column="2">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Status icon, same set Browse and Dependencies use; clicking the card
                                     opens the update dialog. Always shown, so an up-to-date mod reads as
                                     checked rather than as an absent icon. -->
                                <ui:SymbolIcon
                                    Grid.Row="0"
                                    Margin="6"
                                    HorizontalAlignment="Center"
                                    FontSize="20"
                                    Symbol="{Binding StatusGlyph}"
                                    Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"
                                    ToolTip="{Binding StatusTooltip}" />

                                <!-- Disable/enable toggle above Remove: the non-destructive action
                                     sits next to the destructive one, deliberately not coloured red. -->
                                <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                                    <!-- Only for a mod found in both an enabled and a disabled
                                         folder, which the toggle alone can't settle. -->
                                    <ui:Button
                                        Margin="6,6,6,0"
                                        HorizontalAlignment="Center"
                                        Padding="6"
                                        Appearance="Transparent"
                                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                        Content="Sort out"
                                        FontSize="11"
                                        Visibility="{Binding HasDuplicateFolders, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.ResolveDuplicateCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="This mod is in both an enabled and a disabled folder - pick which copy to keep" />

                                    <ui:Button
                                        Margin="6,6,6,0"
                                        HorizontalAlignment="Center"
                                        Padding="6"
                                        Appearance="Transparent"
                                        Command="{Binding DataContext.ToggleDisableCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding DisableToggleTooltip}">
                                        <ui:SymbolIcon Symbol="{Binding DisableToggleGlyph}" FontSize="16" />
                                    </ui:Button>

                                    <!-- Remove button, colored red as a destructive action. -->
                                    <ui:Button
                                        Margin="6"
                                        HorizontalAlignment="Center"
                                        Padding="6"
                                        Appearance="Transparent"
                                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                        CommandParameter="{Binding}"
                                        Icon="{ui:SymbolIcon Delete24}"
                                        ToolTip="Remove this mod" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ui:Card>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Group view: one collapsible section per user-defined group, plus a fixed Ungrouped
             bucket last. Occupies the same cell as ResultsListBox above; only one of the two is
             visible at a time. Each section's whole card is a drop target so a drop lands
             correctly even while collapsed. -->
        <!-- Focusable="False" here and on both nested ItemsControls below: none of them offer any
             keyboard interaction, and leaving them focusable meant a plain click on a mod row (a
             non-focusable Border) bubbled focus up to the nearest focusable ancestor - normally
             this ScrollViewer or one of the ItemsControls - which then re-centered/nudged itself
             into view and produced a small unwanted scroll jump the instant you clicked. See also
             ModRow_PreviewMouseLeftButtonDown's e.Handled = true in code-behind, which stops that
             same default click-focus assignment before it starts. -->
        <!-- AllowDrop here isn't about dropping onto the ScrollViewer - it never accepts a drop.
             It's what makes WPF raise drag events at all over the parts of the list no card
             covers (the gaps between cards, and the empty space below a short list), so the
             edge auto-scroll in code-behind keeps tracking the pointer there too. The DragOver /
             DragLeave / Drop handlers that drive it are registered in the constructor rather than
             as attributes here, because they need handledEventsToo. Background="Transparent" is the
             other half of that: a ScrollViewer with no Background isn't hit-tested where nothing
             inside it paints, so without this the drag events would still stop short of those same
             gaps. Same distinction as RootGrid's Background - Transparent participates in hit
             testing, unset does not. -->
        <ScrollViewer
            x:Name="GroupsScrollViewer"
            Grid.Row="4"
            AllowDrop="True"
            Background="Transparent"
            Focusable="False"
            VerticalScrollBarVisibility="Auto"
            Visibility="{Binding ShowGroups, Converter={StaticResource BoolToVis}}">
            <ItemsControl Focusable="False" ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewmodels:ModGroupSectionViewModel}">
                        <ui:Card
                            Margin="0,0,6,8"
                            Padding="10"
                            AllowDrop="True"
                            DragOver="Section_DragOver"
                            Drop="Section_Drop">
                            <StackPanel>
                                <!-- Section header: collapse toggle, name (or rename box), reorder/rename/delete. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ui:Button
                                        Grid.Column="0"
                                        Padding="4"
                                        Margin="0,0,6,0"
                                        Appearance="Transparent"
                                        Visibility="{Binding IsRealGroup, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.ToggleCollapsedCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Expand/collapse this group">
                                        <ui:SymbolIcon Symbol="{Binding ChevronGlyph}" FontSize="16" />
                                    </ui:Button>

                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{Binding IsEditing, Converter={StaticResource FalseToVisible}}">
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" " />
                                            <Run Text="{Binding CountLabel, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding StateLabel, Mode=OneWay}" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                        </TextBlock>

                                        <ui:TextBox
                                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                            KeyDown="RenameTextBox_KeyDown"
                                            LostFocus="RenameTextBox_LostFocus" />
                                    </Grid>

                                    <StackPanel
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        Visibility="{Binding IsRealGroup, Converter={StaticResource BoolToVis}}">
                                        <!-- Whole-group enable/disable/invert. Kept to real groups
                                             rather than offered on Ungrouped too, where it would
                                             usually mean "every mod that isn't sorted yet". Each
                                             one goes through the same dependency warning a single
                                             mod does. -->
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Margin="0,0,6,0"
                                            Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                                            <ui:Button
                                                Padding="4"
                                                Appearance="Transparent"
                                                ToolTip="Enable every mod in this group"
                                                Command="{Binding DataContext.EnableGroupCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}"
                                                Icon="{ui:SymbolIcon PlugConnected24}" />
                                            <ui:Button
                                                Padding="4"
                                                Appearance="Transparent"
                                                ToolTip="Disable every mod in this group"
                                                Command="{Binding DataContext.DisableGroupCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}"
                                                Icon="{ui:SymbolIcon PlugDisconnected24}" />
                                            <ui:Button
                                                Padding="4"
                                                Appearance="Transparent"
                                                ToolTip="Swap this group over - disable what's on, enable what's off"
                                                Command="{Binding DataContext.InvertGroupCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}"
                                                Icon="{ui:SymbolIcon ArrowSwap24}" />
                                        </StackPanel>

                                        <!-- Only meaningful (and only shown) while groups are in their manual
                                             order - an alphabetical group sort would just fight these. -->
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Visibility="{Binding DataContext.CanReorderGroups, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}, Converter={StaticResource BoolToVis}}">
                                            <ui:Button
                                                Padding="4"
                                                Appearance="Transparent"
                                                ToolTip="Move up"
                                                Command="{Binding DataContext.MoveGroupUpCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}"
                                                Icon="{ui:SymbolIcon ChevronUp24}" />
                                            <ui:Button
                                                Padding="4"
                                                Appearance="Transparent"
                                                ToolTip="Move down"
                                                Command="{Binding DataContext.MoveGroupDownCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}"
                                                Icon="{ui:SymbolIcon ChevronDown24}" />
                                        </StackPanel>
                                        <ui:Button
                                            Padding="4"
                                            Margin="6,0,0,0"
                                            Appearance="Transparent"
                                            ToolTip="Rename"
                                            Command="{Binding DataContext.BeginRenameCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}"
                                            Icon="{ui:SymbolIcon Edit24}" />
                                        <ui:Button
                                            Padding="4"
                                            Appearance="Transparent"
                                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                            ToolTip="Delete this group"
                                            Command="{Binding DataContext.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}"
                                            Icon="{ui:SymbolIcon Delete24}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Mods in this group; hidden while collapsed. Each row is a drag source. -->
                                <Grid
                                    Margin="0,8,0,0"
                                    Visibility="{Binding IsCollapsed, Converter={StaticResource FalseToVisible}}">
                                    <TextBlock
                                        Padding="4"
                                        Opacity="0.5"
                                        FontStyle="Italic"
                                        Text="Drag mods here"
                                        Visibility="{Binding Items.Count, Converter={StaticResource HasItems}, ConverterParameter=Invert}" />

                                    <ItemsControl Focusable="False" ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type viewmodels:InstalledModCardViewModel}">
                                                <Border
                                                    Style="{StaticResource ClickableCardRow}"
                                                    Margin="0,0,0,4"
                                                    Padding="8,6"
                                                    Opacity="{Binding CardOpacity}"
                                                    ToolTip="Click for details - drag onto another group to move it there"
                                                    PreviewMouseLeftButtonDown="ModRow_PreviewMouseLeftButtonDown"
                                                    PreviewMouseMove="ModRow_PreviewMouseMove"
                                                    PreviewMouseLeftButtonUp="ModRow_PreviewMouseLeftButtonUp">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <ui:SymbolIcon
                                                            Grid.Column="0"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="16"
                                                            Symbol="{Binding StatusGlyph}"
                                                            Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"
                                                            ToolTip="{Binding StatusTooltip}" />

                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock
                                                                FontWeight="SemiBold"
                                                                TextTrimming="CharacterEllipsis"
                                                                Text="{Binding DisplayTitle}" />
                                                            <TextBlock
                                                                FontSize="11"
                                                                Opacity="0.6"
                                                                TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding InstalledVersion, TargetNullValue='unknown', Mode=OneWay}" />
                                                                <Run Text=" • " />
                                                                <Run Text="{Binding TargetSummary, Mode=OneWay}" />
                                                                <Run Text=" • " />
                                                                <Run Text="{Binding Author, TargetNullValue='unknown author', Mode=OneWay}" />
                                                            </TextBlock>

                                                            <ContentPresenter
                                                                ContentTemplate="{StaticResource ModListBadges}"
                                                                Content="{Binding}" />
                                                        </StackPanel>

                                                        <!-- Per-row disable toggle. ModRow_PreviewMouseLeftButtonDown
                                                             steps aside for anything inside a button, so this click
                                                             isn't swallowed by the row's own click/drag gesture. -->
                                                        <ui:Button
                                                            Grid.Column="2"
                                                            Padding="4"
                                                            VerticalAlignment="Center"
                                                            Appearance="Transparent"
                                                            Command="{Binding DataContext.ToggleDisableCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                            CommandParameter="{Binding}"
                                                            ToolTip="{Binding DisableToggleTooltip}">
                                                            <ui:SymbolIcon Symbol="{Binding DisableToggleGlyph}" FontSize="16" />
                                                        </ui:Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- List view: the same filtered, sorted set as the other two, one expandable row per mod.
             The header carries what you scan for; the body carries everything the app knows about
             the mod. Occupies the same cell as the two views above; only one is ever visible.
             Focusable="False" for the same reason it's set on the group list - a click inside a row
             shouldn't bubble focus up and nudge the scroller. -->
        <ScrollViewer
            x:Name="ListScrollViewer"
            Grid.Row="4"
            Focusable="False"
            VerticalScrollBarVisibility="Auto"
            Visibility="{Binding ShowList, Converter={StaticResource BoolToVis}}">
            <ItemsControl Focusable="False" ItemsSource="{Binding ListItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewmodels:InstalledModCardViewModel}">
                        <ui:CardExpander Style="{StaticResource HoverCardExpander}" Margin="0,0,6,6" Opacity="{Binding CardOpacity}">
                            <ui:CardExpander.Header>
                                <Grid Margin="0,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ui:SymbolIcon
                                        Grid.Column="0"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Symbol="{Binding StatusGlyph}"
                                        Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"
                                        ToolTip="{Binding StatusTooltip}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis"
                                            Text="{Binding DisplayTitle}" />
                                        <TextBlock
                                            FontSize="11"
                                            Opacity="0.6"
                                            TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding InstalledVersion, TargetNullValue='unknown', Mode=OneWay}" />
                                            <Run Text=" • " />
                                            <Run Text="{Binding TargetSummary, Mode=OneWay}" />
                                            <Run Text=" • " />
                                            <Run Text="{Binding Author, TargetNullValue='unknown author', Mode=OneWay}" />
                                        </TextBlock>

                                        <ContentPresenter
                                            ContentTemplate="{StaticResource ModListBadges}"
                                            Content="{Binding}" />
                                    </StackPanel>

                                    <!-- Group membership and disabled state, both readable without
                                         opening the row. -->
                                    <StackPanel
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="12,0,12,0">
                                        <Border
                                            Padding="8,2"
                                            CornerRadius="3"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            Visibility="{Binding IsGrouped, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Folder24" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                <TextBlock FontSize="11" Text="{Binding GroupName}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <Border
                                            Margin="6,0,0,0"
                                            Padding="8,2"
                                            CornerRadius="3"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            Visibility="{Binding IsDisabled, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="DISABLED" FontSize="10" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Only the non-destructive actions live in the header; Remove
                                         and Sort out are inside the row, which has to be opened first. -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button
                                            Padding="6"
                                            Appearance="Transparent"
                                            Command="{Binding DataContext.ToggleDisableCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding DisableToggleTooltip}">
                                            <ui:SymbolIcon Symbol="{Binding DisableToggleGlyph}" FontSize="16" />
                                        </ui:Button>
                                    </StackPanel>
                                </Grid>
                            </ui:CardExpander.Header>

                            <StackPanel Margin="0,4,0,0">
                                <TextBlock
                                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                    TextWrapping="Wrap"
                                    Text="{Binding AddonSubtitle}"
                                    Visibility="{Binding AddonSubtitle, Converter={StaticResource NullToCollapsed}}" />

                                <TextBlock
                                    Opacity="0.6"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding FolderNameIfDifferent, Converter={StaticResource NullToCollapsed}}">
                                    <Run Text="Installed as: " />
                                    <Run Text="{Binding FolderNameIfDifferent, Mode=OneWay}" />
                                </TextBlock>

                                <TextBlock
                                    Opacity="0.6"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding Guid, Converter={StaticResource NullToCollapsed}}">
                                    <Run Text="GUID: " />
                                    <Run Text="{Binding Guid, Mode=OneWay}" />
                                </TextBlock>

                                <TextBlock Opacity="0.6" TextWrapping="Wrap">
                                    <Run Text="Installed version: " />
                                    <Run Text="{Binding InstalledVersion, TargetNullValue='unknown', Mode=OneWay}" />
                                </TextBlock>

                                <TextBlock
                                    Opacity="0.6"
                                    TextWrapping="Wrap"
                                    Text="{Binding InstalledVersionDetail}"
                                    Visibility="{Binding InstalledVersionDetail, Converter={StaticResource NullToCollapsed}}" />

                                <TextBlock Opacity="0.6" TextWrapping="Wrap">
                                    <Run Text="Latest published: " />
                                    <Run Text="{Binding LatestPublishedText, Mode=OneWay}" />
                                </TextBlock>

                                <TextBlock
                                    Opacity="0.6"
                                    Visibility="{Binding LatestUpdatedAt, Converter={StaticResource NullToCollapsed}}">
                                    <Run Text="Last updated on sp-mod.com: " />
                                    <Run Text="{Binding LatestUpdatedAt, StringFormat='{}{0:d}', Mode=OneWay}" />
                                </TextBlock>

                                <TextBlock
                                    Opacity="0.6"
                                    Visibility="{Binding InstalledAt, Converter={StaticResource NullToCollapsed}}">
                                    <Run Text="Installed on: " />
                                    <Run Text="{Binding InstalledAt, StringFormat='{}{0:d}', Mode=OneWay}" />
                                </TextBlock>

                                <TextBlock Opacity="0.6" TextWrapping="Wrap">
                                    <Run Text="Group: " />
                                    <Run Text="{Binding GroupLabel, Mode=OneWay}" />
                                </TextBlock>

                                <TextBlock
                                    Opacity="0.6"
                                    TextWrapping="Wrap"
                                    Text="{Binding FlagsSummary}"
                                    Visibility="{Binding FlagsSummary, Converter={StaticResource NullToCollapsed}}" />

                                <TextBlock
                                    Opacity="0.6"
                                    TextWrapping="Wrap"
                                    Margin="0,4,0,0"
                                    Text="{Binding SourceLabel}" />

                                <TextBlock
                                    Opacity="0.5"
                                    TextWrapping="Wrap"
                                    Margin="0,4,0,0"
                                    Visibility="{Binding ClientFolderPath, Converter={StaticResource NullToCollapsed}}">
                                    <Run Text="Client: " />
                                    <Run Text="{Binding ClientFolderPath, Mode=OneWay}" />
                                </TextBlock>

                                <TextBlock
                                    Opacity="0.5"
                                    TextWrapping="Wrap"
                                    Visibility="{Binding ServerFolderPath, Converter={StaticResource NullToCollapsed}}">
                                    <Run Text="Server: " />
                                    <Run Text="{Binding ServerFolderPath, Mode=OneWay}" />
                                </TextBlock>

                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <ui:Button
                                        Content="Details and versions"
                                        Icon="{ui:SymbolIcon Info24}"
                                        Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Open the full version history and update dialog" />

                                    <ui:Button
                                        Margin="8,0,0,0"
                                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                        Content="Sort out"
                                        Icon="{ui:SymbolIcon Warning24}"
                                        Visibility="{Binding HasDuplicateFolders, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.ResolveDuplicateCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="This mod is in both an enabled and a disabled folder - pick which copy to keep" />

                                    <ui:Button
                                        Margin="8,0,0,0"
                                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                        Content="Remove"
                                        Icon="{ui:SymbolIcon Delete24}"
                                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Remove this mod" />
                                </StackPanel>
                            </StackPanel>
                        </ui:CardExpander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Only shown in Cards view - the two scrolling views have no use for pages. -->
        <StackPanel
            Grid.Row="5"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,8,0,0"
            Visibility="{Binding ShowCards, Converter={StaticResource BoolToVis}}">
            <ui:Button
                Content="Previous"
                Command="{Binding PreviousPageCommand}" />
            <TextBlock
                Margin="12,0,12,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{Binding CurrentPage, StringFormat='Page {0}'}" />
            <TextBlock
                VerticalAlignment="Center"
                Opacity="0.7"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{Binding TotalPages, StringFormat='of {0}'}" />
            <ui:Button
                Margin="12,0,0,0"
                Content="Next"
                Command="{Binding NextPageCommand}" />
        </StackPanel>
    </Grid>
</Page>
