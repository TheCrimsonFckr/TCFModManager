<Page
    x:Class="TCFModManager.App.Views.InstalledPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    xmlns:viewmodels="clr-namespace:TCFModManager.App.ViewModels"
    Title="Installed"
    Loaded="InstalledPage_Loaded">
    <Page.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToCollapsed" />
        <converters:UpdateAvailableToVisibilityConverter x:Key="UpdateAvailableToVisible" />
        <converters:ModStatusToBrushConverter x:Key="StatusBrush" />
        <converters:FalseToVisibilityConverter x:Key="FalseToVisible" />
        <converters:CountToVisibilityConverter x:Key="HasItems" />
        <converters:BoolToButtonAppearanceConverter x:Key="BoolToAppearance" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>
    <!-- MouseWheel (bubble) rather than PreviewMouseWheel: this only fires when nothing closer to
         the pointer already consumed the wheel event, so it steps in for scroll events over the
         toolbar/filter rows without double-scrolling when the pointer is already over the group
         ScrollViewer itself (that ScrollViewer handles its own wheel events and marks them
         handled, which stops this bubble handler from running for those). See
         RootGrid_MouseWheel in code-behind. -->
    <Grid
        x:Name="RootGrid"
        Margin="16"
        MouseWheel="RootGrid_MouseWheel">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <ui:Button
                DockPanel.Dock="Right"
                Content="Rescan"
                Command="{Binding ScanCommand}" />

            <!-- Cards/Groups view switcher - deliberately the first, most prominent thing on the
                 page rather than a small toggle buried among the filter row's other switches.
                 Whichever mode is active shows tinted with the theme accent (Appearance="Primary"
                 via BoolToAppearance); the other stays Secondary. -->
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                <ui:Button
                    Padding="12,7"
                    FontWeight="SemiBold"
                    Content="Cards"
                    Icon="{ui:SymbolIcon Apps24}"
                    Appearance="{Binding ShowFlatList, Converter={StaticResource BoolToAppearance}}"
                    Click="CardsView_Click" />
                <ui:Button
                    Margin="8,0,0,0"
                    Padding="12,7"
                    FontWeight="SemiBold"
                    Content="Groups"
                    Icon="{ui:SymbolIcon Folder24}"
                    Appearance="{Binding GroupViewEnabled, Converter={StaticResource BoolToAppearance}}"
                    ToolTip="Sort mods into your own groups, MO2-separator style."
                    Click="GroupsView_Click" />
            </StackPanel>

            <TextBlock
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                Foreground="White"
                Opacity="0.8"
                Text="{Binding StatusMessage}" />
        </DockPanel>

        <!-- Search box and filter toggles. -->
        <DockPanel Grid.Row="1" Margin="0,0,0,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:ToggleSwitch
                    Foreground="White"
                    IsChecked="{Binding FikaCompatibleOnly}"
                    OnContent="Fika compatible only"
                    OffContent="Fika compatible only" />
                <ui:ToggleSwitch
                    Margin="16,0,0,0"
                    Foreground="White"
                    IsChecked="{Binding HideContainsAds}"
                    OnContent="Hide ads"
                    OffContent="Hide ads" />
                <ui:ToggleSwitch
                    Margin="16,0,0,0"
                    Foreground="White"
                    IsChecked="{Binding HideContainsAiContent}"
                    OnContent="Hide AI content"
                    OffContent="Hide AI content" />
            </StackPanel>

            <ui:TextBox
                Width="320"
                HorizontalAlignment="Left"
                PlaceholderText="Search mods... (@author for author)"
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <DockPanel Grid.Row="2" Margin="0,0,0,8">
            <ui:Button
                DockPanel.Dock="Right"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Content="Clear filters"
                Command="{Binding ClearFiltersCommand}" />

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Update status:" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox
                    MinWidth="120"
                    ItemsSource="{Binding UpdateFilterOptions}"
                    SelectedItem="{Binding SelectedUpdateFilter}" />

                <TextBlock Text="Sort by:" Foreground="White" VerticalAlignment="Center" Margin="16,0,6,0" />
                <ComboBox
                    MinWidth="140"
                    ItemsSource="{Binding SortOptions}"
                    SelectedItem="{Binding SelectedSortOption}" />

                <!-- Pagination is hidden in group view (see the pagination StackPanel's own
                     Visibility below), so "Per page" would have nothing to affect there. -->
                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowFlatList, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="Per page:" Foreground="White" VerticalAlignment="Center" Margin="16,0,6,0" />
                    <ComboBox
                        MinWidth="60"
                        ItemsSource="{Binding PageSizeOptions}"
                        SelectedItem="{Binding PageSize}" />
                </StackPanel>
            </StackPanel>
        </DockPanel>

        <!-- Group management bar - only meaningful, so only shown, in group view. -->
        <DockPanel
            Grid.Row="3"
            Margin="0,0,0,8"
            Visibility="{Binding GroupViewEnabled, Converter={StaticResource BoolToVis}}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Sort groups:" Foreground="White" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox
                    MinWidth="150"
                    ItemsSource="{Binding GroupSortOptions}"
                    SelectedItem="{Binding SelectedGroupSortOption}" />
            </StackPanel>
            <ui:Button
                DockPanel.Dock="Right"
                Margin="0,0,16,0"
                Content="Add group"
                Icon="{ui:SymbolIcon Add24}"
                Command="{Binding AddGroupCommand}" />
            <ui:TextBox
                Width="220"
                HorizontalAlignment="Left"
                PlaceholderText="New group name..."
                Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <!-- Installed mods grid; column count is set from code-behind based on width. Hidden in
             group view (see Sections below, occupying the same cell). -->
        <ListBox
            x:Name="ResultsListBox"
            Grid.Row="4"
            Padding="4"
            BorderThickness="0"
            Background="Transparent"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            Visibility="{Binding ShowFlatList, Converter={StaticResource BoolToVis}}"
            ItemsSource="{Binding Results}"
            SelectionChanged="ResultsListBox_SelectionChanged"
            SizeChanged="ResultsListBox_SizeChanged">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding Columns}" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Margin" Value="6" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="VerticalAlignment" Value="Stretch" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- Stretches card content so the icon column can pin to top/bottom edges. -->
                    <ui:Card
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        ClipToBounds="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Mod title and details, one consistent text size throughout. -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <!-- Catalog title, falling back to the installed folder/package name. -->
                                <TextBlock
                                    Text="{Binding DisplayTitle}"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis" />

                                <!-- On-disk folder/package name, shown only if different from the title. -->
                                <TextBlock
                                    Opacity="0.6"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{Binding FolderNameIfDifferent, Converter={StaticResource NullToCollapsed}}">
                                    <Run Text="Installed as: " />
                                    <Run Text="{Binding FolderNameIfDifferent, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock
                                    Text="{Binding Guid}"
                                    Opacity="0.5"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{Binding Guid, Converter={StaticResource NullToCollapsed}}" />

                                <TextBlock TextTrimming="CharacterEllipsis" Opacity="0.6">
                                    <Run Text="Installed: " />
                                    <Run Text="{Binding InstalledVersion, TargetNullValue='unknown', Mode=OneWay}" />
                                </TextBlock>

                                <!-- Shown only when client and server versions disagree. -->
                                <TextBlock
                                    Text="{Binding InstalledVersionDetail}"
                                    Opacity="0.6"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="{Binding InstalledVersionDetail, Converter={StaticResource NullToCollapsed}}" />

                                <TextBlock Opacity="0.6">
                                    <Run Text="Latest published: " />
                                    <Run Text="{Binding LatestPublishedVersion, TargetNullValue='not found on sp-mod.com', Mode=OneWay}" />
                                </TextBlock>

                                <!-- Shown only when the mod matched a catalog listing. -->
                                <TextBlock
                                    Opacity="0.6"
                                    Visibility="{Binding LatestUpdatedAt, Converter={StaticResource NullToCollapsed}}">
                                    <Run Text="Last updated: " />
                                    <Run Text="{Binding LatestUpdatedAt, StringFormat='{}{0:d}', Mode=OneWay}" />
                                </TextBlock>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        Text="{Binding TargetSummary}"
                                        Opacity="0.6" />
                                    <TextBlock
                                        Text="{Binding InstalledAt, StringFormat=' • installed {0:d}'}"
                                        Opacity="0.6"
                                        Visibility="{Binding InstalledAt, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>
                            </StackPanel>

                            <!-- Update icon and Remove button, pinned to the card's top/bottom edges. -->
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Status icon, same set Browse and Dependencies use; clicking the card
                                     opens the update dialog. Always shown, so an up-to-date mod reads as
                                     checked rather than as an absent icon. -->
                                <ui:SymbolIcon
                                    Grid.Row="0"
                                    Margin="6"
                                    HorizontalAlignment="Center"
                                    FontSize="20"
                                    Symbol="{Binding StatusGlyph}"
                                    Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"
                                    ToolTip="{Binding StatusTooltip}" />

                                <!-- Remove button, colored red as a destructive action. -->
                                <ui:Button
                                    Grid.Row="2"
                                    Margin="6"
                                    HorizontalAlignment="Center"
                                    Padding="6"
                                    Appearance="Transparent"
                                    Foreground="Red"
                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                    CommandParameter="{Binding}"
                                    Icon="{ui:SymbolIcon Delete24}"
                                    ToolTip="Remove this mod" />
                            </Grid>
                        </Grid>
                    </ui:Card>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Group view: one collapsible section per user-defined group, plus a fixed Ungrouped
             bucket last. Occupies the same cell as ResultsListBox above; only one of the two is
             visible at a time. Each section's whole card is a drop target so a drop lands
             correctly even while collapsed. -->
        <!-- Focusable="False" here and on both nested ItemsControls below: none of them offer any
             keyboard interaction, and leaving them focusable meant a plain click on a mod row (a
             non-focusable Border) bubbled focus up to the nearest focusable ancestor - normally
             this ScrollViewer or one of the ItemsControls - which then re-centered/nudged itself
             into view and produced a small unwanted scroll jump the instant you clicked. See also
             ModRow_PreviewMouseLeftButtonDown's e.Handled = true in code-behind, which stops that
             same default click-focus assignment before it starts. -->
        <ScrollViewer
            x:Name="GroupsScrollViewer"
            Grid.Row="4"
            Focusable="False"
            VerticalScrollBarVisibility="Auto"
            Visibility="{Binding GroupViewEnabled, Converter={StaticResource BoolToVis}}">
            <ItemsControl Focusable="False" ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewmodels:ModGroupSectionViewModel}">
                        <ui:Card
                            Margin="0,0,6,8"
                            Padding="10"
                            AllowDrop="True"
                            DragOver="Section_DragOver"
                            Drop="Section_Drop">
                            <StackPanel>
                                <!-- Section header: collapse toggle, name (or rename box), reorder/rename/delete. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ui:Button
                                        Grid.Column="0"
                                        Padding="4"
                                        Margin="0,0,6,0"
                                        Appearance="Transparent"
                                        Visibility="{Binding IsRealGroup, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.ToggleCollapsedCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Expand/collapse this group">
                                        <ui:SymbolIcon Symbol="{Binding ChevronGlyph}" FontSize="16" />
                                    </ui:Button>

                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{Binding IsEditing, Converter={StaticResource FalseToVisible}}">
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" " />
                                            <Run Text="{Binding CountLabel, Mode=OneWay}" Foreground="#99FFFFFF" />
                                        </TextBlock>

                                        <ui:TextBox
                                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                            KeyDown="RenameTextBox_KeyDown"
                                            LostFocus="RenameTextBox_LostFocus" />
                                    </Grid>

                                    <StackPanel
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        Visibility="{Binding IsRealGroup, Converter={StaticResource BoolToVis}}">
                                        <!-- Only meaningful (and only shown) while groups are in their manual
                                             order - an alphabetical group sort would just fight these. -->
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Visibility="{Binding DataContext.CanReorderGroups, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}, Converter={StaticResource BoolToVis}}">
                                            <ui:Button
                                                Padding="4"
                                                Appearance="Transparent"
                                                ToolTip="Move up"
                                                Command="{Binding DataContext.MoveGroupUpCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}"
                                                Icon="{ui:SymbolIcon ChevronUp24}" />
                                            <ui:Button
                                                Padding="4"
                                                Appearance="Transparent"
                                                ToolTip="Move down"
                                                Command="{Binding DataContext.MoveGroupDownCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}"
                                                Icon="{ui:SymbolIcon ChevronDown24}" />
                                        </StackPanel>
                                        <ui:Button
                                            Padding="4"
                                            Margin="6,0,0,0"
                                            Appearance="Transparent"
                                            ToolTip="Rename"
                                            Command="{Binding DataContext.BeginRenameCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}"
                                            Icon="{ui:SymbolIcon Edit24}" />
                                        <ui:Button
                                            Padding="4"
                                            Appearance="Transparent"
                                            Foreground="Red"
                                            ToolTip="Delete this group"
                                            Command="{Binding DataContext.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}"
                                            Icon="{ui:SymbolIcon Delete24}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Mods in this group; hidden while collapsed. Each row is a drag source. -->
                                <Grid
                                    Margin="0,8,0,0"
                                    Visibility="{Binding IsCollapsed, Converter={StaticResource FalseToVisible}}">
                                    <TextBlock
                                        Padding="4"
                                        Opacity="0.5"
                                        FontStyle="Italic"
                                        Text="Drag mods here"
                                        Visibility="{Binding Items.Count, Converter={StaticResource HasItems}, ConverterParameter=Invert}" />

                                    <ItemsControl Focusable="False" ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type viewmodels:InstalledModCardViewModel}">
                                                <Border
                                                    Margin="0,0,0,4"
                                                    Padding="8,6"
                                                    Background="#14FFFFFF"
                                                    CornerRadius="4"
                                                    Cursor="Hand"
                                                    ToolTip="Click for details - drag onto another group to move it there"
                                                    PreviewMouseLeftButtonDown="ModRow_PreviewMouseLeftButtonDown"
                                                    PreviewMouseMove="ModRow_PreviewMouseMove"
                                                    PreviewMouseLeftButtonUp="ModRow_PreviewMouseLeftButtonUp">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <ui:SymbolIcon
                                                            Grid.Column="0"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="16"
                                                            Symbol="{Binding StatusGlyph}"
                                                            Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"
                                                            ToolTip="{Binding StatusTooltip}" />

                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock
                                                                FontWeight="SemiBold"
                                                                TextTrimming="CharacterEllipsis"
                                                                Text="{Binding DisplayTitle}" />
                                                            <TextBlock
                                                                FontSize="11"
                                                                Opacity="0.6"
                                                                TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding InstalledVersion, TargetNullValue='unknown', Mode=OneWay}" />
                                                                <Run Text=" • " />
                                                                <Run Text="{Binding TargetSummary, Mode=OneWay}" />
                                                                <Run Text=" • " />
                                                                <Run Text="{Binding Author, TargetNullValue='unknown author', Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Hidden in group view - a manually-sorted, collapsible group list has no use for pages. -->
        <StackPanel
            Grid.Row="5"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,8,0,0"
            Visibility="{Binding ShowFlatList, Converter={StaticResource BoolToVis}}">
            <ui:Button
                Content="Previous"
                Command="{Binding PreviousPageCommand}" />
            <TextBlock
                Margin="12,0,12,0"
                VerticalAlignment="Center"
                Foreground="White"
                Text="{Binding CurrentPage, StringFormat='Page {0}'}" />
            <TextBlock
                VerticalAlignment="Center"
                Opacity="0.7"
                Foreground="White"
                Text="{Binding TotalPages, StringFormat='of {0}'}" />
            <ui:Button
                Margin="12,0,0,0"
                Content="Next"
                Command="{Binding NextPageCommand}" />
        </StackPanel>
    </Grid>
</Page>
