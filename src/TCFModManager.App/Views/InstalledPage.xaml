<!-- ScrollViewer.CanContentScroll="False" is the fix that actually made scroll-anywhere work (two
     earlier attempts at this - a bubble MouseWheel handler, then a tunnel PreviewMouseWheel one -
     both failed for a reason neither of them could have addressed): WPF-UI's NavigationView wraps
     every hosted Page's content in its own outer Wpf.Ui.Controls.DynamicScrollViewer by default
     (NavigationViewContentPresenter reads ScrollViewer.GetCanContentScroll(page) each navigation,
     and WPF-UI overrides that property's default for every Page to true app-wide - confirmed by
     decompiling Wpf.Ui.dll in the sandbox with ilspycmd). That outer wrapper sitting above our own
     GroupsScrollViewer is what made the wheel behave so strangely - only the visible scrollbar
     itself (the outer wrapper's) actually worked, not the wheel over our own content. Setting this
     to False here opts this page out of that automatic outer wrapping, leaving GroupsScrollViewer
     as the one and only scrolling container - after which the ordinary WPF wheel/scroll mechanics
     (plus the PreviewMouseWheel handler below, still needed for the unrelated TextBox/ComboBox
     wheel-swallowing issue) work as expected. -->
<Page
    x:Class="TCFModManager.App.Views.InstalledPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    xmlns:viewmodels="clr-namespace:TCFModManager.App.ViewModels"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    Title="{loc:Str Nav_Installed}"
    Loaded="InstalledPage_Loaded"
    Unloaded="InstalledPage_Unloaded"
    ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <!-- One width for every filter in the filter row, so a wrapped row lines up in columns. -->

        <converters:NullToVisibilityConverter x:Key="NullToCollapsed" />
        <converters:UpdateAvailableToVisibilityConverter x:Key="UpdateAvailableToVisible" />
        <converters:FalseToVisibilityConverter x:Key="FalseToVisible" />
        <converters:CountToVisibilityConverter x:Key="HasItems" />
        <converters:BoolToButtonAppearanceConverter x:Key="BoolToAppearance" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- One chip per mod list a mod belongs to, shared by all three views so they can't drift
             apart. Membership comes from ModListMembership, which runs the real planner, so a chip
             here and what applying that list would do can't disagree. ShowLists folds in the
             page-wide toggle as well as "is it in any list at all". -->
        <DataTemplate x:Key="ModListBadges">
            <ItemsControl
                ItemsSource="{Binding Lists}"
                Visibility="{Binding ShowLists, Converter={StaticResource BoolToVis}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,2,4,0"
                            Padding="6,1"
                            CornerRadius="3"
                            ToolTip="{loc:Str Installed_ListChipToolTip}"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <TextBlock
                                Text="{Binding}"
                                FontSize="10"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis"
                                MaxWidth="140"
                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
        <!--
             Everything the app knows about one installed mod, shown when a row or a card is
             opened. Shared by the List and Cards views so the two cannot drift apart - they
             differ in how they summarise a mod, not in what they can tell you about it.

             The commands bind through the Page rather than the item, so this works wherever it
             is dropped in as long as it stays on InstalledPage.
        -->
        <DataTemplate x:Key="ModDetailBody">
            <!--
                 MinHeight rather than Height, so every opened card is the same size as the one
                 Chris measured against ("Air Filter Only Drains In Raid": ten detail lines, the
                 folder row and the action row) while anything genuinely longer - an addon subtitle,
                 a duplicate-folder warning - still grows instead of being clipped or given its own
                 scrollbar. One number to tune if the standard card gains or loses a line.
            -->
            <Grid Margin="0,4,0,0" MinHeight="300">
                <Grid.RowDefinitions>
                    <!-- The detail takes the slack, so the action row sits on the card's
                         bottom edge whether the mod has ten lines to say or four. -->
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                        TextWrapping="Wrap"
                        Text="{Binding AddonSubtitle}"
                        Visibility="{Binding AddonSubtitle, Converter={StaticResource NullToCollapsed}}" />

                    <TextBlock
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap"
                        Text="{Binding FolderNameIfDifferent, Mode=OneWay, StringFormat={loc:Str Installed_DetailInstalledAsFormat}}"
                        Visibility="{Binding FolderNameIfDifferent, Converter={StaticResource NullToCollapsed}}" />

                    <TextBlock
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap"
                        Text="{Binding Guid, Mode=OneWay, StringFormat={loc:Str Installed_DetailGuidFormat}}"
                        Visibility="{Binding Guid, Converter={StaticResource NullToCollapsed}}" />

                    <TextBlock
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap"
                        Text="{Binding InstalledVersion, Mode=OneWay, TargetNullValue={loc:Str Common_Unknown}, StringFormat={loc:Str Installed_DetailInstalledVersionFormat}}" />

                    <TextBlock
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap"
                        Text="{Binding LatestPublishedText, Mode=OneWay, StringFormat={loc:Str Installed_DetailLatestPublishedFormat}}" />

                    <TextBlock
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding LatestUpdatedAt, Mode=OneWay, StringFormat={loc:Str Installed_DetailLastUpdatedFormat}}"
                        Visibility="{Binding LatestUpdatedAt, Converter={StaticResource NullToCollapsed}}" />

                    <TextBlock
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Text="{Binding InstalledAt, Mode=OneWay, StringFormat={loc:Str Installed_DetailInstalledOnFormat}}"
                        Visibility="{Binding InstalledAt, Converter={StaticResource NullToCollapsed}}" />

                    <!-- What the files on disk claim, shown only when they disagree with each other or
                         with the manifest. Sits under the dates because it qualifies the installed
                         version rather than being a separate fact about the mod. -->
                    <TextBlock
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap"
                        Text="{Binding InstalledVersionDetail}"
                        Visibility="{Binding InstalledVersionDetail, Converter={StaticResource NullToCollapsed}}" />

                    <!-- Part of what this app installed is no longer on disk. Spelled out rather
                         than left to the status icon's tooltip: the rest of the card reads as a
                         healthy install at the right version, which is exactly the problem. -->
                    <TextBlock
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        TextWrapping="Wrap"
                        Text="{Binding IncompleteSummary}"
                        Visibility="{Binding IncompleteSummary, Converter={StaticResource NullToCollapsed}}" />

                    <!-- What a removal left behind because it holds files the mod didn't install. -->
                    <TextBlock
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        TextWrapping="Wrap"
                        Text="{Binding LeftoverSummary}"
                        Visibility="{Binding LeftoverSummary, Converter={StaticResource NullToCollapsed}}" />

                    <!-- Monitor mode: a download of this mod the scan found on disk, not yet
                         confirmed - or found only partly, which is never confirmed. -->
                    <TextBlock
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        TextWrapping="Wrap"
                        Text="{Binding DownloadSummary}"
                        Visibility="{Binding DownloadSummary, Converter={StaticResource NullToCollapsed}}" />

                    <!-- sp-mod holds this mod's newest release back: it would break another installed
                         mod (OPEN-12 F11). -->
                    <TextBlock
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        TextWrapping="Wrap"
                        Text="{Binding HeldBackNote}"
                        Visibility="{Binding HeldBackNote, Converter={StaticResource NullToCollapsed}}" />

                    <TextBlock
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap"
                        Text="{Binding FlagsSummary}"
                        Visibility="{Binding FlagsSummary, Converter={StaticResource NullToCollapsed}}" />

                    <TextBlock
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        TextWrapping="Wrap"
                        Margin="0,4,0,0"
                        Text="{Binding SourceLabel}" />

                    <!-- The folders themselves, one row, each opening in Explorer. The full path is
                         the tooltip rather than the label: a mod path is far too long to sit inside a
                         card, and what you want from it is to get there. -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <ui:Button
                            Padding="8,4"
                            Appearance="Transparent"
                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                            Icon="{ui:SymbolIcon FolderOpen24}"
                            Content="{loc:Str Installed_ClientFolder}"
                            Visibility="{Binding ClientFolderLink, Converter={StaticResource NullToCollapsed}}"
                            Command="{Binding DataContext.OpenModFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                            CommandParameter="{Binding ClientFolderLink}"
                            ToolTip="{Binding ClientFolderLink}"
                            ToolTipService.ShowDuration="20000" />

                        <ui:Button
                            Margin="8,0,0,0"
                            Padding="8,4"
                            Appearance="Transparent"
                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                            Icon="{ui:SymbolIcon FolderOpen24}"
                            Content="{loc:Str Installed_ServerFolder}"
                            Visibility="{Binding ServerFolderLink, Converter={StaticResource NullToCollapsed}}"
                            Command="{Binding DataContext.OpenModFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                            CommandParameter="{Binding ServerFolderLink}"
                            ToolTip="{Binding ServerFolderLink}"
                            ToolTipService.ShowDuration="20000" />
                    </StackPanel>
                </StackPanel>

                <!-- Remove is docked right, away from the two safe actions, so the destructive one
                     is never where the mouse already is. LastChildFill is off: this row is two
                     docked groups, not a filled remainder. -->
                <DockPanel Grid.Row="1" LastChildFill="False" Margin="0,12,0,0" VerticalAlignment="Bottom">
                    <ui:Button
                        DockPanel.Dock="Left"
                        Content="{loc:Str Installed_DetailsAndVersions}"
                        Icon="{ui:SymbolIcon Info24}"
                        Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                        CommandParameter="{Binding}"
                        ToolTip="{loc:Str Installed_DetailsAndVersionsToolTip}" />

                    <ui:Button
                        DockPanel.Dock="Left"
                        Margin="8,0,0,0"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Content="{loc:Str Installed_SortOut}"
                        Icon="{ui:SymbolIcon Warning24}"
                        Visibility="{Binding HasDuplicateFolders, Converter={StaticResource BoolToVis}}"
                        Command="{Binding DataContext.ResolveDuplicateCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                        CommandParameter="{Binding}"
                        ToolTip="{loc:Str Installed_SortOutToolTip}" />

                    <ui:Button
                        DockPanel.Dock="Left"
                        Margin="8,0,0,0"
                        Content="{loc:Str Installed_ConfirmDownload}"
                        Icon="{ui:SymbolIcon CheckmarkCircle24}"
                        Visibility="{Binding CanConfirmDownload, Converter={StaticResource BoolToVis}}"
                        Command="{Binding DataContext.ConfirmDownloadCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                        CommandParameter="{Binding}"
                        ToolTip="{loc:Str Installed_ConfirmDownloadToolTip}" />

                    <ui:Button
                        DockPanel.Dock="Left"
                        Margin="8,0,0,0"
                        Content="{Binding PinLabel}"
                        Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                        CommandParameter="{Binding}"
                        ToolTip="{Binding PinTooltip}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="{Binding PinGlyph}" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button
                        DockPanel.Dock="Right"
                        Margin="8,0,0,0"
                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                        Content="{loc:Str Installed_Remove}"
                        Icon="{ui:SymbolIcon Delete24}"
                        Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                        CommandParameter="{Binding}"
                        ToolTip="{loc:Str Installed_RemoveToolTip}" />
                </DockPanel>
            </Grid>
        </DataTemplate>

    </Page.Resources>
    <!-- Scroll-anywhere for group view is wired up in code-behind (see the constructor and
         Page_PreviewMouseWheel in InstalledPage.xaml.cs), not via a XAML MouseWheel attribute here
         any more - a plain bubble MouseWheel handler on this Grid turned out not to be reliable:
         several controls (ui:TextBox, ComboBox, ...) have an internal ScrollViewer part that
         swallows the bubbling MouseWheel event and marks it handled even when there's nothing for
         *them* to scroll, so hovering the search box or a combo silently ate the event before it
         ever reached this Grid. Registering a PreviewMouseWheel (tunnel) handler directly on the
         Page runs before any of that - it's first in line for every wheel event over this page,
         full stop.
         Background="Transparent" is still load-bearing here though: a Grid with no Background at
         all only takes part in hit-testing where a child actually paints something, so without it
         the "empty" space in the toolbar rows (and any blank area below a short group list) would
         resolve the hit test to whatever's rendered behind this whole page instead of to anything
         inside it - meaning the event's route would never even pass through the Page, so it
         wouldn't matter where the handler was attached. -->
    <Grid
        x:Name="RootGrid"
        Margin="16"
        Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="FiltersColumn" Width="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
            <ui:Button
                DockPanel.Dock="Right"
                Content="{loc:Str Common_Rescan}"
                Command="{Binding ScanCommand}" />

            <!-- Puts the last disable/enable back. A disable only moves folders, so undoing one is
                 just moving them back - shown only while there's something to put back. -->
            <ui:Button
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                Content="{Binding UndoLabel}"
                Icon="{ui:SymbolIcon ArrowUndo20}"
                Command="{Binding UndoCommand}"
                Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}" />

            <!-- Turns the list into a tick-list for acting on several mods at once - in all three
                 views (OPEN-12 A1). Ctrl-click, Shift-click and Ctrl+A switch it on too. -->
            <ui:Button
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                Content="{loc:Str Installed_MultiSelect}"
                Icon="{ui:SymbolIcon SelectAllOn24}"
                ToolTip="{loc:Str Installed_MultiSelectToolTip}"
                Appearance="{Binding SelectionMode, Converter={StaticResource BoolToAppearance}}"
                Click="SelectMode_Click" />

            <!-- Open/close everything the filters match, in whichever of the two expandable views
                 is on screen. Group view has its own per-section collapse, so these hide there
                 rather than sitting dead.

                 Wrapped in a StackPanel rather than docked individually: in a DockPanel the
                 first-declared Right element lands furthest right, so a pair docked separately
                 would read collapse-then-expand. -->
            <StackPanel
                DockPanel.Dock="Right"
                Orientation="Horizontal"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Visibility="{Binding ShowExpanders, Converter={StaticResource BoolToVis}}">
                <ui:Button
                    Padding="10,7"
                    Icon="{ui:SymbolIcon ChevronDoubleDown20}"
                    ToolTip="{loc:Str Installed_ExpandAllToolTip}"
                    Appearance="{Binding AllExpanded, Converter={StaticResource BoolToAppearance}}"
                    Command="{Binding ExpandAllCommand}" />
                <ui:Button
                    Margin="8,0,0,0"
                    Padding="10,7"
                    Icon="{ui:SymbolIcon ChevronDoubleUp20}"
                    ToolTip="{loc:Str Installed_CollapseAllToolTip}"
                    Appearance="{Binding AllCollapsed, Converter={StaticResource BoolToAppearance}}"
                    Command="{Binding CollapseAllCommand}" />
            </StackPanel>

            <!-- Cards/Groups view switcher - deliberately the first, most prominent thing on the
                 page rather than a small toggle buried among the filter row's other switches.
                 Whichever mode is active shows tinted with the theme accent (Appearance="Primary"
                 via BoolToAppearance); the other stays Secondary. -->
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                <ui:Button
                    Padding="12,7"
                    FontWeight="SemiBold"
                    Content="{loc:Str Installed_ViewCards}"
                    Icon="{ui:SymbolIcon Apps24}"
                    Appearance="{Binding ShowCards, Converter={StaticResource BoolToAppearance}}"
                    Click="CardsView_Click" />
                <ui:Button
                    Margin="8,0,0,0"
                    Padding="12,7"
                    FontWeight="SemiBold"
                    Content="{loc:Str Installed_ViewGroups}"
                    Icon="{ui:SymbolIcon Folder24}"
                    Appearance="{Binding ShowGroups, Converter={StaticResource BoolToAppearance}}"
                    ToolTip="{loc:Str Installed_ViewGroupsToolTip}"
                    Click="GroupsView_Click" />
                <ui:Button
                    Margin="8,0,0,0"
                    Padding="12,7"
                    FontWeight="SemiBold"
                    Content="{loc:Str Installed_ViewList}"
                    Icon="{ui:SymbolIcon TextBulletListSquare24}"
                    Appearance="{Binding ShowList, Converter={StaticResource BoolToAppearance}}"
                    ToolTip="{loc:Str Installed_ViewListToolTip}"
                    Click="ListView_Click" />
            </StackPanel>

            <!-- Undo a removal (D28) - shown while one is held. With several held, it opens a menu
                of them to pick from (UndoRemoval_Click). Default padding, like Rescan and Undo beside it. -->
            <ui:Button
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                Icon="{ui:SymbolIcon ArrowUndo20}"
                Content="{Binding UndoRemovalLabel}"
                ToolTip="{loc:Str Installed_UndoRemovalToolTip}"
                Visibility="{Binding UndoRemovalLabel, Converter={StaticResource NullToCollapsed}}"
                Click="UndoRemoval_Click" />

            <!-- "N conflicts - see Dependencies and Conflicts" (OPEN-11), shown only when there are any. -->
            <ui:Button
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                Appearance="Transparent"
                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                Icon="{ui:SymbolIcon ErrorCircle20}"
                Content="{Binding ConflictCountLabel}"
                Command="{Binding ShowConflictsCommand}"
                Visibility="{Binding ConflictCountLabel, Converter={StaticResource NullToCollapsed}}" />
            <TextBlock
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding StatusMessage}" />
        </DockPanel>

        <!--
             Search and the filters. Search sits in the row; every filter and view option is in the
             side panel behind Filters and view options, which says how many of them are set so nothing
             narrows the list unseen. Save as default and Clear filters are inside the panel with what
             they act on.
        -->
        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,0,0,8">
            <!-- A display preference rather than a filter: it changes what each row draws, not which
                 rows are shown, so Clear filters leaves it alone and it is remembered between sessions. -->
            <ui:ToggleSwitch
                DockPanel.Dock="Right"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                ToolTip="{loc:Str Installed_ListBadgesToolTip}"
                IsChecked="{Binding ShowListBadges}"
                OnContent="{loc:Str Installed_ListBadges}"
                OffContent="{loc:Str Installed_ListBadges}" />

            <WrapPanel>
                <ui:TextBox
                    Width="320"
                    Margin="0,0,8,4"
                    VerticalAlignment="Center"
                    PlaceholderText="{loc:Str Common_SearchPlaceholder}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <ToggleButton
                    x:Name="MoreFiltersToggle"
                    MinWidth="130"
                    Margin="0,0,8,4"
                    VerticalAlignment="Center"
                    ToolTip="{loc:Str Filter_MoreToolTip}"
                    Style="{StaticResource FilterDropDownToggle}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Symbol="Filter24" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding MoreFiltersLabel}" />
                    </StackPanel>
                </ToggleButton>
            </WrapPanel>
        </DockPanel>

        <!--
             The rest of the filters, opened and closed by Filters in the row above. On a wide page it
             is a column of its own down the left and the results move over; on a narrow one it lies
             over the left of the results and a click elsewhere closes it (Behaviors/FilterSidePanel).
        -->
        <!-- The host is what FilterSidePanel sizes and clips, so on a wide page the results follow
             its width as it opens and closes; the panel inside keeps its own width throughout. -->
        <Grid
            x:Name="FiltersHost"
            Grid.Row="2"
            Grid.RowSpan="4"
            Grid.Column="0"
            HorizontalAlignment="Left"
            Visibility="Collapsed">
            <Border
                x:Name="FiltersPanel"
                Width="300"
                HorizontalAlignment="Right"
                Style="{StaticResource FilterSidePanelSurface}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,10">
                        <DockPanel Margin="0,0,0,10">
                            <ui:Button
                                x:Name="FiltersCloseButton"
                                DockPanel.Dock="Right"
                                Padding="4"
                                Appearance="Transparent"
                                ToolTip="{loc:Str Common_Close}">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                            </ui:Button>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{loc:Str Filter_More}" />
                        </DockPanel>

                        <!-- Each filter is a section that opens like a group does: its header names the filter and
                             shows what it is set to, and opening it lists every choice. No dropdowns to aim at in a
                             narrow panel, and what is set reads at a glance down the headers. -->
                        <Expander
                            Style="{StaticResource FilterSection}"
                            ToolTip="{loc:Str Installed_UpdateFilterToolTip}">
                            <Expander.Header>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{loc:Str Filter_SectionUpdateStatus}" TextWrapping="Wrap" />
                            </Expander.Header>
                            <ListBox Style="{StaticResource FilterOptionList}" ItemsSource="{Binding UpdateFilterOptions}" SelectedItem="{Binding SelectedUpdateFilter}" />
                        </Expander>

                        <Expander
                            Style="{StaticResource FilterSection}"
                            ToolTip="{loc:Str Installed_EnabledFilterToolTip}">
                            <Expander.Header>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{loc:Str Filter_SectionEnabled}" TextWrapping="Wrap" />
                            </Expander.Header>
                            <ListBox Style="{StaticResource FilterOptionList}" ItemsSource="{Binding EnabledFilterOptions}" SelectedItem="{Binding SelectedEnabledFilter}" />
                        </Expander>

                        <!-- "Has dependencies" is answered from the dependency graph built off the scan, so unlike
                             Browse's it covers everything installed. -->
                        <Expander Style="{StaticResource FilterSection}">
                            <Expander.Header>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{loc:Str Filter_ShowHeader}" TextWrapping="Wrap" />
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding AttributeOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            Margin="0,2"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                            ToolTip="{Binding ToolTip}">
                                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <!-- Built from the categories actually present in this install. -->
                        <Expander
                            Style="{StaticResource FilterSection}"
                            ToolTip="{loc:Str Installed_CategoryFilterToolTip}">
                            <Expander.Header>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{loc:Str Filter_SectionCategory}" TextWrapping="Wrap" />
                            </Expander.Header>
                            <ListBox Style="{StaticResource FilterOptionList}" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}" />
                        </Expander>

                        <!-- Rebuilt from the group store whenever groups change. -->
                        <Expander
                            Style="{StaticResource FilterSection}"
                            ToolTip="{loc:Str Installed_GroupFilterToolTip}">
                            <Expander.Header>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{loc:Str Filter_SectionGroup}" TextWrapping="Wrap" />
                            </Expander.Header>
                            <ListBox Style="{StaticResource FilterOptionList}" ItemsSource="{Binding GroupFilterOptions}" SelectedItem="{Binding SelectedGroupFilter}" />
                        </Expander>

                        <Expander
                            Style="{StaticResource FilterSection}"
                            ToolTip="{loc:Str Common_SortToolTip}">
                            <Expander.Header>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{loc:Str Filter_SectionSort}" TextWrapping="Wrap" />
                            </Expander.Header>
                            <ListBox Style="{StaticResource FilterOptionList}" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}" />
                        </Expander>

                        <!-- How the group sections are ordered - Groups view only. -->
                        <Expander
                            Style="{StaticResource FilterSection}"
                            Visibility="{Binding ShowGroups, Converter={StaticResource BoolToVis}}">
                            <Expander.Header>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{loc:Str Filter_SectionGroupSort}" TextWrapping="Wrap" />
                            </Expander.Header>
                            <ListBox Style="{StaticResource FilterOptionList}" ItemsSource="{Binding GroupSortOptions}" SelectedItem="{Binding SelectedGroupSortOption}" />
                        </Expander>

                        <!-- Pagination is Cards only. The options are plain ints, hence the template. -->
                        <Expander
                            Style="{StaticResource FilterSection}"
                            ToolTip="{loc:Str Common_PageSizeToolTip}"
                            Visibility="{Binding ShowCards, Converter={StaticResource BoolToVis}}">
                            <Expander.Header>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{loc:Str Filter_SectionPageSize}" TextWrapping="Wrap" />
                            </Expander.Header>
                            <ListBox Style="{StaticResource FilterOptionList}" ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat={loc:Str Common_PageSizeFormat}}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Expander>

                        <!-- Saving the defaults from the page itself rather than restating them in
                             Options: these controls already exist and show what they do. -->
                        <ui:Button
                            Margin="0,6,0,6"
                            HorizontalAlignment="Stretch"
                            Content="{loc:Str Common_SaveAsDefault}"
                            ToolTip="{loc:Str Installed_SaveAsDefaultToolTip}"
                            Command="{Binding SaveAsDefaultCommand}" />
                        <ui:Button
                            Margin="0,0,0,6"
                            HorizontalAlignment="Stretch"
                            Content="{loc:Str Common_RestoreDefaults}"
                            ToolTip="{loc:Str Common_RestoreDefaultsToolTip}"
                            Command="{Binding RestoreDefaultsCommand}" />
                        <ui:Button
                            HorizontalAlignment="Stretch"
                            Content="{loc:Str Common_ClearFilters}"
                            ToolTip="{loc:Str Common_ClearFiltersToolTip}"
                            Command="{Binding ClearFiltersCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Row 3: the multi-select bar above the group management bar. Since OPEN-12 A1 selection
             works in group view too, so the two can show together and are stacked. -->
        <StackPanel Grid.Row="3" Grid.Column="1">
        <!--
             The filters narrowing the list, one pill each, the way Steam's workshop search shows them
             (Chris, 2026-10-06): each X drops that one filter, and Clear filters drops them all.
             Always laid out, with Clear filters hidden rather than collapsed when nothing is set, so
             the results don't jump down the moment the first filter goes on.
        -->
        <DockPanel Margin="0,0,0,8">
            <ItemsControl DockPanel.Dock="Left" Focusable="False" ItemsSource="{Binding ActiveFilters}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource FilterPill}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding Label}" />
                                <Button
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource FilterPillRemove}"
                                    ToolTip="{loc:Str Filter_PillRemoveToolTip}"
                                    Command="{Binding RemoveCommand}">
                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <ui:Button
                Margin="0,0,0,6"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Content="{loc:Str Common_ClearFilters}"
                ToolTip="{loc:Str Common_ClearFiltersToolTip}"
                Command="{Binding ClearFiltersCommand}"
                Style="{StaticResource FilterPillButton}" />
        </DockPanel>
        <DockPanel
            Margin="0,0,0,8"
            Visibility="{Binding SelectionMode, Converter={StaticResource BoolToVis}}">
            <ui:Button
                DockPanel.Dock="Right"
                Content="{loc:Str Installed_SelectionClear}"
                Command="{Binding ClearSelectionCommand}" />
            <ui:Button
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                Content="{Binding SelectAllLabel}"
                Icon="{ui:SymbolIcon SelectAllOn24}"
                ToolTip="{loc:Str Installed_SelectAllToolTip}"
                Appearance="{Binding AllSelected, Converter={StaticResource BoolToAppearance}}"
                Command="{Binding SelectAllCommand}" />
            <ui:Button
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                Appearance="Primary"
                Content="{loc:Str Installed_UpdateSelected}"
                Icon="{ui:SymbolIcon ArrowDownload24}"
                ToolTip="{loc:Str Installed_UpdateSelectedToolTip}"
                Command="{Binding UpdateSelectedCommand}" />
            <ui:Button
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                Content="{loc:Str Installed_EnableSelected}"
                Icon="{ui:SymbolIcon PlugConnected24}"
                Command="{Binding EnableSelectedCommand}" />
            <ui:Button
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                Content="{loc:Str Installed_DisableSelected}"
                Icon="{ui:SymbolIcon PlugDisconnected24}"
                Command="{Binding DisableSelectedCommand}" />
            <!-- One question for all of them, configs kept (OPEN-12 A1). -->
            <ui:Button
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                Content="{loc:Str Installed_RemoveSelected}"
                Icon="{ui:SymbolIcon Delete24}"
                ToolTip="{loc:Str Installed_RemoveSelectedToolTip}"
                Command="{Binding RemoveSelectedCommand}" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding SelectedCountLabel}" />
        </DockPanel>

        <!-- Group management bar - only meaningful, so only shown, in group view. -->
        <DockPanel
            Margin="0,0,0,8"
            Visibility="{Binding ShowGroups, Converter={StaticResource BoolToVis}}">
            <!-- Sort groups is in the Filters and view options panel, with the other orderings. -->
            <ui:Button
                DockPanel.Dock="Right"
                Content="{loc:Str Installed_AddGroup}"
                Icon="{ui:SymbolIcon Add24}"
                Command="{Binding AddGroupCommand}" />
            <ui:TextBox
                MinWidth="220"
                HorizontalAlignment="Left"
                PlaceholderText="{loc:Str Installed_NewGroupPlaceholder}"
                Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        </StackPanel>

        <!-- Installed mods grid; column count is set from code-behind based on width. Hidden in
             group view (see Sections below, occupying the same cell). -->
<!--
             Installed mods as cards. A ScrollViewer + ItemsControl rather than a ListBox, and a
             WrapPanel rather than a UniformGrid, both for the same reason: each card is a
             CardExpander now, and a UniformGrid would have forced every card on the page to the
             height of whichever one was open. See InstalledViewModel.UpdateLayoutForWidth.

             The header carries what you scan for and the body everything else, matching the List
             view - and the body is literally the same template, so the two cannot disagree about
             what the app knows. Hidden in the other two views (they occupy the same cell).
        -->
        <ScrollViewer
            x:Name="CardsScrollViewer"
            Grid.Row="4"
            Grid.Column="1"
            Focusable="False"
            Padding="4"
            VerticalScrollBarVisibility="Auto"
            Visibility="{Binding ShowCards, Converter={StaticResource BoolToVis}}">
            <ItemsControl
                x:Name="ResultsItems"
                Focusable="False"
                ItemsSource="{Binding Results}"
                SizeChanged="ResultsItems_SizeChanged">
                <!-- A fresh page of cards is built a few at a time so the app never freezes (see
                     GradualFill), but shown whole: hidden while IsCardsFilling, then faded in.
                     FillBehavior="Stop" hands Opacity back to the style once the fade ends, so the
                     setter can hide the grid again on the next page; StopStoryboard cuts a fade
                     still running when the next fill starts. Not hit-testable while hidden, so a
                     click can't land on a card nobody can see. -->
                <ItemsControl.Style>
                    <!-- BasedOn keeps WPF-UI's own ItemsControl style, which a bare Style would replace. -->
                    <Style TargetType="ItemsControl" BasedOn="{StaticResource {x:Type ItemsControl}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsCardsFilling}" Value="True">
                                <Setter Property="Opacity" Value="0" />
                                <Setter Property="IsHitTestVisible" Value="False" />
                                <DataTrigger.EnterActions>
                                    <StopStoryboard BeginStoryboardName="CardsFadeIn" />
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard x:Name="CardsFadeIn">
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetProperty="Opacity"
                                                From="0"
                                                To="1"
                                                Duration="0:0:0.15"
                                                FillBehavior="Stop" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemWidth="{Binding CardWidth}" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewmodels:InstalledModCardViewModel}">
                        <!-- A disabled mod is marked by the red DISABLED tag and its status icon;
                             the card itself is drawn at full strength so it stays readable. -->
                        <!-- Top, not the default stretch: a WrapPanel arranges each line at the
                             height of its tallest item, so without this every card beside an
                             expanded one would stretch to match it. -->
                        <!-- TickableCardExpander rather than HoverCardExpander: in Multi select
                             mode a ticked card carries the accent edge and tint every other picked
                             thing in the app does, so what a bulk enable, disable or remove is
                             about to act on is readable from across the grid rather than from a
                             checkbox at the corner of each card. Outside that mode nothing is
                             ticked, and it behaves exactly as it did. -->
                        <ui:CardExpander
                            VerticalAlignment="Top"
                            Style="{StaticResource TickableCardExpander}"
                            Margin="0,0,6,6"
                            IsExpanded="{Binding IsCardExpanded, Mode=TwoWay}"
                            PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown"
                            MouseRightButtonUp="Mod_MouseRightButtonUp">
                            <ui:CardExpander.Header>
                                <Grid Margin="0,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Only shown in multi-select mode; a click anywhere on the
                                         card ticks it too, rather than only this small target -
                                         see Card_PreviewMouseLeftButtonDown. -->
                                    <CheckBox
                                        Grid.Column="0"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding IsSelected}"
                                        Visibility="{Binding DataContext.SelectionMode, RelativeSource={RelativeSource AncestorType={x:Type Page}}, Converter={StaticResource BoolToVis}}" />

                                    <!-- Status above the enable/disable toggle, both top-aligned
                                         with the title block beside them so the icon reads as
                                         belonging to the title line rather than floating against
                                         the middle of the whole header. -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                        <ui:SymbolIcon
                                            Margin="0,1,10,0"
                                            HorizontalAlignment="Center"
                                            FontSize="20"
                                            Symbol="{Binding StatusGlyph}"
                                            Style="{StaticResource StatusIcon}"
                                            ToolTip="{Binding StatusTooltip}" />

                                        <!-- Same toggle the List view carries, and the only action
                                             on the collapsed card: it is the one thing you reach
                                             for without needing to read anything else first.
                                             Remove stays inside the card, behind the expander. -->
                                        <!--
                                             Sized explicitly, and MinWidth/MinHeight zeroed with
                                             it: the theme's Button style floors the control at 32,
                                             so trimming Padding alone would have changed nothing.
                                             Measured against a card screenshot - the button's box
                                             was 32px beside an 18px status icon, which is what made
                                             it read as oversized.
                                        -->
                                        <ui:Button
                                            Margin="0,4,10,0"
                                            Padding="0"
                                            MinWidth="0"
                                            MinHeight="0"
                                            Width="30"
                                            Height="30"
                                            HorizontalAlignment="Center"
                                            Appearance="Transparent"
                                            Command="{Binding DataContext.ToggleDisableCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding DisableToggleTooltip}">
                                            <ui:SymbolIcon Symbol="{Binding DisableToggleGlyph}" FontSize="16" />
                                        </ui:Button>

                                        <!-- OPEN-12 A2: one click queues this mod's update. -->
                                        <ui:Button
                                            Margin="0,2,10,0"
                                            Padding="0"
                                            MinWidth="0"
                                            MinHeight="0"
                                            Width="30"
                                            Height="30"
                                            HorizontalAlignment="Center"
                                            Appearance="Transparent"
                                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                            Visibility="{Binding CanQuickUpdate, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.UpdateOneCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding QuickUpdateToolTip}">
                                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" />
                                        </ui:Button>

                                        <ui:SymbolIcon
                                            Symbol="Pin24"
                                            FontSize="14"
                                            Margin="0,2,10,0"
                                            HorizontalAlignment="Center"
                                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                            ToolTip="{loc:Str Common_PinnedToolTip}"
                                            Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis"
                                            Text="{Binding DisplayTitle}"
                                            ToolTip="{Binding DisplayTitle}" />

                                        <!-- The one line worth scanning: what you have, which
                                             halves it installs, and who wrote it. -->
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding InstalledVersion, TargetNullValue='unknown', Mode=OneWay}" />
                                            <Run Text=" • " />
                                            <Run Text="{Binding TargetSummary, Mode=OneWay}" />
                                            <Run Text=" • " />
                                            <Hyperlink Style="{StaticResource AuthorLink}" ToolTip="{loc:Str Author_LinkToolTip}" Command="{Binding DataContext.OpenAuthorCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}" CommandParameter="{Binding}"><Run Text="{Binding Author, TargetNullValue='unknown author', Mode=OneWay}" /></Hyperlink>
                                        </TextBlock>

                                        <!-- Says what an addon is attached to; an addon's own name
                                             rarely does, and it decides which versions can be
                                             installed. Kept in the header for that reason. -->
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                            TextTrimming="CharacterEllipsis"
                                            Text="{Binding AddonSubtitle}"
                                            Visibility="{Binding AddonSubtitle, Converter={StaticResource NullToCollapsed}}" />

                                        <ContentPresenter
                                            ContentTemplate="{StaticResource ModListBadges}"
                                            Content="{Binding}" />

                                        <!-- Group and disabled state, both readable without
                                             opening the card. Under the summary rather than beside
                                             it: a card is far narrower than a List row. -->
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Border
                                                Padding="8,2"
                                                CornerRadius="3"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                                Visibility="{Binding IsGrouped, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Folder24" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                    <TextBlock FontSize="11" Text="{Binding GroupName}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <Border
                                                Margin="6,0,0,0"
                                                Style="{StaticResource DisabledBadge}"
                                                Visibility="{Binding IsDisabled, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Style="{StaticResource DisabledBadgeText}" Text="{loc:Str Installed_DisabledTag}" />
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </ui:CardExpander.Header>

                            <ContentPresenter
                                ContentTemplate="{StaticResource ModDetailBody}"
                                Content="{Binding}" />
                        </ui:CardExpander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Group view: one collapsible section per user-defined group, plus a fixed Ungrouped
             bucket last. Occupies the same cell as ResultsListBox above; only one of the two is
             visible at a time. Each section's whole card is a drop target so a drop lands
             correctly even while collapsed. -->
        <!-- Focusable="False" here and on both nested ItemsControls below: none of them offer any
             keyboard interaction, and leaving them focusable meant a plain click on a mod row (a
             non-focusable Border) bubbled focus up to the nearest focusable ancestor - normally
             this ScrollViewer or one of the ItemsControls - which then re-centered/nudged itself
             into view and produced a small unwanted scroll jump the instant you clicked. See also
             ModRow_PreviewMouseLeftButtonDown's e.Handled = true in code-behind, which stops that
             same default click-focus assignment before it starts. -->
        <!-- AllowDrop here isn't about dropping onto the ScrollViewer - it never accepts a drop.
             It's what makes WPF raise drag events at all over the parts of the list no card
             covers (the gaps between cards, and the empty space below a short list), so the
             edge auto-scroll in code-behind keeps tracking the pointer there too. The DragOver /
             DragLeave / Drop handlers that drive it are registered in the constructor rather than
             as attributes here, because they need handledEventsToo. Background="Transparent" is the
             other half of that: a ScrollViewer with no Background isn't hit-tested where nothing
             inside it paints, so without this the drag events would still stop short of those same
             gaps. Same distinction as RootGrid's Background - Transparent participates in hit
             testing, unset does not. -->
        <ScrollViewer
            x:Name="GroupsScrollViewer"
            Grid.Row="4"
            Grid.Column="1"
            AllowDrop="True"
            Background="Transparent"
            Focusable="False"
            VerticalScrollBarVisibility="Auto"
            Visibility="{Binding ShowGroups, Converter={StaticResource BoolToVis}}">
            <!-- Right margin keeps the overlay scrollbar off the rows' right-hand buttons and chevrons. -->
            <ItemsControl Margin="0,0,14,0" Focusable="False" ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewmodels:ModGroupSectionViewModel}">
                        <ui:Card
                            Margin="0,0,6,8"
                            Padding="10"
                            AllowDrop="True"
                            DragOver="Section_DragOver"
                            Drop="Section_Drop">
                            <StackPanel>
                                <!-- Section header: collapse toggle, name (or rename box), reorder/rename/delete. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ui:Button
                                        Grid.Column="0"
                                        Padding="4"
                                        Margin="0,0,6,0"
                                        Appearance="Transparent"
                                        Visibility="{Binding IsRealGroup, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.ToggleCollapsedCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{loc:Str Installed_GroupExpandToolTip}">
                                        <ui:SymbolIcon Symbol="{Binding ChevronGlyph}" FontSize="16" />
                                    </ui:Button>

                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{Binding IsEditing, Converter={StaticResource FalseToVisible}}">
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" " />
                                            <Run Text="{Binding CountLabel, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <Run Text=" " />
                                            <Run Text="{Binding StateLabel, Mode=OneWay}" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                        </TextBlock>

                                        <ui:TextBox
                                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                            KeyDown="RenameTextBox_KeyDown"
                                            LostFocus="RenameTextBox_LostFocus" />
                                    </Grid>

                                    <StackPanel
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        Visibility="{Binding IsRealGroup, Converter={StaticResource BoolToVis}}">
                                        <!-- Whole-group enable/disable/invert. Kept to real groups
                                             rather than offered on Ungrouped too, where it would
                                             usually mean "every mod that isn't sorted yet". Each
                                             one goes through the same dependency warning a single
                                             mod does. -->
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Margin="0,0,6,0"
                                            Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                                            <ui:Button
                                                Padding="4"
                                                Appearance="Transparent"
                                                ToolTip="{loc:Str Installed_GroupEnableToolTip}"
                                                Command="{Binding DataContext.EnableGroupCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}"
                                                Icon="{ui:SymbolIcon PlugConnected24}" />
                                            <ui:Button
                                                Padding="4"
                                                Appearance="Transparent"
                                                ToolTip="{loc:Str Installed_GroupDisableToolTip}"
                                                Command="{Binding DataContext.DisableGroupCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}"
                                                Icon="{ui:SymbolIcon PlugDisconnected24}" />
                                            <ui:Button
                                                Padding="4"
                                                Appearance="Transparent"
                                                ToolTip="{loc:Str Installed_GroupInvertToolTip}"
                                                Command="{Binding DataContext.InvertGroupCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}"
                                                Icon="{ui:SymbolIcon ArrowSwap24}" />
                                        </StackPanel>

                                        <!-- Only meaningful (and only shown) while groups are in their manual
                                             order - an alphabetical group sort would just fight these. -->
                                        <StackPanel
                                            Orientation="Horizontal"
                                            Visibility="{Binding DataContext.CanReorderGroups, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}, Converter={StaticResource BoolToVis}}">
                                            <ui:Button
                                                Padding="4"
                                                Appearance="Transparent"
                                                ToolTip="{loc:Str Installed_GroupMoveUpToolTip}"
                                                Command="{Binding DataContext.MoveGroupUpCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}"
                                                Icon="{ui:SymbolIcon ChevronUp24}" />
                                            <ui:Button
                                                Padding="4"
                                                Appearance="Transparent"
                                                ToolTip="{loc:Str Installed_GroupMoveDownToolTip}"
                                                Command="{Binding DataContext.MoveGroupDownCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                                CommandParameter="{Binding}"
                                                Icon="{ui:SymbolIcon ChevronDown24}" />
                                        </StackPanel>
                                        <ui:Button
                                            Padding="4"
                                            Margin="6,0,0,0"
                                            Appearance="Transparent"
                                            ToolTip="{loc:Str Installed_GroupRenameToolTip}"
                                            Command="{Binding DataContext.BeginRenameCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}"
                                            Icon="{ui:SymbolIcon Edit24}" />
                                        <ui:Button
                                            Padding="4"
                                            Appearance="Transparent"
                                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                            ToolTip="{loc:Str Installed_GroupDeleteToolTip}"
                                            Command="{Binding DataContext.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}"
                                            Icon="{ui:SymbolIcon Delete24}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Mods in this group; hidden while collapsed. Each row is a drag source. -->
                                <Grid
                                    Margin="0,8,0,0"
                                    Visibility="{Binding IsCollapsed, Converter={StaticResource FalseToVisible}}">
                                    <TextBlock
                                        Padding="4"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        FontStyle="Italic"
                                        Text="{loc:Str Installed_GroupDropHint}"
                                        Visibility="{Binding Items.Count, Converter={StaticResource HasItems}, ConverterParameter=Invert}" />

                                    <ItemsControl Focusable="False" ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type viewmodels:InstalledModCardViewModel}">
                                                <Border
                                                    Style="{StaticResource TickableCardRow}"
                                                    Margin="0,0,0,4"
                                                    Padding="8,6"
                                                    ToolTip="{loc:Str Installed_GroupRowToolTip}"
                                                    MouseRightButtonUp="Mod_MouseRightButtonUp"
                                                    PreviewMouseLeftButtonDown="ModRow_PreviewMouseLeftButtonDown"
                                                    PreviewMouseMove="ModRow_PreviewMouseMove"
                                                    PreviewMouseLeftButtonUp="ModRow_PreviewMouseLeftButtonUp">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Multi select (OPEN-12 A1): the tick sits before the status icon. -->
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <CheckBox
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            IsChecked="{Binding IsSelected}"
                                                            IsHitTestVisible="False"
                                                            Visibility="{Binding DataContext.SelectionMode, RelativeSource={RelativeSource AncestorType={x:Type Page}}, Converter={StaticResource BoolToVis}}" />
                                                        <ui:SymbolIcon
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="20"
                                                            Symbol="{Binding StatusGlyph}"
                                                            Style="{StaticResource StatusIcon}"
                                                            ToolTip="{Binding StatusTooltip}" />
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock
                                                                FontWeight="SemiBold"
                                                                TextTrimming="CharacterEllipsis"
                                                                Text="{Binding DisplayTitle}" />
                                                            <TextBlock
                                                                FontSize="11"
                                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding InstalledVersion, TargetNullValue='unknown', Mode=OneWay}" />
                                                                <Run Text=" • " />
                                                                <Run Text="{Binding TargetSummary, Mode=OneWay}" />
                                                                <Run Text=" • " />
                                                                <Run Text="{Binding Author, TargetNullValue='unknown author', Mode=OneWay}" />
                                                            </TextBlock>

                                                            <ContentPresenter
                                                                ContentTemplate="{StaticResource ModListBadges}"
                                                                Content="{Binding}" />
                                                        </StackPanel>

                                                        <!-- Beside the disable toggle, centred on the row, as in the List view. -->
                                                        <Border
                                                            Grid.Column="2"
                                                            Margin="8,0,8,0"
                                                            VerticalAlignment="Center"
                                                            Style="{StaticResource DisabledBadge}"
                                                            Visibility="{Binding IsDisabled, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Style="{StaticResource DisabledBadgeText}" Text="{loc:Str Installed_DisabledTag}" />
                                                        </Border>

                                                        <!-- Per-row disable toggle. ModRow_PreviewMouseLeftButtonDown
                                                             steps aside for anything inside a button, so this click
                                                             isn't swallowed by the row's own click/drag gesture. -->
                                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                            <ui:Button
                                                                Padding="4"
                                                                Appearance="Transparent"
                                                                Command="{Binding DataContext.ToggleDisableCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="{Binding DisableToggleTooltip}">
                                                                <ui:SymbolIcon Symbol="{Binding DisableToggleGlyph}" FontSize="16" />
                                                            </ui:Button>

                                                            <ui:SymbolIcon
                                                                Symbol="Pin24"
                                                                FontSize="12"
                                                                Margin="0,1,0,0"
                                                                HorizontalAlignment="Center"
                                                                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                                ToolTip="{loc:Str Common_PinnedToolTip}"
                                                                Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- List view: the same filtered, sorted set as the other two, one expandable row per mod.
             The header carries what you scan for; the body carries everything the app knows about
             the mod. Occupies the same cell as the two views above; only one is ever visible.
             Focusable="False" for the same reason it's set on the group list - a click inside a row
             shouldn't bubble focus up and nudge the scroller. -->
        <ScrollViewer
            x:Name="ListScrollViewer"
            Grid.Row="4"
            Grid.Column="1"
            Focusable="False"
            VerticalScrollBarVisibility="Auto"
            Visibility="{Binding ShowList, Converter={StaticResource BoolToVis}}">
            <!-- Right margin keeps the overlay scrollbar off the rows' right-hand buttons and chevrons. -->
            <ItemsControl Margin="0,0,14,0" Focusable="False" ItemsSource="{Binding ListItems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewmodels:InstalledModCardViewModel}">
                        <!-- Tickable (OPEN-12 A1): a ticked row carries the accent edge, as a card does. -->
                        <ui:CardExpander
                            Style="{StaticResource TickableCardExpander}"
                            Margin="0,0,6,6"
                            IsExpanded="{Binding IsRowExpanded, Mode=TwoWay}"
                            PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown"
                            MouseRightButtonUp="Mod_MouseRightButtonUp">
                            <ui:CardExpander.Header>
                                <Grid Margin="0,0,8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <CheckBox
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        IsChecked="{Binding IsSelected}"
                                        Visibility="{Binding DataContext.SelectionMode, RelativeSource={RelativeSource AncestorType={x:Type Page}}, Converter={StaticResource BoolToVis}}" />
                                    <ui:SymbolIcon
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center"
                                        FontSize="20"
                                        Symbol="{Binding StatusGlyph}"
                                        Style="{StaticResource StatusIcon}"
                                        ToolTip="{Binding StatusTooltip}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis"
                                            Text="{Binding DisplayTitle}" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding InstalledVersion, TargetNullValue='unknown', Mode=OneWay}" />
                                            <Run Text=" • " />
                                            <Run Text="{Binding TargetSummary, Mode=OneWay}" />
                                            <Run Text=" • " />
                                            <Hyperlink Style="{StaticResource AuthorLink}" ToolTip="{loc:Str Author_LinkToolTip}" Command="{Binding DataContext.OpenAuthorCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}" CommandParameter="{Binding}"><Run Text="{Binding Author, TargetNullValue='unknown author', Mode=OneWay}" /></Hyperlink>
                                        </TextBlock>

                                        <ContentPresenter
                                            ContentTemplate="{StaticResource ModListBadges}"
                                            Content="{Binding}" />
                                    </StackPanel>

                                    <!-- Group membership and disabled state, both readable without
                                         opening the row. -->
                                    <StackPanel
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Margin="12,0,12,0">
                                        <Border
                                            Padding="8,2"
                                            CornerRadius="3"
                                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                                            Visibility="{Binding IsGrouped, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="Folder24" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                <TextBlock FontSize="11" Text="{Binding GroupName}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>

                                        <Border
                                            Margin="6,0,0,0"
                                            Style="{StaticResource DisabledBadge}"
                                            Visibility="{Binding IsDisabled, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Style="{StaticResource DisabledBadgeText}" Text="{loc:Str Installed_DisabledTag}" />
                                        </Border>
                                    </StackPanel>

                                    <!-- Only the non-destructive actions live in the header; Remove
                                         and Sort out are inside the row, which has to be opened first. -->
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal">
                                    <!-- OPEN-12 A2: one click queues this mod's update. -->
                                    <ui:Button
                                        Padding="6"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Top"
                                        Appearance="Transparent"
                                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                        Visibility="{Binding CanQuickUpdate, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.UpdateOneCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding QuickUpdateToolTip}">
                                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" />
                                    </ui:Button>
                                    <StackPanel VerticalAlignment="Center">
                                        <ui:Button
                                            Padding="6"
                                            Appearance="Transparent"
                                            Command="{Binding DataContext.ToggleDisableCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                            CommandParameter="{Binding}"
                                            ToolTip="{Binding DisableToggleTooltip}">
                                            <ui:SymbolIcon Symbol="{Binding DisableToggleGlyph}" FontSize="16" />
                                        </ui:Button>

                                        <ui:SymbolIcon
                                            Symbol="Pin24"
                                            FontSize="12"
                                            Margin="0,1,0,0"
                                            HorizontalAlignment="Center"
                                            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                            ToolTip="{loc:Str Common_PinnedToolTip}"
                                            Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </ui:CardExpander.Header>

                            <ContentPresenter
                                ContentTemplate="{StaticResource ModDetailBody}"
                                Content="{Binding}" />
                        </ui:CardExpander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Only shown in Cards view - the two scrolling views have no use for pages. -->
        <StackPanel
            Grid.Row="5"
            Grid.Column="1"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,8,0,0"
            Visibility="{Binding ShowCards, Converter={StaticResource BoolToVis}}">
            <ui:Button
                Content="{loc:Str Common_Previous}"
                Command="{Binding PreviousPageCommand}" />

            <!-- One TextBlock rather than "Page 3" beside "of 10" - see BrowsePage's pager. -->
            <TextBlock
                Margin="12,0,12,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{loc:Str Common_PagerFormat}">
                        <Binding Path="CurrentPage" Mode="OneWay" />
                        <Binding Path="TotalPages" Mode="OneWay" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <ui:Button
                Margin="12,0,0,0"
                Content="{loc:Str Common_Next}"
                Command="{Binding NextPageCommand}" />
        </StackPanel>
    </Grid>
</Page>
