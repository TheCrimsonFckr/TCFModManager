<ui:FluentWindow
    x:Class="TCFModManager.App.Views.ModGroupsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    xmlns:viewmodels="clr-namespace:TCFModManager.App.ViewModels"
    Title="Mod groups"
    Height="720"
    Width="640"
    MinHeight="420"
    MinWidth="440"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True">
    <!--
        Standalone organizer for sorting installed mods into player-defined groups, MO2-separator
        style - drag a mod card onto a group to sort it there. Purely organizational: nothing here
        changes what's installed, and nothing on the Installed page reads these groups. Scans disk
        itself (via ModGroupsViewModel.LoadAsync) rather than depending on the Installed page's own
        results, so it works whether or not that page has been visited yet this session.
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:FalseToVisibilityConverter x:Key="FalseToVisible" />
        <converters:NullToVisibilityConverter x:Key="NullToCollapsed" />
        <converters:CountToVisibilityConverter x:Key="HasItems" />
        <converters:ModStatusToBrushConverter x:Key="StatusBrush" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Mod groups" />

        <TextBlock
            Grid.Row="1"
            Margin="16,12,16,0"
            TextWrapping="Wrap"
            Opacity="0.7"
            Text="Sort your installed mods into your own groups for reference, like Mod Organizer 2's separators - just drag a mod onto a group below." />

        <DockPanel Grid.Row="2" Margin="16,8,16,0">
            <ui:Button
                DockPanel.Dock="Right"
                Content="Refresh mods"
                Icon="{ui:SymbolIcon ArrowClockwise24}"
                Command="{Binding RefreshCommand}" />
            <TextBlock
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                Opacity="0.8"
                Text="{Binding StatusMessage}" />
        </DockPanel>

        <DockPanel Grid.Row="3" Margin="16,12,16,8">
            <ui:Button
                DockPanel.Dock="Right"
                Content="Add group"
                Icon="{ui:SymbolIcon Add24}"
                Command="{Binding AddGroupCommand}" />
            <ui:TextBox
                Margin="0,0,8,0"
                PlaceholderText="New group name..."
                Text="{Binding NewGroupName, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <!-- One section per user-defined group, plus a fixed Ungrouped bucket last. Each section's
             whole card is a drop target so a drop lands correctly even while collapsed. -->
        <ScrollViewer Grid.Row="4" Margin="16,0,16,16" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Sections}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type viewmodels:ModGroupSectionViewModel}">
                        <ui:Card
                            Margin="0,0,0,8"
                            Padding="10"
                            AllowDrop="True"
                            DragOver="Section_DragOver"
                            Drop="Section_Drop">
                            <StackPanel>
                                <!-- Section header: collapse toggle, name (or rename box), reorder/rename/delete. -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ui:Button
                                        Grid.Column="0"
                                        Padding="4"
                                        Margin="0,0,6,0"
                                        Appearance="Transparent"
                                        Visibility="{Binding IsRealGroup, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.ToggleCollapsedCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Expand/collapse this group">
                                        <ui:SymbolIcon Symbol="{Binding ChevronGlyph}" FontSize="16" />
                                    </ui:Button>

                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                            Visibility="{Binding IsEditing, Converter={StaticResource FalseToVisible}}">
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text=" " />
                                            <Run Text="{Binding CountLabel, Mode=OneWay}" Foreground="#99FFFFFF" />
                                        </TextBlock>

                                        <ui:TextBox
                                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                            KeyDown="RenameTextBox_KeyDown"
                                            LostFocus="RenameTextBox_LostFocus" />
                                    </Grid>

                                    <StackPanel
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        Visibility="{Binding IsRealGroup, Converter={StaticResource BoolToVis}}">
                                        <ui:Button
                                            Padding="4"
                                            Appearance="Transparent"
                                            ToolTip="Move up"
                                            Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}"
                                            Icon="{ui:SymbolIcon ChevronUp24}" />
                                        <ui:Button
                                            Padding="4"
                                            Appearance="Transparent"
                                            ToolTip="Move down"
                                            Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}"
                                            Icon="{ui:SymbolIcon ChevronDown24}" />
                                        <ui:Button
                                            Padding="4"
                                            Margin="6,0,0,0"
                                            Appearance="Transparent"
                                            ToolTip="Rename"
                                            Command="{Binding DataContext.BeginRenameCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}"
                                            Icon="{ui:SymbolIcon Edit24}" />
                                        <ui:Button
                                            Padding="4"
                                            Appearance="Transparent"
                                            Foreground="Red"
                                            ToolTip="Delete this group"
                                            Command="{Binding DataContext.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}"
                                            CommandParameter="{Binding}"
                                            Icon="{ui:SymbolIcon Delete24}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Mods in this group; hidden while collapsed. Each row is a drag source. -->
                                <Grid
                                    Margin="0,8,0,0"
                                    Visibility="{Binding IsCollapsed, Converter={StaticResource FalseToVisible}}">
                                    <TextBlock
                                        Padding="4"
                                        Opacity="0.5"
                                        FontStyle="Italic"
                                        Text="Drag mods here"
                                        Visibility="{Binding Items.Count, Converter={StaticResource HasItems}, ConverterParameter=Invert}" />

                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type viewmodels:InstalledModCardViewModel}">
                                                <Border
                                                    Margin="0,0,0,4"
                                                    Padding="8,6"
                                                    Background="#14FFFFFF"
                                                    CornerRadius="4"
                                                    Cursor="Hand"
                                                    ToolTip="Drag onto another group to move it there"
                                                    PreviewMouseLeftButtonDown="ModRow_PreviewMouseLeftButtonDown"
                                                    PreviewMouseMove="ModRow_PreviewMouseMove">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <ui:SymbolIcon
                                                            Grid.Column="0"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            FontSize="16"
                                                            Symbol="{Binding StatusGlyph}"
                                                            Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"
                                                            ToolTip="{Binding StatusTooltip}" />

                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock
                                                                FontWeight="SemiBold"
                                                                TextTrimming="CharacterEllipsis"
                                                                Text="{Binding DisplayTitle}" />
                                                            <TextBlock
                                                                FontSize="11"
                                                                Opacity="0.6"
                                                                TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding InstalledVersion, TargetNullValue='unknown', Mode=OneWay}" />
                                                                <Run Text=" • " />
                                                                <Run Text="{Binding TargetSummary, Mode=OneWay}" />
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </StackPanel>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</ui:FluentWindow>
