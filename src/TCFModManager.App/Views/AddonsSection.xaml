<UserControl
    x:Class="TCFModManager.App.Views.AddonsSection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:app="clr-namespace:TCFModManager.App"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    xmlns:behaviors="clr-namespace:TCFModManager.App.Behaviors"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    xmlns:views="clr-namespace:TCFModManager.App.Views">
    <!--
        The Addons section of a mod's details dialog. DataContext is an AddonsSectionViewModel,
        set by whichever dialog hosts this. The whole control collapses when the mod has no addons,
        so hosting it costs nothing for the mods that don't.

        Read-only rows (HoverRow, not ClickableRow): the row itself isn't the click target - its
        version picker and its own button are.
    -->
    <UserControl.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToCollapsed" />
        <converters:UpdateAvailableToVisibilityConverter x:Key="TrueToVisible" />
    </UserControl.Resources>

    <StackPanel Visibility="{Binding HasAddons, Converter={StaticResource TrueToVisible}}">
        <Separator Margin="0,12,0,8" Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

        <TextBlock
            FontWeight="SemiBold"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            Text="{Binding Heading}" />

        <TextBlock
            Margin="0,2,0,0"
            TextWrapping="Wrap"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            Text="{loc:Str Addons_Description}" />

        <!-- One explanation for the whole list rather than the same sentence on every row. -->
        <TextBlock
            Margin="0,6,0,0"
            TextWrapping="Wrap"
            Foreground="{DynamicResource SystemFillColorCautionBrush}"
            Text="{Binding ParentNotice}"
            Visibility="{Binding HasParentNotice, Converter={StaticResource TrueToVisible}}" />

        <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Addons}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <views:AddonRowView />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
