<ui:FluentWindow
    x:Class="TCFModManager.App.Views.ThemeEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    xmlns:vm="clr-namespace:TCFModManager.App.ViewModels"
    Title="{loc:Str ThemeEditor_Title}"
    Width="620"
    Height="760"
    MinWidth="540"
    MinHeight="480"
    ShowInTaskbar="False"
    ExtendsContentIntoTitleBar="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="EditorLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="EditorHeader" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>

        <DataTemplate x:Key="ColourRowTemplate" DataType="{x:Type vm:ThemeColourRow}">
            <Grid Margin="0,3,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Style="{StaticResource EditorLabel}" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />

                <ToggleButton
                    x:Name="SwatchToggle"
                    Grid.Column="1"
                    Width="36"
                    Height="28"
                    Margin="0,0,8,0"
                    Cursor="Hand"
                    IsChecked="{Binding IsPickerOpen, Mode=TwoWay}"
                    ToolTip="{loc:Str ThemeEditor_SwatchToolTip}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border
                                Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource SmallCornerRadius}"
                                Padding="3">
                                <Border Background="{Binding Swatch}" CornerRadius="{DynamicResource SmallCornerRadius}" />
                            </Border>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>

                <Popup
                    Grid.Column="1"
                    IsOpen="{Binding IsPickerOpen, Mode=TwoWay}"
                    PlacementTarget="{Binding ElementName=SwatchToggle}"
                    Placement="Bottom"
                    StaysOpen="False"
                    AllowsTransparency="True">
                    <Border
                        Padding="8"
                        Background="{DynamicResource ApplicationBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{DynamicResource ControlCornerRadius}">
                        <ItemsControl Width="200" ItemsSource="{Binding Palette}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button
                                        Width="21"
                                        Height="21"
                                        Margin="2"
                                        Cursor="Hand"
                                        Background="{Binding}"
                                        ToolTip="{Binding}"
                                        Command="{Binding DataContext.PickCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="{DynamicResource SmallCornerRadius}" />
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Popup>

                <ui:TextBox
                    x:Name="HexBox"
                    Grid.Column="2"
                    FontFamily="Consolas, Cascadia Mono"
                    PlaceholderText="{Binding Placeholder}"
                    Text="{Binding Hex, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="{loc:Str ThemeEditor_HexToolTip}" />

                <ui:Button
                    Grid.Column="3"
                    Margin="6,0,0,0"
                    Appearance="Transparent"
                    Icon="{ui:SymbolIcon ArrowReset24}"
                    Command="{Binding ResetCommand}"
                    ToolTip="{loc:Str ThemeEditor_ResetToolTip}" />

                <ui:SymbolIcon
                    Grid.Column="4"
                    Margin="8,0,0,0"
                    HorizontalAlignment="Left"
                    Symbol="Warning24"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    ToolTip="{loc:Str ThemeEditor_InvalidColour}"
                    Visibility="{Binding IsInvalid, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{loc:Str ThemeEditor_Title}" />

        <Grid Grid.Row="1" Margin="24,12,24,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource EditorLabel}" Text="{loc:Str ThemeEditor_StartFrom}" />
            <ComboBox
                Grid.Row="0"
                Grid.Column="1"
                Margin="0,0,0,8"
                DisplayMemberPath="Label"
                ItemsSource="{Binding StartOptions}"
                SelectedItem="{Binding SelectedStart}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource EditorLabel}" Text="{loc:Str ThemeEditor_Name}" />
            <ui:TextBox
                Grid.Row="1"
                Grid.Column="1"
                Margin="0,0,0,8"
                MaxLength="80"
                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource EditorLabel}" Text="{loc:Str ThemeEditor_Base}" />
            <ComboBox
                Grid.Row="2"
                Grid.Column="1"
                DisplayMemberPath="Label"
                ItemsSource="{Binding BaseOptions}"
                SelectedItem="{Binding SelectedBase}" />
        </Grid>

        <ScrollViewer Grid.Row="2" Margin="0,4,0,0" Padding="24,0,24,8" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Style="{StaticResource EditorHeader}" Margin="0,8,0,6" Text="{loc:Str ThemeEditor_SectionAccent}" />
                <ContentControl Content="{Binding AccentRow}" ContentTemplate="{StaticResource ColourRowTemplate}" />

                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ThemeColourGroup}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource EditorHeader}" Text="{Binding Header}" />
                                <ItemsControl ItemsSource="{Binding Rows}" ItemTemplate="{StaticResource ColourRowTemplate}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource EditorHeader}" Text="{loc:Str ThemeEditor_SectionShape}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource EditorLabel}" Text="{loc:Str ThemeEditor_Corners}" />
                    <ComboBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="0,0,0,8"
                        HorizontalAlignment="Left"
                        MinWidth="200"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding CornerOptions}"
                        SelectedItem="{Binding SelectedCorner}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource EditorLabel}" Text="{loc:Str ThemeEditor_Font}" />
                    <ComboBox
                        Grid.Row="1"
                        Grid.Column="1"
                        HorizontalAlignment="Left"
                        MinWidth="200"
                        MaxDropDownHeight="360"
                        DisplayMemberPath="Label"
                        ItemsSource="{Binding FontOptions}"
                        SelectedItem="{Binding SelectedFont}" />
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Margin="24,8,24,0">
            <ItemsControl ItemsSource="{Binding Problems}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                            <ui:SymbolIcon Symbol="Warning24" FontSize="14" Margin="0,0,6,0" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Status}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <Grid Grid.Row="4" Margin="24,12,24,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Column="0">
                <ui:Button Margin="0,0,8,0" Icon="{ui:SymbolIcon ArrowImport24}" Content="{loc:Str ThemeEditor_Import}" Command="{Binding ImportCommand}" />
                <ui:Button Margin="0,0,8,0" Icon="{ui:SymbolIcon ArrowExportLtr24}" Content="{loc:Str ThemeEditor_Export}" Command="{Binding ExportCommand}" />
            </WrapPanel>

            <WrapPanel Grid.Column="2">
                <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon Delete24}" Content="{loc:Str ThemeEditor_Delete}" Command="{Binding DeleteCommand}" />
                <ui:Button Margin="8,0,0,0" Icon="{ui:SymbolIcon ArrowUndo24}" Content="{loc:Str ThemeEditor_Revert}" Command="{Binding RevertCommand}" />
                <ui:Button Margin="8,0,0,0" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Content="{loc:Str Common_Save}" Command="{Binding SaveCommand}" />
                <ui:Button Margin="8,0,0,0" Content="{loc:Str Common_Close}" Click="Close_Click" />
            </WrapPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
