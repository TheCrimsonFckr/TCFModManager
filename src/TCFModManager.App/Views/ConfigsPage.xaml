<!-- ScrollViewer.CanContentScroll="False" opts this page out of WPF-UI's automatic outer
     DynamicScrollViewer: NavigationView wraps every hosted Page's content in one by default, which
     sits above this page's own scrolling regions and makes the wheel behave strangely (see the
     scroll-anywhere corrections on InstalledPage for the full story). This page scrolls its own
     list and its own editor, so it wants that wrapper gone.
     Background="Transparent" on the root Grid is the other half: a Grid with no Background only
     takes part in hit-testing where a child actually paints, so without it the wheel handler below
     would never see events over the empty parts of the page. -->
<Page
    x:Class="TCFModManager.App.Views.ConfigsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    xmlns:tcf="clr-namespace:TCFModManager.App.Controls"
    xmlns:viewmodels="clr-namespace:TCFModManager.App.ViewModels"
    Title="{loc:Str Nav_Configs}"
    Loaded="ConfigsPage_Loaded"
    ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToCollapsed" />
        <converters:FalseToVisibilityConverter x:Key="FalseToVisible" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:BoolToButtonAppearanceConverter x:Key="BoolToAppearance" />

        <Style x:Key="FormCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1,0,1,0" />
            <Setter Property="Padding" Value="16,0,16,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLast}" Value="True">
                    <Setter Property="BorderThickness" Value="1,0,1,1" />
                    <Setter Property="CornerRadius" Value="0,0,6,6" />
                    <Setter Property="Margin" Value="0,0,0,12" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="BooleanValue">
            <tcf:SettingSwitch IsChecked="{Binding IsOn}" />
        </DataTemplate>

        <DataTemplate x:Key="NumberValue">
            <ui:NumberBox
                Width="150"
                SpinButtonPlacementMode="Compact"
                ClearButtonEnabled="False"
                SmallChange="{Binding Step, Mode=OneTime}"
                MaxDecimalPlaces="{Binding DecimalPlaces, Mode=OneTime}"
                Value="{Binding NumberValue}" />
        </DataTemplate>

        <DataTemplate x:Key="SliderValue">
            <StackPanel Orientation="Horizontal">
                <tcf:SettingSlider VerticalAlignment="Center" />
                <ui:NumberBox
                    Width="130"
                    Margin="12,0,0,0"
                    SpinButtonPlacementMode="Compact"
                    ClearButtonEnabled="False"
                    SmallChange="{Binding Step, Mode=OneTime}"
                    MaxDecimalPlaces="{Binding DecimalPlaces, Mode=OneTime}"
                    Value="{Binding NumberValue}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ChoiceValue">
            <ComboBox
                MinWidth="200"
                ItemsSource="{Binding Choices, Mode=OneTime}"
                SelectedItem="{Binding SelectedChoice}" />
        </DataTemplate>

        <DataTemplate x:Key="FlagsValue">
            <ItemsControl MaxWidth="360" ItemsSource="{Binding Flags, Mode=OneTime}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Margin="0,0,12,0" IsChecked="{Binding IsChecked}">
                            <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" />
                        </CheckBox>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="ColorValue">
            <StackPanel Orientation="Horizontal">
                <Border
                    Width="30"
                    Height="30"
                    CornerRadius="4"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    Background="{Binding Swatch}" />
                <ui:TextBox
                    Width="130"
                    Margin="8,0,0,0"
                    FontFamily="Consolas, Cascadia Mono, Courier New, DejaVu Sans Mono, Liberation Mono, Tahoma"
                    MaxLength="9"
                    ToolTip="{loc:Str Configs_ColorToolTip}"
                    Text="{Binding ColorText, UpdateSourceTrigger=PropertyChanged}" />
                <ui:SymbolIcon
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Symbol="ErrorCircle24"
                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                    ToolTip="{loc:Str Configs_ColorToolTip}"
                    Visibility="{Binding IsColorValid, Converter={StaticResource FalseToVisible}}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ShortcutValue">
            <tcf:ShortcutBox Shortcut="{Binding ShortcutValue}" />
        </DataTemplate>

        <DataTemplate x:Key="TextValue">
            <ui:TextBox Width="260" Text="{Binding TextValue, UpdateSourceTrigger=PropertyChanged}" />
        </DataTemplate>

        <tcf:ConfigValueTemplateSelector
            x:Key="ConfigValueTemplates"
            Boolean="{StaticResource BooleanValue}"
            Number="{StaticResource NumberValue}"
            Slider="{StaticResource SliderValue}"
            Choice="{StaticResource ChoiceValue}"
            Flags="{StaticResource FlagsValue}"
            Color="{StaticResource ColorValue}"
            Shortcut="{StaticResource ShortcutValue}"
            Text="{StaticResource TextValue}" />

        <DataTemplate DataType="{x:Type viewmodels:ConfigSectionItem}">
            <Border
                Padding="16,12,16,10"
                CornerRadius="6,6,0,0"
                BorderThickness="1,1,1,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <DockPanel>
                    <ui:Button
                        DockPanel.Dock="Right"
                        Margin="8,-4,0,-4"
                        Padding="8,4"
                        Appearance="Transparent"
                        Content="{loc:Str Configs_ResetMod}"
                        Icon="{ui:SymbolIcon ArrowReset24}"
                        ToolTip="{loc:Str Configs_ResetModToolTip}"
                        Command="{Binding ResetCommand}"
                        Visibility="{Binding CanReset, Converter={StaticResource BoolToVis}}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding Name}" />
                </DockPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodels:ConfigSettingRow}">
            <Border Style="{StaticResource FormCard}">
                <Border
                    Padding="0,10,0,10"
                    BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="120" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Rectangle
                            Grid.Column="0"
                            Width="3"
                            Margin="0,0,10,0"
                            RadiusX="1.5"
                            RadiusY="1.5"
                            Fill="{DynamicResource SelectedRowStroke}"
                            ToolTip="{loc:Str Configs_ChangedBarToolTip}"
                            Visibility="{Binding DiffersFromDefault, Converter={StaticResource BoolToVis}}" />

                        <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                            <TextBlock
                                Margin="0,0,0,2"
                                FontSize="11"
                                TextWrapping="Wrap"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding Context, Mode=OneTime}"
                                Visibility="{Binding HasContext, Mode=OneTime, Converter={StaticResource BoolToVis}}" />
                            <TextBlock
                                TextWrapping="Wrap"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding Name, Mode=OneTime}" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                TextWrapping="Wrap"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding Description, Mode=OneTime}"
                                Visibility="{Binding HasDescription, Mode=OneTime, Converter={StaticResource BoolToVis}}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="12"
                                TextWrapping="Wrap"
                                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                Text="{Binding Note}"
                                Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <ui:Button
                            Grid.Column="2"
                            Margin="0,0,8,0"
                            Padding="8,4"
                            VerticalAlignment="Center"
                            Appearance="Transparent"
                            Content="{loc:Str Configs_ResetSetting}"
                            ToolTip="{Binding ResetToolTip}"
                            Command="{Binding ResetCommand}"
                            Visibility="{Binding CanReset, Converter={StaticResource BoolToVis}}" />

                        <ContentControl
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Focusable="False"
                            IsTabStop="False"
                            Content="{Binding}"
                            ContentTemplateSelector="{StaticResource ConfigValueTemplates}" />
                    </Grid>
                </Border>
            </Border>
        </DataTemplate>
    </Page.Resources>

    <Grid
        x:Name="RootGrid"
        Margin="16"
        Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Closable, but not remembered - see ShowDisclaimer on the view model. -->
        <ui:InfoBar
            Grid.Row="0"
            Margin="0,0,0,12"
            Severity="Warning"
            IsClosable="True"
            IsOpen="{Binding ShowDisclaimer, Mode=TwoWay}"
            Title="{loc:Str Configs_DisclaimerTitle}"
            Message="{loc:Str Configs_DisclaimerMessage}" />

        <DockPanel Grid.Row="1" Margin="0,0,0,12">
            <ui:Button
                DockPanel.Dock="Right"
                Content="{loc:Str Common_Rescan}"
                Icon="{ui:SymbolIcon ArrowSync24}"
                Command="{Binding ScanCommand}" />

            <ui:ProgressRing
                DockPanel.Dock="Right"
                Width="20"
                Height="20"
                Margin="0,0,12,0"
                IsIndeterminate="True"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <TextBlock
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding StatusMessage}" />
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- The list. Grouped by where each file lives, so the client/server split is the shape
                 of the list rather than a chip on each row. One ListBox rather than nested
                 ItemsControls, so it has a single selection and the arrow keys walk the whole
                 thing - the grouping is added to the collection's default view in code-behind. -->
            <Grid x:Name="RailPanel" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ui:TextBox
                    Grid.Row="0"
                    Margin="0,0,0,8"
                    PlaceholderText="{loc:Str Configs_SearchPlaceholder}"
                    Icon="{ui:SymbolIcon Search24}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <ComboBox
                    Grid.Row="1"
                    Margin="0,0,0,8"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{Binding SourceFilterOptions}"
                    SelectedItem="{Binding SelectedSourceFilter}" />

                <StackPanel Grid.Row="2" Margin="0,0,0,4">
                    <ui:Button
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="10,6"
                        Content="{Binding ChangedViewLabel}"
                        Icon="{ui:SymbolIcon ArrowReset24}"
                        Appearance="{Binding ShowChangedView, Converter={StaticResource BoolToAppearance}}"
                        Command="{Binding OpenChangedViewCommand}" />
                    <ui:Button
                        Margin="0,6,0,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Padding="10,6"
                        Content="{Binding KeybindsViewLabel}"
                        Icon="{ui:SymbolIcon Keyboard24}"
                        Appearance="{Binding ShowKeybindsView, Converter={StaticResource BoolToAppearance}}"
                        Command="{Binding OpenKeybindsViewCommand}" />
                </StackPanel>

                <TextBlock
                    Grid.Row="3"
                    Margin="4,12,0,0"
                    VerticalAlignment="Top"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{loc:Str Configs_NoMatches}"
                    Visibility="{Binding HasResults, Converter={StaticResource FalseToVisible}}" />

                <ScrollViewer
                    x:Name="ListScrollViewer"
                    Grid.Row="3"
                    Focusable="False"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Visibility="{Binding HasResults, Converter={StaticResource BoolToVis}}">
                    <ListBox
                        x:Name="ConfigList"
                        Background="Transparent"
                        BorderThickness="0"
                        Margin="0,0,12,0"
                        ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ItemsSource="{Binding Results}"
                        SelectedItem="{Binding SelectedMod}"
                        HorizontalContentAlignment="Stretch">
                        <!-- The row Border below draws the hover and the selection, so the item
                             itself contributes no padding, margin, fill or chrome of its own. -->
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />

                                <!-- Replaced outright, not just zeroed: the stock template paints
                                     its own accent fill for a selected row whatever Background
                                     says, which stacks with the one the row draws. See trap 8 in
                                     the theme notes. -->
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <!-- DataContext is the CollectionViewGroup: Name is the
                                             ConfigSectionHeader, ItemCount the number of files. -->
                                        <StackPanel Margin="0,12,0,6">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon
                                                    VerticalAlignment="Center"
                                                    FontSize="16"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Symbol="{Binding Name.Glyph}" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Text="{Binding Name.Title}" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding Name.Location}" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="{Binding ItemCount, StringFormat='({0})'}" />
                                            </StackPanel>
                                            <Separator Margin="0,6,0,0" Opacity="0.25" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ClickableRow}" Padding="6,4" Opacity="{Binding RowOpacity}">
                                    <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <ui:SymbolIcon
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        FontSize="16"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Symbol="{Binding Glyph}" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            TextTrimming="CharacterEllipsis"
                                            Text="{Binding Title}" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding Subtitle}"
                                            Text="{Binding Subtitle}" />
                                        <ui:Badge
                                            Margin="0,3,0,0"
                                            HorizontalAlignment="Left"
                                            Appearance="Caution"
                                            FontSize="10"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Content="{Binding Badge}"
                                            Visibility="{Binding Badge, Converter={StaticResource NullToCollapsed}}" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="2"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Ellipse
                                            Width="7"
                                            Height="7"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Fill="{DynamicResource SelectedRowStroke}"
                                            ToolTip="{loc:Str Configs_UnsavedMarkerToolTip}"
                                            Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
                                        <Border
                                            Padding="6,1"
                                            CornerRadius="8"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                            ToolTip="{loc:Str Configs_ChangedBarToolTip}"
                                            Visibility="{Binding HasChanges, Converter={StaticResource BoolToVis}}">
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding ChangedCount}" />
                                        </Border>
                                    </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </ScrollViewer>

                <TextBlock
                    Grid.Row="4"
                    Margin="4,8,12,0"
                    FontSize="11"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding Footer}" />
            </Grid>

            <GridSplitter
                Grid.Column="1"
                Width="6"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Background="Transparent" />

            <!-- The editor: a form for a .cfg file, with the text box as its Raw view. -->
            <Grid Grid.Column="2" Margin="8,0,0,0">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    TextWrapping="Wrap"
                    TextAlignment="Center"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    MaxWidth="380"
                    Text="{loc:Str Configs_EmptyState}"
                    Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVis}}" />

                <Grid Visibility="{Binding ShowEditor, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel
                        Grid.Row="0"
                        Margin="0,0,0,8"
                        Visibility="{Binding ShowListView, Converter={StaticResource BoolToVis}}">
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding ListTitle}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding ListNote}" />
                    </StackPanel>

                    <DockPanel
                        Grid.Row="0"
                        Margin="0,0,0,8"
                        Visibility="{Binding ShowModView, Converter={StaticResource BoolToVis}}">
                        <ui:Button
                            DockPanel.Dock="Right"
                            Padding="8,6"
                            ToolTip="{loc:Str Configs_ShowInExplorerToolTip}"
                            Icon="{ui:SymbolIcon FolderOpen24}"
                            Command="{Binding OpenFolderCommand}" />
                        <ui:Button
                            DockPanel.Dock="Right"
                            Margin="0,0,8,0"
                            Padding="8,6"
                            ToolTip="{loc:Str Configs_CopyPathToolTip}"
                            Icon="{ui:SymbolIcon Copy24}"
                            Command="{Binding CopyPathCommand}" />

                        <StackPanel>
                            <TextBlock
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                TextTrimming="CharacterEllipsis"
                                Text="{Binding SelectedMod.Title}" />
                            <TextBlock
                                FontSize="12"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding SelectedMod.Details}"
                                Visibility="{Binding SelectedMod.HasDetails, Converter={StaticResource BoolToVis}}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                TextWrapping="Wrap"
                                Text="{Binding SelectedEntry.Entry.DisplayPath}" />

                            <ItemsControl
                                Margin="0,8,0,0"
                                ItemsSource="{Binding SelectedMod.Tabs}"
                                Visibility="{Binding SelectedMod.HasTabs, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <ui:Button
                                            Margin="0,0,6,4"
                                            Padding="10,5"
                                            Appearance="{Binding IsSelected, Converter={StaticResource BoolToAppearance}}"
                                            Command="{Binding DataContext.SelectFileCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                            CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
                                                <Ellipse
                                                    Width="6"
                                                    Height="6"
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Fill="{DynamicResource SelectedRowStroke}"
                                                    ToolTip="{loc:Str Configs_UnsavedMarkerToolTip}"
                                                    Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </ui:Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DockPanel>

                    <StackPanel
                        Grid.Row="1"
                        Margin="0,0,0,8"
                        Visibility="{Binding ShowModView, Converter={StaticResource BoolToVis}}">
                        <!-- The one line that says what editing this file actually means - which
                             half of the install it belongs to, and what happens to it when the mod
                             is disabled or removed. -->
                        <TextBlock
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding SelectedEntry.LocationNote}" />

                        <TextBlock
                            Margin="0,6,0,0"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                            Text="{Binding SelectedEntry.StateNote}"
                            Visibility="{Binding SelectedEntry.HasStateNote, Converter={StaticResource BoolToVis}}" />

                        <!-- What the last recorded update did to this exact file. The Downloads queue
                             says it once, as it happens; this is where it can still be read later. -->
                        <TextBlock
                            Margin="0,6,0,0"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding SelectedEntry.UpdateNote}"
                            Visibility="{Binding SelectedEntry.HasUpdateNote, Converter={StaticResource BoolToVis}}" />

                        <!-- Per-mod, and only for a server mod's own config: nothing an update does
                             can reach a client mod's settings in BepInEx\config. -->
                        <StackPanel
                            Margin="0,10,0,0"
                            Visibility="{Binding ShowPolicy, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Margin="0,0,8,0"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{loc:Str Configs_UpdatePolicyLabel}" />

                                <ComboBox
                                    MinWidth="190"
                                    ItemsSource="{Binding PolicyOptions}"
                                    SelectedItem="{Binding SelectedPolicyOption}"
                                    ToolTip="{loc:Str Configs_UpdatePolicyToolTip}" />
                            </StackPanel>

                            <TextBlock
                                Margin="0,6,0,0"
                                TextWrapping="Wrap"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding PolicyNote}" />

                            <!-- The places a mod keeps things no convention would find, and the ones
                                 that only look like config. A chip each, with the kind spelled out,
                                 because the three do opposite things. -->
                            <ItemsControl
                                Margin="0,8,0,0"
                                ItemsSource="{Binding Locations}"
                                Visibility="{Binding HasLocations, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,6,4"
                                            Padding="8,2"
                                            CornerRadius="{DynamicResource SmallCornerRadius}"
                                            ToolTip="{Binding ToolTip}"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock
                                                    FontSize="11"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                    Text="{Binding Label}" />

                                                <ui:Button
                                                    Margin="6,0,-4,0"
                                                    Padding="2"
                                                    MinWidth="0"
                                                    MinHeight="0"
                                                    Appearance="Transparent"
                                                    ToolTip="{loc:Str Configs_StopTreatingToolTip}"
                                                    Command="{Binding DataContext.RemoveLocationCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                    CommandParameter="{Binding}">
                                                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" />
                                                </ui:Button>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <WrapPanel Margin="0,4,0,0">
                                <ui:Button
                                    Margin="0,0,8,4"
                                    Content="{loc:Str Configs_AuthoredFiles}"
                                    Icon="{ui:SymbolIcon FolderAdd24}"
                                    ToolTip="{loc:Str Configs_AuthoredFilesToolTip}"
                                    Command="{Binding AddUserDataFolderCommand}" />

                                <ui:Button
                                    Margin="0,0,8,4"
                                    Content="{loc:Str Configs_SettingsElsewhere}"
                                    Icon="{ui:SymbolIcon DocumentAdd24}"
                                    ToolTip="{loc:Str Configs_SettingsElsewhereToolTip}"
                                    Command="{Binding AddSettingsFileCommand}" />

                                <ui:Button
                                    Margin="0,0,0,4"
                                    Content="{loc:Str Configs_NotAConfig}"
                                    Icon="{ui:SymbolIcon EyeOff24}"
                                    ToolTip="{loc:Str Configs_NotAConfigToolTip}"
                                    Command="{Binding IgnoreSelectedFileCommand}" />
                            </WrapPanel>
                        </StackPanel>

                        <TextBlock
                            Margin="0,6,0,0"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                            Text="{Binding RunningWarning}"
                            Visibility="{Binding RunningWarning, Converter={StaticResource NullToCollapsed}}" />

                        <TextBlock
                            Margin="0,6,0,0"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            Text="{Binding EditorError}"
                            Visibility="{Binding EditorError, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>

                    <DockPanel
                        Grid.Row="2"
                        Margin="0,0,0,8"
                        Visibility="{Binding ShowToolbar, Converter={StaticResource BoolToVis}}">
                        <StackPanel
                            DockPanel.Dock="Right"
                            Margin="12,0,0,0"
                            VerticalAlignment="Top"
                            Orientation="Horizontal"
                            Visibility="{Binding CanUseForm, Converter={StaticResource BoolToVis}}">
                            <ui:Button
                                Padding="10,6"
                                Content="{loc:Str Configs_ViewForm}"
                                Icon="{ui:SymbolIcon Form24}"
                                ToolTip="{loc:Str Configs_ViewToolTip}"
                                Appearance="{Binding ShowFormView, Converter={StaticResource BoolToAppearance}}"
                                Command="{Binding UseFormCommand}" />
                            <ui:Button
                                Margin="6,0,0,0"
                                Padding="10,6"
                                Content="{loc:Str Configs_ViewRaw}"
                                Icon="{ui:SymbolIcon Code24}"
                                ToolTip="{loc:Str Configs_ViewToolTip}"
                                Appearance="{Binding ShowRawView, Converter={StaticResource BoolToAppearance}}"
                                Command="{Binding UseRawCommand}" />
                        </StackPanel>

                        <WrapPanel Visibility="{Binding ShowFormList, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" Visibility="{Binding Form.IsFileMode, Converter={StaticResource BoolToVis}}">
                                <ui:Button
                                    Margin="0,0,6,6"
                                    Padding="10,6"
                                    Content="{loc:Str Configs_ShowAll}"
                                    Appearance="{Binding Form.ShowAllSettings, Converter={StaticResource BoolToAppearance}}"
                                    Command="{Binding Form.ShowAllCommand}" />
                                <ui:Button
                                    Margin="0,0,12,6"
                                    Padding="10,6"
                                    Content="{Binding Form.ChangedLabel}"
                                    Appearance="{Binding Form.ShowChangedOnly, Converter={StaticResource BoolToAppearance}}"
                                    Command="{Binding Form.ShowChangedCommand}" />
                            </StackPanel>
                            <ui:TextBox
                                Width="220"
                                Margin="0,0,12,6"
                                PlaceholderText="{loc:Str Configs_SearchSettingsPlaceholder}"
                                Icon="{ui:SymbolIcon Search24}"
                                Text="{Binding Form.SearchText, UpdateSourceTrigger=PropertyChanged}" />
                            <ui:Button
                                Margin="0,0,6,6"
                                Padding="10,6"
                                Content="{loc:Str Configs_ResetMod}"
                                Icon="{ui:SymbolIcon ArrowReset24}"
                                ToolTip="{loc:Str Configs_ResetModToolTip}"
                                Command="{Binding ResetModCommand}"
                                Visibility="{Binding ShowModView, Converter={StaticResource BoolToVis}}" />
                            <ui:Button
                                Margin="0,0,6,6"
                                Padding="10,6"
                                Content="{loc:Str Configs_ResetAll}"
                                Icon="{ui:SymbolIcon ArrowReset24}"
                                ToolTip="{loc:Str Configs_ResetAllToolTip}"
                                Command="{Binding ResetEverythingCommand}"
                                Visibility="{Binding ShowChangedView, Converter={StaticResource BoolToVis}}" />
                            <ui:Button
                                Margin="0,0,0,6"
                                Padding="10,6"
                                Content="{loc:Str Configs_CopyChanges}"
                                Icon="{ui:SymbolIcon Copy24}"
                                ToolTip="{loc:Str Configs_CopyChangesToolTip}"
                                Command="{Binding CopyChangesCommand}"
                                Visibility="{Binding ShowKeybindsView, Converter={StaticResource FalseToVisible}}" />
                        </WrapPanel>
                    </DockPanel>

                    <Grid
                        x:Name="FormPanel"
                        Grid.Row="3"
                        Background="Transparent"
                        Visibility="{Binding ShowFormList, Converter={StaticResource BoolToVis}}">
                        <TextBlock
                            Margin="4,12,0,0"
                            VerticalAlignment="Top"
                            TextWrapping="Wrap"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{Binding Form.EmptyMessage}"
                            Visibility="{Binding Form.HasItems, Converter={StaticResource FalseToVisible}}" />

                        <ItemsControl
                            x:Name="FormList"
                            Focusable="False"
                            ItemsSource="{Binding Form.Items}"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Standard"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            ScrollViewer.CanContentScroll="True"
                            Visibility="{Binding Form.HasItems, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.Template>
                                <ControlTemplate TargetType="ItemsControl">
                                    <ScrollViewer
                                        x:Name="FormScroll"
                                        Focusable="False"
                                        CanContentScroll="True"
                                        VerticalScrollBarVisibility="Auto"
                                        HorizontalScrollBarVisibility="Disabled">
                                        <ItemsPresenter Margin="0,0,12,0" />
                                    </ScrollViewer>
                                </ControlTemplate>
                            </ItemsControl.Template>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>

                    <TextBox
                        Grid.Row="3"
                        Visibility="{Binding ShowRawView, Converter={StaticResource BoolToVis}}"
                        AcceptsReturn="True"
                        AcceptsTab="True"
                        FontFamily="Consolas, Cascadia Mono, Courier New, DejaVu Sans Mono, Liberation Mono, Tahoma"
                        FontSize="13"
                        TextWrapping="NoWrap"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalContentAlignment="Top"
                        SpellCheck.IsEnabled="False"
                        Text="{Binding EditorText, UpdateSourceTrigger=PropertyChanged}" />

                    <DockPanel Grid.Row="4" Margin="0,8,0,0">
                        <ui:Button
                            DockPanel.Dock="Right"
                            Appearance="Primary"
                            Content="{loc:Str Common_Save}"
                            Icon="{ui:SymbolIcon Save24}"
                            Command="{Binding SaveCommand}"
                            Visibility="{Binding ShowModView, Converter={StaticResource BoolToVis}}" />
                        <ui:Button
                            DockPanel.Dock="Right"
                            Margin="0,0,8,0"
                            Content="{loc:Str Configs_Revert}"
                            Icon="{ui:SymbolIcon ArrowUndo24}"
                            ToolTip="{loc:Str Configs_RevertToolTip}"
                            Command="{Binding RevertCommand}"
                            Visibility="{Binding ShowModView, Converter={StaticResource BoolToVis}}" />
                        <ui:Button
                            DockPanel.Dock="Right"
                            Margin="0,0,8,0"
                            Appearance="{Binding ShowListView, Converter={StaticResource BoolToAppearance}}"
                            Content="{loc:Str Configs_SaveAll}"
                            Icon="{ui:SymbolIcon SaveMultiple24}"
                            ToolTip="{loc:Str Configs_SaveAllToolTip}"
                            Command="{Binding SaveAllCommand}" />
                        <ui:Button
                            DockPanel.Dock="Right"
                            Margin="0,0,8,0"
                            Content="{loc:Str Configs_RevertAll}"
                            Icon="{ui:SymbolIcon ArrowUndo24}"
                            ToolTip="{loc:Str Configs_RevertAllToolTip}"
                            Command="{Binding RevertAllCommand}" />

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{loc:Str Configs_UnsavedChanges}"
                                Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding DirtyLabel}"
                                Visibility="{Binding HasDirty, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Page>
