<ui:FluentWindow
    x:Class="TCFModManager.App.Views.ModListVersionChangeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    Width="480"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    ExtendsContentIntoTitleBar="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">
    <!--
        Shown when a mod list names a version that is no longer published on sp-mod.com. One row per
        mod, ticked by default, so the substitution is visible and reversible rather than silent.
        Same plain-modal-FluentWindow shape as ReadModPageConfirmationWindow.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="WindowTitleBar"
            Grid.Row="0"
            Title="{loc:Str ModListVersionChange_Title}"
            ShowMinimize="False"
            ShowMaximize="False" />

        <StackPanel
            Grid.Row="1"
            Margin="24,12,24,0">
            <TextBlock
                Style="{StaticResource DialogText}"
                x:Name="IntroText"
                TextWrapping="Wrap"
                Margin="0,0,0,16"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{loc:Str ModListVersionChange_Lead}" />

            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ChangesList" Margin="0,0,0,-8">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Margin="0,0,0,8" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox
                                        Grid.Column="0"
                                        VerticalAlignment="Center"
                                        Margin="0,0,12,0"
                                        IsChecked="{Binding IsAccepted, Mode=TwoWay}" />

                                    <StackPanel Grid.Column="1">
                                        <TextBlock
                                            TextWrapping="Wrap"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding Name}" />
                                        <TextBlock
                                            TextWrapping="Wrap"
                                            Margin="0,3,0,0"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{Binding Detail}" />
                                    </StackPanel>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <WrapPanel Grid.Row="2" Style="{StaticResource DialogButtonBar}">
            <ui:Button
                Style="{StaticResource DialogButton}"
                IsCancel="True"
                Content="{loc:Str Common_Cancel}"
                Click="CancelButton_Click" />

            <ui:Button
                Style="{StaticResource DialogButton}"
                Appearance="Primary"
                IsDefault="True"
                Content="{loc:Str Common_Continue}"
                Click="ContinueButton_Click" />
        </WrapPanel>
    </Grid>
</ui:FluentWindow>
