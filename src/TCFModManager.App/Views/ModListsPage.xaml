<!-- ScrollViewer.CanContentScroll="False" opts this page out of WPF-UI's automatic outer
     DynamicScrollViewer, the same as ConfigsPage and InstalledPage: this page scrolls its own two
     lists, so that wrapper only gets in the way. Background="Transparent" on the root Grid is the
     other half - a Grid with no Background only takes part in hit-testing where a child paints.

     Every TextBlock sets its Foreground from a DynamicResource brush. A plain ListBox's default
     template hands its items the system control foreground - black - so anything inheriting inside
     one is unreadable in dark mode. Secondary/Tertiary carry the de-emphasis rather than Opacity,
     which is the mapping the v1.6.0 theme sweep settled on. -->
<Page
    x:Class="TCFModManager.App.Views.ModListsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    Title="Mod lists"
    Loaded="ModListsPage_Loaded"
    ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <converters:FalseToVisibilityConverter x:Key="FalseToVisible" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--
            The container contributes nothing - no padding, margin or fill - so the row Border
            inside the template draws the whole thing, the same arrangement ConfigsPage uses. Left
            to itself the stock container shows a grey edge around the row, and hands its content
            the system control foreground, which is black whatever the theme is.
        -->
        <Style x:Key="BareContainer" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="ReadOnlyContainer" TargetType="ListBoxItem" BasedOn="{StaticResource BareContainer}">
            <Setter Property="Focusable" Value="False" />
        </Style>
    </Page.Resources>

    <Grid
        x:Name="RootGrid"
        Margin="20"
        Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: make a list or bring one in, then the ones already here. -->
        <Grid Grid.Row="0" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:Card Grid.Row="0" Padding="16">
                <StackPanel>
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="Save what's installed now" />

                    <TextBlock
                        TextWrapping="Wrap"
                        Margin="0,4,0,12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Records the mods that are currently enabled, at the versions you have." />

                    <ui:TextBox
                        PlaceholderText="List name"
                        Text="{Binding NewListName, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ui:Button
                            Grid.Column="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Appearance="Primary"
                            Icon="{ui:SymbolIcon AppsList24}"
                            Content="Capture"
                            Command="{Binding CaptureCommand}" />

                        <ui:Button
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            ToolTip="Open a mod list someone shared with you"
                            Icon="{ui:SymbolIcon ArrowImport24}"
                            Content="Import"
                            Command="{Binding ImportCommand}" />
                    </Grid>
                </StackPanel>
            </ui:Card>

            <TextBlock
                Grid.Row="1"
                Margin="4,20,0,8"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Saved lists" />

            <ui:Card Grid.Row="2" Padding="4">
                <Grid>
                    <TextBlock
                        Margin="12"
                        TextWrapping="Wrap"
                        VerticalAlignment="Top"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Visibility="{Binding HasLists, Converter={StaticResource FalseToVisible}}"
                        Text="Nothing saved yet. Capture what you have installed, or import a list someone sent you." />

                    <ListBox
                        x:Name="ListsBox"
                        BorderThickness="0"
                        Background="Transparent"
                        ItemContainerStyle="{StaticResource BareContainer}"
                        ItemsSource="{Binding Lists}"
                        SelectedItem="{Binding Selected, Mode=TwoWay}"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ClickableRow}" Padding="10,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock
                                            TextWrapping="Wrap"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding Name}" />

                                        <TextBlock
                                            TextWrapping="Wrap"
                                            FontSize="12"
                                            Margin="0,3,0,0"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{Binding Detail}" />
                                    </StackPanel>

                                    <ui:SymbolIcon
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="10,0,0,0"
                                        ToolTip="This install is following this list"
                                        Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                        Symbol="CheckmarkCircle24"
                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </ui:Card>

            <!-- The single undo point, kept here rather than among the lists: it is about the
                 install, not about whichever list happens to be selected. Hidden until there is
                 something to undo, and gone again once used. -->
            <ui:Button
                Grid.Row="3"
                Margin="0,12,0,0"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Icon="{ui:SymbolIcon ArrowUndo24}"
                Content="{Binding RevertLabel}"
                ToolTip="Puts every mod back the way it was before that list was applied. Usually just moves mods - nothing to download."
                Visibility="{Binding HasRevert, Converter={StaticResource BoolToVis}}"
                Command="{Binding RevertCommand}" />
        </Grid>

        <!-- Right: the selected list, and what applying it would do. -->
        <Grid Grid.Row="0" Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock
                Grid.Row="0"
                TextWrapping="Wrap"
                MaxWidth="520"
                HorizontalAlignment="Left"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Visibility="{Binding HasSelection, Converter={StaticResource FalseToVisible}}"
                Text="Pick a list on the left, or capture what you have installed now.&#10;&#10;A mod list records which mods to install and enable. Applying one downloads whatever is missing from sp-mod.com and sets aside anything the list doesn't name - it never deletes a mod." />

            <!-- Header: the name, then the two things you actually do, then the quieter rest. -->
            <StackPanel
                Grid.Row="0"
                Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:TextBox
                        Grid.Column="0"
                        FontSize="16"
                        IsEnabled="{Binding SelectionIsEditable}"
                        Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" />

                    <ui:Button
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        ToolTip="Rename this list"
                        Icon="{ui:SymbolIcon Rename24}"
                        Content="Rename"
                        Command="{Binding RenameCommand}" />
                </Grid>

                <TextBlock
                    Margin="2,10,0,0"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding SelectionDetail}" />

                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <ui:Button
                        MinWidth="110"
                        HorizontalContentAlignment="Center"
                        Content="Preview"
                        ToolTip="Work out what applying this list would do. Nothing moves and nothing downloads."
                        Command="{Binding PreviewCommand}" />

                    <ui:Button
                        MinWidth="110"
                        Margin="10,0,0,0"
                        HorizontalContentAlignment="Center"
                        Appearance="Primary"
                        Content="Apply"
                        ToolTip="Download what's missing, enable what the list names, and set aside what it doesn't."
                        Command="{Binding ApplyCommand}" />

                    <!-- Only while a plan is showing: the plan sits in the same cell as the list's
                         own contents, so this is how you get back to them. -->
                    <ui:Button
                        Margin="10,0,0,0"
                        Appearance="Transparent"
                        Icon="{ui:SymbolIcon ArrowLeft24}"
                        Content="Back to the mods"
                        ToolTip="Stop showing the plan and go back to what this list names. Changes nothing."
                        Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}"
                        Command="{Binding ClosePlanCommand}" />
                </StackPanel>

                <Separator
                    Margin="0,16,0,0"
                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Button
                        Appearance="Transparent"
                        Icon="{ui:SymbolIcon ArrowExportLtr24}"
                        Content="Export"
                        ToolTip="Save this list to a file you can send to someone. It carries which mods and versions - never the mod files themselves."
                        Command="{Binding ExportCommand}" />

                    <ui:Button
                        Margin="8,0,0,0"
                        Appearance="Transparent"
                        Icon="{ui:SymbolIcon Branch24}"
                        Content="Make a copy"
                        ToolTip="Imported lists are read-only. This starts your own copy of it."
                        Visibility="{Binding SelectionIsImported, Converter={StaticResource BoolToVis}}"
                        Command="{Binding ForkCommand}" />

                    <ui:Button
                        Margin="8,0,0,0"
                        Appearance="Transparent"
                        Icon="{ui:SymbolIcon ArrowUndo24}"
                        Content="Stop following"
                        ToolTip="Clears which list this install is following. Nothing on disk changes."
                        Visibility="{Binding SelectionIsActive, Converter={StaticResource BoolToVis}}"
                        Command="{Binding StopFollowingCommand}" />

                    <ui:Button
                        Margin="8,0,0,0"
                        Appearance="Transparent"
                        Content="Delete"
                        ToolTip="Removes the list. Nothing on disk changes."
                        Command="{Binding DeleteCommand}" />
                </StackPanel>
            </StackPanel>

            <ui:InfoBar
                Grid.Row="1"
                Margin="0,16,0,0"
                Severity="Warning"
                IsClosable="False"
                IsOpen="{Binding HasVersionWarning, Mode=OneWay}"
                Message="{Binding VersionWarning}" />

            <TextBlock
                Grid.Row="2"
                TextWrapping="Wrap"
                FontWeight="SemiBold"
                Margin="2,20,0,10"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}"
                Text="{Binding PlanSummary}" />

            <!--
                What the list names, and where mods are added to it or taken off it.

                Shares its cell with the plan below and swaps with it: previewing answers a
                different question, and stacking two long lists is the congestion this page was
                corrected for once already.

                Taking a mod off a list changes the list and nothing else. The mod stays installed
                and enabled; only applying an Exclusive list afterwards sets it aside.
            -->
            <ui:Card
                Grid.Row="3"
                Padding="4"
                Visibility="{Binding ShowContents, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="10,8,6,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            TextWrapping="Wrap"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding EntriesHeader}" />

                        <ui:Button
                            Grid.Column="1"
                            Icon="{ui:SymbolIcon Add24}"
                            Content="Add mods"
                            ToolTip="Put mods on this list - ones you have installed, or ones from sp-mod.com you haven't. Nothing is downloaded."
                            Visibility="{Binding SelectionIsEditable, Converter={StaticResource BoolToVis}}"
                            Command="{Binding AddModsCommand}" />
                    </Grid>

                    <TextBlock
                        Grid.Row="1"
                        TextWrapping="Wrap"
                        Margin="10,0,10,8"
                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                        Visibility="{Binding SelectionIsImported, Converter={StaticResource BoolToVis}}"
                        Text="This list came from someone else, so it stays exactly as they wrote it. Make a copy to change what's on it." />

                    <Grid Grid.Row="2">
                        <TextBlock
                            Margin="10,4,10,10"
                            TextWrapping="Wrap"
                            VerticalAlignment="Top"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Visibility="{Binding HasEntries, Converter={StaticResource FalseToVisible}}"
                            Text="This list names no mods yet. Add some, or capture what you have installed as a new list." />

                        <ListBox
                            x:Name="EntriesBox"
                            BorderThickness="0"
                            Background="Transparent"
                            ItemContainerStyle="{StaticResource ReadOnlyContainer}"
                            ItemsSource="{Binding Entries}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource HoverRow}" Padding="10,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                TextWrapping="Wrap"
                                                Margin="0,0,16,0"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Text="{Binding Name}" />

                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                Text="{Binding Detail}" />

                                            <ui:Button
                                                Grid.Column="2"
                                                Margin="12,0,0,0"
                                                Padding="8,4"
                                                Appearance="Transparent"
                                                Icon="{ui:SymbolIcon Dismiss24}"
                                                ToolTip="Take this mod off the list. It stays installed - nothing on disk changes."
                                                Visibility="{Binding DataContext.SelectionIsEditable, RelativeSource={RelativeSource AncestorType=Page}, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.RemoveEntryCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                                CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Grid>
            </ui:Card>

            <ui:Card
                Grid.Row="3"
                Padding="4"
                Visibility="{Binding HasPlan, Converter={StaticResource BoolToVis}}">
                <ListBox
                    x:Name="PlanBox"
                    BorderThickness="0"
                    Background="Transparent"
                    ItemContainerStyle="{StaticResource ReadOnlyContainer}"
                    ItemsSource="{Binding PlanRows}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource HoverRow}" Padding="10,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Kind}" />

                                <TextBlock
                                    Grid.Column="1"
                                    TextWrapping="Wrap"
                                    Margin="12,0,16,0"
                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                    Text="{Binding Name}" />

                                <TextBlock
                                    Grid.Column="2"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{Binding Detail}" />
                            </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </ui:Card>
        </Grid>

        <StackPanel
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Orientation="Horizontal"
            Margin="2,20,0,0">
            <ui:ProgressRing
                Width="16"
                Height="16"
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                IsIndeterminate="True"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <TextBlock
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding StatusMessage}" />
        </StackPanel>
    </Grid>
</Page>
