<UserControl
    x:Class="TCFModManager.App.Views.TourCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    Width="0"
    Height="0"
    Focusable="False">
    <Popup
        x:Name="Popup"
        AllowsTransparency="True"
        StaysOpen="True"
        Focusable="False"
        Placement="Custom">
        <Grid Margin="8,8,8,16">
            <Border
                Width="340"
                Padding="20,14,12,16"
                TextOptions.TextFormattingMode="Display"
                TextOptions.TextRenderingMode="ClearType"
                Style="{StaticResource FilterSidePanelSurface}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Direction="270" Opacity="0.135" ShadowDepth="10" Color="#202020" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock
                        x:Name="TitleText"
                        Margin="0,6,8,0"
                        VerticalAlignment="Top"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        TextWrapping="Wrap" />

                    <ui:Button
                        Grid.Column="1"
                        Padding="6"
                        VerticalAlignment="Top"
                        Appearance="Transparent"
                        Click="Close_Click"
                        Icon="{ui:SymbolIcon Dismiss24}"
                        ToolTip="{loc:Str Tour_Close}" />

                    <TextBlock
                        x:Name="BodyText"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="0,10,8,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap" />

                    <DockPanel
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Margin="0,20,0,0"
                        LastChildFill="False">
                        <TextBlock
                            x:Name="CountText"
                            DockPanel.Dock="Left"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}" />

                        <ui:Button
                            x:Name="NextButton"
                            DockPanel.Dock="Right"
                            Margin="8,0,0,0"
                            Appearance="Primary"
                            Click="Next_Click" />
                        <ui:Button
                            x:Name="BackButton"
                            DockPanel.Dock="Right"
                            Margin="8,0,0,0"
                            Click="Back_Click"
                            Content="{loc:Str Tour_Back}" />
                        <ui:Button
                            x:Name="SkipButton"
                            DockPanel.Dock="Right"
                            Appearance="Transparent"
                            Click="Skip_Click"
                            Content="{loc:Str Tour_Skip}" />
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Popup>
</UserControl>
