<Page
    x:Class="TCFModManager.App.Views.WebPagesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    xmlns:behaviors="clr-namespace:TCFModManager.App.Behaviors"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    Title="{loc:Str Nav_WebPages}"
    Loaded="WebPagesPage_Loaded"
    Unloaded="WebPagesPage_Unloaded"
    ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <converters:FalseToVisibilityConverter x:Key="FalseToVisible" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid
        x:Name="RootGrid"
        Margin="20"
        Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <ui:Button
                DockPanel.Dock="Left"
                Appearance="Primary"
                Icon="{ui:SymbolIcon ArrowSync24}"
                behaviors:TourTarget.Key="webpages.rescan"
                Content="{loc:Str Common_Rescan}"
                behaviors:PageKeys.Role="Refresh"
                Command="{Binding RescanCommand}" />

            <TextBlock
                DockPanel.Dock="Left"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis"
                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                Text="{Binding ServerStoppedLine}"
                Visibility="{Binding IsServerRunning, Converter={StaticResource FalseToVisible}}" />
        </DockPanel>

        <ui:Card Grid.Row="1" Margin="0,16,0,0" Padding="16" behaviors:TourTarget.Key="webpages.intro">
            <TextBlock
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{loc:Str WebPages_Intro}" />
        </ui:Card>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock
                Margin="4,8,0,0"
                TextWrapping="Wrap"
                VerticalAlignment="Top"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{loc:Str WebPages_Empty}"
                Visibility="{Binding HasRows, Converter={StaticResource FalseToVisible}}" />

            <ScrollViewer
                behaviors:TourTarget.Key="webpages.rows"
                Focusable="False"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}">
                <ItemsControl Margin="0,0,14,0" Focusable="False" ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:Card Margin="0,0,0,8" Padding="16,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding Title}" />
                                        <TextBlock
                                            Margin="0,3,0,0"
                                            TextWrapping="Wrap"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Description}"
                                            Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock
                                            Margin="0,3,0,0"
                                            FontSize="12"
                                            TextTrimming="CharacterEllipsis"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{Binding Url}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button
                                            Appearance="Secondary"
                                            Icon="{ui:SymbolIcon Copy24}"
                                            Content="{loc:Str WebPages_CopyAddress}"
                                            Command="{Binding DataContext.CopyAddressCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}" />
                                        <ui:Button
                                            Margin="8,0,0,0"
                                            Appearance="Primary"
                                            Icon="{ui:SymbolIcon Open24}"
                                            Content="{loc:Str WebPages_Open}"
                                            ToolTip="{loc:Str WebPages_OpenToolTip}"
                                            ToolTipService.ShowOnDisabled="True"
                                            Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </ui:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
