<!-- ScrollViewer.CanContentScroll="False" opts this page out of WPF-UI's automatic outer
     DynamicScrollViewer: the list below scrolls itself, and the wrapper only fights it.
     Background="Transparent" on the root Grid is the other half - a Grid with no Background only
     takes part in hit-testing where a child paints.

     Every TextBlock sets its Foreground from a DynamicResource brush. A plain ListBox's default
     template hands its items the system control foreground - black - so anything inheriting inside
     one is unreadable in dark mode. Secondary/Tertiary carry the de-emphasis rather than Opacity. -->
<Page
    x:Class="TCFModManager.App.Views.PerformancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    Title="Performance"
    Loaded="PerformancePage_Loaded"
    ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <converters:FootprintLevelToAppearanceConverter x:Key="LevelAppearance" />
        <converters:FalseToVisibilityConverter x:Key="FalseToVisible" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--
            The container contributes nothing - no padding, margin or fill - so the row Border in
            the template draws the whole thing, the same arrangement ConfigsPage and ModListsPage
            use. Left to itself the stock container shows a grey edge and hands its content the
            system control foreground, which is black whatever the theme is.
        -->
        <Style x:Key="BareContainer" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Page.Resources>

    <Grid
        x:Name="RootGrid"
        Margin="20"
        Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <ui:Button
                DockPanel.Dock="Left"
                Appearance="Primary"
                Icon="{ui:SymbolIcon ArrowSync24}"
                Content="Rescan"
                IsEnabled="{Binding IsIdle}"
                Command="{Binding RescanCommand}" />

            <ui:ProgressRing
                DockPanel.Dock="Left"
                Width="20"
                Height="20"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                IsIndeterminate="True"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <TextBlock
                DockPanel.Dock="Left"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding Status}" />

            <ComboBox
                DockPanel.Dock="Right"
                MinWidth="220"
                ItemsSource="{Binding SortOptions}"
                SelectedItem="{Binding SelectedSort}" />

            <TextBlock
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Sort by" />
        </DockPanel>

        <!--
            The caveat is part of the feature, not decoration. Everything on this page is read from
            what a mod ships on disk, and a user who reads these levels as measured frame cost has
            been misled by the page rather than by the numbers.
        -->
        <ui:Card Grid.Row="1" Margin="0,16,0,0" Padding="16">
            <StackPanel>
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="What this reads" />
                <TextBlock
                    Margin="0,4,0,0"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Each mod is read from the files it installs - how much of the game it patches, how many components it runs every frame, and what it puts on disk. That says how much a mod is positioned to affect the game. It is not a measurement of frame rate, and a Heavy mod is not necessarily one that costs you anything." />
            </StackPanel>
        </ui:Card>

        <ui:Card Grid.Row="2" Margin="0,16,0,0" Padding="4">
            <Grid>
                <TextBlock
                    Margin="12"
                    TextWrapping="Wrap"
                    VerticalAlignment="Top"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Nothing to show yet."
                    Visibility="{Binding HasRows, Converter={StaticResource FalseToVisible}}" />

                <ListBox
                    x:Name="RowsBox"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding Rows}"
                    ItemContainerStyle="{StaticResource BareContainer}"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource HoverRow}" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding Title}" />

                                        <TextBlock
                                            Margin="0,3,0,0"
                                            TextTrimming="CharacterEllipsis"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Detail}"
                                            ToolTip="{Binding PerFrameTooltip}" />

                                        <TextBlock
                                            Margin="0,3,0,0"
                                            TextWrapping="Wrap"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{Binding Notes}"
                                            Visibility="{Binding HasNotes, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>

                                    <ui:Badge
                                        Grid.Column="1"
                                        VerticalAlignment="Top"
                                        FontSize="11"
                                        Appearance="{Binding Level, Converter={StaticResource LevelAppearance}}"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Content="{Binding LevelText}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </ui:Card>
    </Grid>
</Page>
