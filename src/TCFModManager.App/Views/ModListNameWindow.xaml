<ui:FluentWindow
    x:Class="TCFModManager.App.Views.ModListNameWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    Width="440"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    ExtendsContentIntoTitleBar="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="WindowTitleBar"
            Grid.Row="0" />

        <StackPanel
            Grid.Row="1"
            Margin="24,12,24,24">
            <TextBlock
                x:Name="DescriptionText"
                Margin="0,0,0,12"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <ui:TextBox
                x:Name="NameBox"
                PlaceholderText="{loc:Str ModLists_NamePlaceholder}"
                TextChanged="NameBox_TextChanged" />

            <StackPanel
                Margin="0,16,0,0"
                Orientation="Horizontal"
                HorizontalAlignment="Right">
                <ui:Button
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Content="{loc:Str Common_Cancel}" />

                <ui:Button
                    x:Name="CaptureButton"
                    IsDefault="True"
                    IsEnabled="False"
                    Appearance="Primary"
                    Click="CaptureButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
