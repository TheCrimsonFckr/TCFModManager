<Page
    x:Class="TCFModManager.App.Views.AppUpdatePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:behaviors="clr-namespace:TCFModManager.App.Behaviors"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    Title="App update"
    ScrollViewer.CanContentScroll="False">
    <!--
        ScrollViewer.CanContentScroll="False" on the Page itself opts this page out of WPF-UI's
        automatic outer DynamicScrollViewer (NavigationViewContentPresenter overrides the default
        for every Page in the app), leaving the ScrollViewer below as the only scrolling container.
        Same reason InstalledPage and DependenciesPage set it.
    -->
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToCollapsed" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">

            <!-- Where this comes from. Stated up front rather than buried, because "an app that
                 updates itself" is worth being unambiguous about. -->
            <ui:InfoBar
                IsOpen="True"
                IsClosable="False"
                Severity="Informational"
                Title="Updates come from sp-mod.com"
                Message="This app has its own mod page on sp-mod.com, the same as everything else you install through it. Updates are read from that listing through the public API, and the file downloaded is the one the page's own Download button serves. As with any other mod, the page is opened before anything is downloaded - nothing here works around sp-mod.com or its authors." />

            <ui:Card Padding="16" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock
                        Text="Version"
                        FontWeight="SemiBold"
                        Margin="0,0,0,8" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <TextBlock Opacity="0.7" Text="Installed: " />
                        <TextBlock FontWeight="SemiBold" Text="{Binding CurrentVersion, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel
                        Orientation="Horizontal"
                        Margin="0,0,0,4"
                        Visibility="{Binding LatestVersion, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock Opacity="0.7" Text="Latest on sp-mod.com: " />
                        <TextBlock FontWeight="SemiBold" Text="{Binding LatestVersion, Mode=OneWay}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ui:Button
                            Content="Check now"
                            Icon="{ui:SymbolIcon ArrowSync24}"
                            Command="{Binding CheckForUpdatesCommand}" />
                        <ui:ProgressRing
                            Width="20"
                            Height="20"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            IsIndeterminate="True"
                            Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <ui:InfoBar
                        Margin="0,12,0,0"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Error"
                        Title="Couldn't check for updates"
                        Message="{Binding CheckError}"
                        Visibility="{Binding CheckError, Converter={StaticResource NullToCollapsed}}" />

                    <!-- ShowUpToDate, not !UpdateAvailable: a page that hasn't checked yet, or whose
                         check failed, must not claim the app is up to date. -->
                    <TextBlock
                        Margin="0,12,0,0"
                        Opacity="0.7"
                        TextWrapping="Wrap"
                        Text="You're on the newest version published on sp-mod.com."
                        Visibility="{Binding ShowUpToDate, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </ui:Card>

            <!-- Everything below only exists when there's actually something newer. -->
            <StackPanel Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVis}}">

                <ui:Card Padding="16" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock
                            Text="{Binding ChangeTitle}"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Margin="0,0,0,6" />

                        <TextBlock
                            TextWrapping="Wrap"
                            Opacity="0.85"
                            Margin="0,0,0,10"
                            Text="{Binding ChangeSummary}" />

                        <!-- The version-numbering key, spelled out so the summary above lands even
                             for someone who's never thought about what the three numbers mean. -->
                        <Border
                            CornerRadius="4"
                            Padding="12"
                            Margin="0,0,0,12"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock
                                    Opacity="0.7"
                                    FontSize="11"
                                    Margin="0,0,0,6"
                                    Text="HOW TO READ THE VERSION NUMBER" />
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,3">
                                    <Run FontWeight="SemiBold" Text="x.x.CHANGE" />
                                    <Run Text=" - bug fix. Fixes to what's already there. Safe to skip." />
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap" Margin="0,0,0,3">
                                    <Run FontWeight="SemiBold" Text="x.CHANGE.x" />
                                    <Run Text=" - feature update. Something new, or something works differently." />
                                </TextBlock>
                                <TextBlock TextWrapping="Wrap">
                                    <Run FontWeight="SemiBold" Text="CHANGE.x.x" />
                                    <Run Text=" - major update. Significant changes; read the notes first." />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock
                                Opacity="0.6"
                                FontSize="12"
                                Text="{Binding PublishedText}"
                                Visibility="{Binding PublishedText, Converter={StaticResource NullToCollapsed}}" />
                            <TextBlock
                                Opacity="0.6"
                                FontSize="12"
                                Margin="12,0,0,0"
                                Text="{Binding DownloadSizeText}"
                                Visibility="{Binding DownloadSizeText, Converter={StaticResource NullToCollapsed}}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <ui:Button
                                Content="Open the mod page"
                                Icon="{ui:SymbolIcon Open24}"
                                Command="{Binding OpenModPageCommand}" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Appearance="Primary"
                                Content="Download and install"
                                Icon="{ui:SymbolIcon ArrowDownload24}"
                                Command="{Binding InstallUpdateCommand}" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Content="Cancel"
                                Command="{Binding CancelInstallCommand}"
                                Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>

                        <TextBlock
                            Margin="0,8,0,0"
                            Opacity="0.6"
                            FontSize="12"
                            TextWrapping="Wrap"
                            Text="You'll be asked to open the mod page first. The app then downloads the release, closes itself, swaps in the new version and reopens. Your settings, install history and staged downloads are left alone." />

                        <StackPanel
                            Margin="0,12,0,0"
                            Visibility="{Binding IsInstalling, Converter={StaticResource BoolToVis}}">
                            <TextBlock
                                Margin="0,0,0,6"
                                Opacity="0.8"
                                Text="{Binding InstallStatus}" />
                            <ProgressBar
                                Height="6"
                                Minimum="0"
                                Maximum="100"
                                Value="{Binding InstallProgress, Mode=OneWay}" />
                        </StackPanel>

                        <ui:InfoBar
                            Margin="0,12,0,0"
                            IsOpen="True"
                            IsClosable="False"
                            Severity="Error"
                            Title="Update not applied"
                            Message="{Binding InstallError}"
                            Visibility="{Binding InstallError, Converter={StaticResource NullToCollapsed}}" />
                    </StackPanel>
                </ui:Card>

                <ui:Card
                    Padding="16"
                    Margin="0,16,0,0"
                    Visibility="{Binding Changelog, Converter={StaticResource NullToCollapsed}}">
                    <StackPanel>
                        <TextBlock
                            Text="What's new"
                            FontWeight="SemiBold"
                            Margin="0,0,0,8" />
                        <!-- Same renderer the mod update dialog uses for a version's release notes. -->
                        <RichTextBox
                            Padding="0"
                            BorderThickness="0"
                            Background="Transparent"
                            IsReadOnly="True"
                            IsDocumentEnabled="True"
                            Focusable="False"
                            VerticalScrollBarVisibility="Disabled"
                            HorizontalScrollBarVisibility="Disabled"
                            behaviors:HtmlText.Html="{Binding Changelog}" />
                    </StackPanel>
                </ui:Card>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
