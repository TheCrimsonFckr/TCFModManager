<ui:FluentWindow
    x:Class="TCFModManager.App.Views.DataFilesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    Title="Data files"
    Height="700"
    Width="900"
    MinHeight="400"
    MinWidth="600"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True">
    <!--
        Raw view/edit window over the JSON files this app keeps under Data\ (installed-mods.json,
        settings.json, etc.) - for hand-fixing something the built-in pages don't cover. Every save
        is validated as JSON first and the previous version is kept as "<file>.bak".
    -->
    <Window.Resources>
        <converters:NullToVisibilityConverter x:Key="NullToCollapsed" />
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Data files" />

        <Grid Grid.Row="1" Margin="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                <TextBlock Text="Data\ files" FontWeight="SemiBold" Margin="0,0,0,8" />
                <ListBox
                    ItemsSource="{Binding Files}"
                    SelectedItem="{Binding SelectedFile}" />
            </StackPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,8">
                    <ui:Button
                        DockPanel.Dock="Right"
                        Content="Save"
                        Icon="{ui:SymbolIcon Save24}"
                        Command="{Binding SaveCommand}" />
                    <ui:Button
                        DockPanel.Dock="Right"
                        Margin="0,0,8,0"
                        Content="Reload"
                        Icon="{ui:SymbolIcon ArrowClockwise24}"
                        Command="{Binding ReloadCommand}"
                        ToolTip="Discard unsaved edits and reread this file from disk" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Text="{Binding SelectedFile}"
                        FontWeight="SemiBold" />
                </DockPanel>

                <Border
                    Grid.Row="1"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}">
                    <ui:TextBox
                        Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                        FontFamily="Consolas"
                        AcceptsReturn="True"
                        AcceptsTab="True"
                        TextWrapping="NoWrap"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Auto"
                        BorderThickness="0" />
                </Border>

                <TextBlock
                    Grid.Row="2"
                    Margin="0,8,0,0"
                    TextWrapping="Wrap"
                    Text="{Binding StatusMessage}"
                    Style="{StaticResource ErrorText}"
                    Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}" />
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
