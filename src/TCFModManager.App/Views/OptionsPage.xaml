<Page
    x:Class="TCFModManager.App.Views.OptionsPage"
    Loaded="Page_Loaded"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    Title="Options">
    <Page.Resources>
        <controls:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:FalseToVisibilityConverter x:Key="FalseToVisible" />
    </Page.Resources>
    <StackPanel Margin="16">
        <ui:Card Padding="16" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock
                    Text="SPT Install Folder"
                    FontWeight="SemiBold"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="Point this at your SPT server install folder (the one containing SPT.Server.exe). Once set, the installed SPT version is used to default the Browse version filter and to flag mods that aren't built for it." />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:TextBox
                        Width="440"
                        Text="{Binding InstallPathInput, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Content="Browse..."
                        Command="{Binding BrowseCommand}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Content="Save"
                        Command="{Binding SaveCommand}" />
                </StackPanel>

                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding SptEnvironment.StatusMessage}" />
            </StackPanel>
        </ui:Card>

        <!--
            Sits directly under the install folder because it is a fact about that folder's machine,
            and because setting the folder is what puts the question in the first place - this app
            has no first-run wizard, so that is its setup step.

            Always shown, not gated on finding a launcher. Someone who answered "ask me later", or
            whose headless is started some other way, needs somewhere to say so, and a card that
            appears and disappears is one nobody can rely on finding.
        -->
        <ui:Card Padding="16" VerticalAlignment="Top" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock
                    Text="What this machine is"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="A Fika headless client hosts raids without anybody playing on it, so it needs the mods that decide how a raid goes - bots, items, locations - and none of the ones that draw things at a player. Saying which this machine is lets a mod list a server hands you arrive trimmed to what this machine actually needs. It never changes a list of your own, and it never affects what you can install by hand." />

                <ui:ToggleSwitch
                    HorizontalAlignment="Left"
                    Margin="0,0,0,8"
                    ToolTip="Turn this off for a dedicated headless box - one that hosts raids and that nobody sits at."
                    ToolTipService.ShowDuration="20000"
                    IsChecked="{Binding PlaysHere}"
                    OnContent="Somebody plays on this machine"
                    OffContent="Nobody plays on this machine" />

                <ui:ToggleSwitch
                    HorizontalAlignment="Left"
                    Margin="0,0,0,8"
                    ToolTip="Detected from the Fika headless launcher in the install folder, and overridable here for a setup that starts its headless some other way."
                    ToolTipService.ShowDuration="20000"
                    IsChecked="{Binding RunsHeadlessClient}"
                    OnContent="This machine runs a Fika headless client"
                    OffContent="This machine does not run a headless client" />

                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,4,0,0"
                    Text="{Binding InstallRoleDescription}" />

                <!--
                    Only worth saying when the two disagree with the folder. A machine claiming to
                    run a headless with no launcher in sight is worth mentioning, never preventing -
                    plenty of ways exist to start one.
                -->
                <TextBlock
                    FontSize="11"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,8,0,0"
                    Text="No Fika headless launcher was found in the install folder, so nothing here starts one - the switch above still decides which mods a served list brings."
                    Visibility="{Binding HasHeadlessLauncher, Converter={StaticResource FalseToVisible}}" />
            </StackPanel>
        </ui:Card>

        <ui:Card Padding="16" VerticalAlignment="Top" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock
                    Text="Appearance"
                    FontWeight="SemiBold"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="Follow system matches Windows and keeps matching it when you change it there. Light and Dark pin the app to one regardless." />
                <ComboBox
                    Width="200"
                    HorizontalAlignment="Left"
                    ItemsSource="{Binding ThemeOptions}"
                    SelectedItem="{Binding SelectedTheme}" />
            </StackPanel>
        </ui:Card>

        <ui:Card Padding="16" VerticalAlignment="Top" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock
                    Text="Window"
                    FontWeight="SemiBold"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="How the window opens. Remembering the last size and position is the default, since dragging the window to a size and leaving it there is already an answer. Full screen fills the whole monitor with no title bar and covers the taskbar, which maximised does not - F11 switches into and out of it at any time, whichever of these is chosen." />
                <ComboBox
                    Width="320"
                    HorizontalAlignment="Left"
                    ItemsSource="{Binding WindowStartupOptions}"
                    SelectedItem="{Binding SelectedWindowStartup}" />

                <!-- Only shown for the one mode that reads them - two size boxes sitting under
                     "Always start maximised" would look like they still did something. -->
                <StackPanel
                    Margin="0,12,0,0"
                    Visibility="{Binding ShowCustomSize, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:TextBox
                            Width="110"
                            PlaceholderText="Width"
                            Text="{Binding CustomWidthInput, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock
                            Margin="8,0,8,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="x" />
                        <ui:TextBox
                            Width="110"
                            PlaceholderText="Height"
                            Text="{Binding CustomHeightInput, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Content="Apply"
                            Command="{Binding ApplyWindowSizeCommand}" />

                        <!-- Dragging the window to the size you want and pressing one button beats
                             guessing two numbers. -->
                        <ui:Button
                            Margin="8,0,0,0"
                            Content="Use the current size"
                            ToolTip="Fills these boxes from the window as it is right now. Restore it down from maximised first - a maximised window has no chosen size to read."
                            Command="{Binding UseCurrentWindowSizeCommand}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock
                    Margin="0,8,0,0"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding WindowSizeMessage}" />
            </StackPanel>
        </ui:Card>

        <ui:Card Padding="16" VerticalAlignment="Top" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock
                    Text="Page defaults"
                    FontWeight="SemiBold"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="The Installed and Browse pages each have a Save as default button beside Clear filters. It opens that page with the filters, sort, per-page - and on Installed, the view - it is set to at the time, so a page you always narrow the same way arrives narrowed. What you have typed in the search box is never part of it. Clearing a default here puts the page back to the app's own." />

                <TextBlock
                    TextWrapping="Wrap"
                    Margin="0,0,0,4"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding InstalledDefaultsDescription}" />
                <TextBlock
                    TextWrapping="Wrap"
                    Margin="0,0,0,8"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding BrowseDefaultsDescription}" />

                <StackPanel Orientation="Horizontal">
                    <ui:Button
                        Content="Clear the Installed default"
                        Command="{Binding ResetInstalledDefaultsCommand}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Content="Clear the Browse default"
                        Command="{Binding ResetBrowseDefaultsCommand}" />
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <ui:Card Padding="16" VerticalAlignment="Top" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock
                    Text="Mod pages"
                    FontWeight="SemiBold"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="Before anything downloads, this app asks you to open the mod's page - where its author puts install steps, requirements, known conflicts and warnings. Turn that off if you would rather go straight to installing. This app's own updates always ask, since that page is where its release notes are." />
                <ui:ToggleSwitch
                    HorizontalAlignment="Left"
                    ToolTip="{Binding ModPageGate.SettingToolTip}"
                    ToolTipService.ShowDuration="20000"
                    IsChecked="{Binding SkipModPageConfirmation}"
                    OnContent="Off - install without opening mod pages"
                    OffContent="On - open each mod's page first" />
            </StackPanel>
        </ui:Card>

        <ui:Card Padding="16" VerticalAlignment="Top" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock
                    Text="Mod footprint page"
                    FontWeight="SemiBold"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="Adds a page that reads the files each installed mod ships and describes how much of the game it is positioned to touch, and where any cost would land - client or server, CPU, GPU, memory or start-up. Nothing on it is timed or measured: what a mod actually costs you depends on your hardware, your settings and the other mods you run, none of which it can see. A heavy footprint means a mod reaches a long way into the game, which is usually why you installed it - it is a place to start looking, not a verdict. Off by default." />
                <ui:ToggleSwitch
                    HorizontalAlignment="Left"
                    ToolTip="{Binding FootprintGate.SettingToolTip}"
                    ToolTipService.ShowDuration="20000"
                    IsChecked="{Binding ShowModFootprintPage}"
                    OnContent="On - shown in the sidebar"
                    OffContent="Off - hidden" />
            </StackPanel>
        </ui:Card>

        <!--
            Server Map. The switch shows or hides the page, the same as Mod footprint above; the
            rest of the section is the connection the page uses, kept here because setting the
            address up is a one-off and the page itself is for reading.

            The address is asked for rather than derived from the install folder. On any Fika setup
            the install's own http.json is stale - Fika overrides the binding at runtime from
            fika.jsonc, and writes 0.0.0.0 there, which is a bind address and not one a client can
            dial. The address the user already types into the SPT launcher is the honest source.
        -->
        <ui:Card Padding="16" VerticalAlignment="Top" Margin="0,16,0,0">
            <StackPanel DataContext="{Binding ServerMap}">
                <TextBlock
                    Text="Server map"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="Adds a page that connects to an SPT server running the Server Map mod, so you can see what it runs and compare it against what you have installed. The mod goes on the server, not here - without it this page has nothing to show, which is why it is off by default. Use the same address and port you put in the SPT launcher; connecting sends nothing about your install, it only asks the server who it is." />

                <ui:ToggleSwitch
                    HorizontalAlignment="Left"
                    Margin="0,0,0,12"
                    ToolTip="{Binding SettingToolTip}"
                    ToolTipService.ShowDuration="20000"
                    IsChecked="{Binding IsPageEnabled}"
                    OnContent="On - shown in the sidebar"
                    OffContent="Off - hidden" />

                <!-- The server half is an addon rather than something bundled here: it is installed
                     on a different machine, by whoever runs the server. Hidden until the page URL
                     is set, so a build without one never shows a dead link. -->
                <StackPanel
                    Margin="0,0,0,12"
                    Visibility="{Binding HasAddonPage, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        TextWrapping="Wrap"
                        Margin="0,0,0,8"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Running a server? The Server Map mod is a separate download - get it from the mod's page and install it on the machine running SPT. Players joining that server need nothing but this switch." />
                    <ui:Button
                        HorizontalAlignment="Left"
                        Content="Get the Server Map mod"
                        Icon="{ui:SymbolIcon Open24}"
                        ToolTip="Opens the Server Map mod's page on sp-mod.com in your browser."
                        Command="{Binding OpenAddonPageCommand}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <!-- The placeholder is a hint, not a default. Fika's own default is 127.0.0.1,
                         which is right for a server on this machine and quietly wrong for anyone
                         connecting to someone else's - so it is shown rather than filled in. -->
                    <ui:TextBox
                        Width="300"
                        PlaceholderText="Server address (e.g. 127.0.0.1)"
                        Text="{Binding HostInput, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:TextBox
                        Width="90"
                        Margin="8,0,0,0"
                        PlaceholderText="Port"
                        Text="{Binding PortInput, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Content="Connect"
                        Icon="{ui:SymbolIcon Connected20}"
                        Command="{Binding ConnectCommand}" />
                    <ProgressBar
                        Width="80"
                        Height="4"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        IsIndeterminate="True"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- The key the operator hands out with the address. A plain TextBox, not a
                     PasswordBox: it is not a secret about the person holding it, it gets copied
                     between machines and pasted into chat, and hiding it would only make it harder
                     to check against what you were sent. -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:TextBox
                        Width="300"
                        PlaceholderText="Shared key (if the server needs one)"
                        Text="{Binding KeyInput, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Margin="0,0,0,8"
                    Text="{Binding KeyDescription}" />

                <!-- Only on the machine actually running a server. Shown in full rather than
                     shortened: the whole purpose is to be copied out and sent to somebody, and
                     anyone who can see this window can already open the file it came from. -->
                <StackPanel
                    Margin="0,0,0,8"
                    Visibility="{Binding IsServerOwner, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        IsHitTestVisible="True"
                        Text="{Binding LocalKeyDescription}" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ui:Button
                            HorizontalAlignment="Left"
                            Content="Use this machine's key"
                            Icon="{ui:SymbolIcon Key24}"
                            Command="{Binding UseLocalKeyCommand}" />

                        <!-- Deliberate and destructive, so it is a button and never automatic:
                             every copy of the old key stops working the moment this is pressed. -->
                        <ui:Button
                            Margin="8,0,0,0"
                            HorizontalAlignment="Left"
                            Content="Generate a new key"
                            Icon="{ui:SymbolIcon ArrowSync24}"
                            ToolTip="Replaces this server's key with a new one. Everyone using the old key stops being able to see what this server publishes until you send them the new one. The server picks it up without being restarted."
                            Command="{Binding NewLocalKeyCommand}" />
                    </StackPanel>

                    <TextBlock
                        TextWrapping="Wrap"
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Visibility="{Binding HasKeyNotice, Converter={StaticResource BoolToVisibility}}"
                        Text="{Binding KeyNotice}" />
                </StackPanel>

                <!-- Named to match the shared ErrorText style, which turns this red only when the
                     last attempt actually failed. -->
                <TextBlock
                    TextWrapping="Wrap"
                    Style="{StaticResource ErrorText}"
                    Text="{Binding StatusMessage}" />

                <!-- The one failure the user has to judge rather than just read. Both fingerprints
                     are in the message above; this is the answer to it, and it is not offered for
                     any other kind of failure. -->
                <ui:Button
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    Appearance="Caution"
                    Content="Trust the new certificate"
                    Icon="{ui:SymbolIcon Certificate24}"
                    Command="{Binding TrustNewCertificateCommand}"
                    Visibility="{Binding HasCertificateChanged, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock
                    Margin="0,12,0,0"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding PinDescription}" />

                <ui:Button
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    Content="Forget this certificate"
                    Icon="{ui:SymbolIcon Delete24}"
                    ToolTip="Clears the recorded fingerprint. The next connection records whatever the server presents, the same as the first one did."
                    Command="{Binding ForgetPinCommand}" />
            </StackPanel>
        </ui:Card>

        <ui:Card Padding="16" VerticalAlignment="Top" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock
                    Text="Data files"
                    FontWeight="SemiBold"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="View or hand-edit the JSON files this app keeps under Data\, including installed-mods.json - useful when the Installed page's own version controls aren't enough." />
                <ui:Button
                    HorizontalAlignment="Left"
                    Content="Data files..."
                    Click="DataFiles_Click" />
            </StackPanel>
        </ui:Card>
    </StackPanel>
</Page>
