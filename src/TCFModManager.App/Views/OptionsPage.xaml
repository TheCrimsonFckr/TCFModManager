<Page
    x:Class="TCFModManager.App.Views.OptionsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Options">
    <StackPanel Margin="16">
        <ui:Card Padding="16" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock
                    Text="SPT Install Folder"
                    FontWeight="SemiBold"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Opacity="0.7"
                    Margin="0,0,0,8"
                    Text="Point this at your SPT server install folder (the one containing SPT.Server.exe). Once set, the installed SPT version is used to default the Browse version filter and to flag mods that aren't built for it." />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:TextBox
                        Width="440"
                        Text="{Binding InstallPathInput, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Content="Browse..."
                        Command="{Binding BrowseCommand}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Content="Save"
                        Command="{Binding SaveCommand}" />
                </StackPanel>

                <TextBlock
                    TextWrapping="Wrap"
                    Opacity="0.7"
                    Text="{Binding SptEnvironment.StatusMessage}" />
            </StackPanel>
        </ui:Card>

        <ui:Card Padding="16" VerticalAlignment="Top" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock
                    Text="Appearance"
                    FontWeight="SemiBold"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Opacity="0.7"
                    Margin="0,0,0,8"
                    Text="Follow system matches Windows and keeps matching it when you change it there. Light and Dark pin the app to one regardless." />
                <ComboBox
                    Width="200"
                    HorizontalAlignment="Left"
                    ItemsSource="{Binding ThemeOptions}"
                    SelectedItem="{Binding SelectedTheme}" />
            </StackPanel>
        </ui:Card>

        <ui:Card Padding="16" VerticalAlignment="Top" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock
                    Text="Mod pages"
                    FontWeight="SemiBold"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Opacity="0.7"
                    Margin="0,0,0,8"
                    Text="Before anything downloads, this app asks you to open the mod's page - where its author puts install steps, requirements, known conflicts and warnings. Turn that off if you would rather go straight to installing." />
                <ui:ToggleSwitch
                    HorizontalAlignment="Left"
                    IsChecked="{Binding SkipModPageConfirmation}"
                    OnContent="Off - install without opening mod pages"
                    OffContent="On - open each mod's page first" />
            </StackPanel>
        </ui:Card>

        <ui:Card Padding="16" VerticalAlignment="Top" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock
                    Text="Data files"
                    FontWeight="SemiBold"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Opacity="0.7"
                    Margin="0,0,0,8"
                    Text="View or hand-edit the JSON files this app keeps under Data\, including installed-mods.json - useful when the Installed page's own version controls aren't enough." />
                <ui:Button
                    HorizontalAlignment="Left"
                    Content="Data files..."
                    Click="DataFiles_Click" />
            </StackPanel>
        </ui:Card>
    </StackPanel>
</Page>
