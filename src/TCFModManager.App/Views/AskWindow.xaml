<ui:FluentWindow
    x:Class="TCFModManager.App.Views.AskWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:TCFModManager.App.Views"
    Width="520"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    ExtendsContentIntoTitleBar="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">
    <ui:FluentWindow.Resources>
        <Style x:Key="AskText" TargetType="TextBlock" BasedOn="{StaticResource DialogText}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="WindowTitleBar" Grid.Row="0" />

        <ScrollViewer
            Grid.Row="1"
            MaxHeight="480"
            Margin="24,12,24,0"
            VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid x:Name="WarningRow" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon
                        Grid.Column="0"
                        Margin="0,0,10,0"
                        VerticalAlignment="Top"
                        FontSize="20"
                        Symbol="Warning24"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                    <TextBlock
                        x:Name="WarningText"
                        Grid.Column="1"
                        Style="{StaticResource AskText}"
                        FontWeight="SemiBold" />
                </Grid>

                <TextBlock
                    x:Name="LeadText"
                    Style="{StaticResource AskText}" />

                <ItemsControl x:Name="SectionList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:AskSection}">
                            <StackPanel Margin="0,12,0,0">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Heading}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource AskText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Heading}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <ItemsControl
                                    Margin="8,4,0,0"
                                    Focusable="False"
                                    ItemsSource="{Binding Shown}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1,0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse
                                                    Grid.Column="0"
                                                    Width="5"
                                                    Height="5"
                                                    Margin="0,8,10,0"
                                                    VerticalAlignment="Top"
                                                    Fill="{DynamicResource TextFillColorSecondaryBrush}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Style="{StaticResource AskText}"
                                                    Text="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl x:Name="DetailList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Style="{StaticResource AskText}"
                                Margin="0,12,0,0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock
                    x:Name="FootnoteText"
                    FontSize="11"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>

        <WrapPanel Grid.Row="2" Style="{StaticResource DialogButtonBar}">
            <ui:Button x:Name="CancelButton" Style="{StaticResource DialogButton}" />
            <ui:Button x:Name="SecondButton" Style="{StaticResource DialogButton}" />
            <ui:Button x:Name="FirstButton" Style="{StaticResource DialogButton}" />
        </WrapPanel>
    </Grid>
</ui:FluentWindow>
