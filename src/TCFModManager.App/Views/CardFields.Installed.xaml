<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    xmlns:viewmodels="clr-namespace:TCFModManager.App.ViewModels"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    xmlns:behaviors="clr-namespace:TCFModManager.App.Behaviors"
    xmlns:controls="clr-namespace:TCFModManager.App.Controls"
    xmlns:app="clr-namespace:TCFModManager.App">

    <converters:NullToVisibilityConverter x:Key="CardNullToCollapsed" />
    <converters:FalseToVisibilityConverter x:Key="CardFalseToVisible" />
    <converters:PictureWhenShownConverter x:Key="CardPictureWhenShown" />
    <BooleanToVisibilityConverter x:Key="CardBoolToVis" />

    <sys:Double x:Key="CardTitleFontSize">14</sys:Double>
    <sys:Double x:Key="CardLineFontSize">11</sys:Double>
    <sys:Double x:Key="CardChipFontSize">11</sys:Double>
    <Thickness x:Key="CardLineMargin">0</Thickness>
    <Thickness x:Key="CardChipRowMargin">0,4,0,0</Thickness>
    <sys:Double x:Key="CardSmallPictureSize">48</sys:Double>
    <sys:Double x:Key="CardBannerHeight">90</sys:Double>

    <Style x:Key="ModChip" TargetType="Border">
        <Setter Property="Margin" Value="0,2,4,0" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="CornerRadius" Value="{DynamicResource SmallCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
    </Style>

    <Style x:Key="GroupChip" TargetType="Border" BasedOn="{StaticResource ModChip}">
        <Setter Property="Margin" Value="0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HasGroupColor}" Value="True">
                <Setter Property="Background" Value="{Binding GroupChipBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="ModChipText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource CardChipFontSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <DataTemplate x:Key="ModListBadges">
        <ItemsControl
            ItemsSource="{Binding Lists}"
            Visibility="{Binding ShowLists, Converter={StaticResource CardBoolToVis}}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource ModChip}" ToolTip="{loc:Str Installed_ListChipToolTip}">
                        <TextBlock Style="{StaticResource ModChipText}" Text="{Binding}" MaxWidth="140" />
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

    <DataTemplate x:Key="CardField.Installed.Note" DataType="{x:Type viewmodels:InstalledModCardViewModel}">
        <TextBlock
            FontSize="{DynamicResource CardLineFontSize}"
            FontStyle="Italic"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            TextTrimming="CharacterEllipsis"
            Text="{Binding Note}"
            ToolTip="{Binding Note}"
            Visibility="{Binding Note, Converter={StaticResource CardNullToCollapsed}}" />
    </DataTemplate>

    <Style x:Key="SideChip" TargetType="Border">
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
        <Setter Property="Background" Value="{DynamicResource ToggleButtonBackgroundChecked}" />
    </Style>

    <Style x:Key="SideChipText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource CardChipFontSize}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <DataTemplate x:Key="CardField.Installed.Sides" DataType="{x:Type viewmodels:InstalledModCardViewModel}">
        <StackPanel Margin="0,0,2,0" Orientation="Horizontal" Background="Transparent" ToolTip="{Binding TargetSummary}">
            <Border Style="{StaticResource SideChip}" Visibility="{Binding HasServer, Converter={StaticResource CardBoolToVis}}">
                <TextBlock Style="{StaticResource SideChipText}" Text="{loc:Str Installed_SideServer}" />
            </Border>
            <Border Style="{StaticResource SideChip}" Visibility="{Binding HasPlugin, Converter={StaticResource CardBoolToVis}}">
                <TextBlock Style="{StaticResource SideChipText}" Text="{loc:Str Installed_SideClient}" />
            </Border>
            <Border Style="{StaticResource SideChip}" Visibility="{Binding HasPatcher, Converter={StaticResource CardBoolToVis}}">
                <TextBlock Style="{StaticResource SideChipText}" Text="{loc:Str Installed_SidePatcher}" />
            </Border>
            <Border Margin="0,0,4,0" Style="{StaticResource ModChip}" Visibility="{Binding HasNoSide, Converter={StaticResource CardBoolToVis}}">
                <TextBlock Style="{StaticResource ModChipText}" Text="{Binding TargetSummary}" />
            </Border>
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="CardField.Installed.AddonParent" DataType="{x:Type viewmodels:InstalledModCardViewModel}">
        <Border
            Margin="0,0,6,0"
            Style="{StaticResource ModChip}"
            ToolTip="{Binding AddonSubtitle}"
            Visibility="{Binding AddonSubtitle, Converter={StaticResource CardNullToCollapsed}}">
            <TextBlock Style="{StaticResource ModChipText}" Text="{Binding AddonSubtitle}" />
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="CardField.Installed.ModLists" DataType="{x:Type viewmodels:InstalledModCardViewModel}">
        <ContentPresenter ContentTemplate="{StaticResource ModListBadges}" Content="{Binding}" />
    </DataTemplate>

    <DataTemplate x:Key="CardField.Installed.Group" DataType="{x:Type viewmodels:InstalledModCardViewModel}">
        <Border
            Margin="0,0,6,0"
            Style="{StaticResource GroupChip}"
            Visibility="{Binding IsGrouped, Converter={StaticResource CardBoolToVis}}">
            <StackPanel Orientation="Horizontal">
                <ui:SymbolIcon Symbol="Folder24" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="{Binding HasGroupIcon, Converter={StaticResource CardFalseToVisible}}" />
                <controls:GroupIconView Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center" Key="{Binding GroupIcon}" Visibility="{Binding HasGroupIcon, Converter={StaticResource CardBoolToVis}}" />
                <TextBlock Style="{StaticResource ModChipText}" Text="{Binding GroupName}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="CardField.Installed.Disabled" DataType="{x:Type viewmodels:InstalledModCardViewModel}">
        <Border
            Margin="0,0,6,0"
            Style="{StaticResource DisabledBadge}"
            Visibility="{Binding IsDisabled, Converter={StaticResource CardBoolToVis}}">
            <TextBlock Style="{StaticResource DisabledBadgeText}" Text="{loc:Str Installed_DisabledTag}" />
        </Border>
    </DataTemplate>

    <DataTemplate x:Key="CardField.Installed.Pinned" DataType="{x:Type viewmodels:InstalledModCardViewModel}">
        <ui:SymbolIcon
            Symbol="Pin24"
            FontSize="14"
            Margin="0,0,6,0"
            VerticalAlignment="Center"
            Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
            ToolTip="{loc:Str Common_PinnedToolTip}"
            Visibility="{Binding IsPinned, Converter={StaticResource CardBoolToVis}}" />
    </DataTemplate>



    <DataTemplate x:Key="CardField.Installed.SptFit" DataType="{x:Type viewmodels:InstalledModCardViewModel}">
        <TextBlock
            FontSize="{DynamicResource CardLineFontSize}"
            TextWrapping="Wrap"
            Text="{Binding SptFitLine}"
            Visibility="{Binding SptFitLine, Converter={StaticResource CardNullToCollapsed}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsNotForThisSpt}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </DataTemplate>

    <DataTemplate x:Key="CardField.Installed.Teaser" DataType="{x:Type viewmodels:InstalledModCardViewModel}">
        <TextBlock
            FontSize="{DynamicResource CardLineFontSize}"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            TextTrimming="CharacterEllipsis"
            Text="{Binding PreviewTeaser}"
            ToolTip="{Binding PreviewTeaser}"
            Visibility="{Binding PreviewTeaser, Converter={StaticResource CardNullToCollapsed}}" />
    </DataTemplate>

    <!-- OPEN-77: the card's buttons, in a row along the bottom (default) or down the side (CardButtons.Side). -->
    <Style x:Key="CardActionButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Margin" Value="0,0,4,0" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding (controls:CardLayoutScope.Layout).ButtonsAtSide, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Margin" Value="0,2,10,0" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <DataTemplate x:Key="InstalledCardButtons" DataType="{x:Type viewmodels:InstalledModCardViewModel}">
            <StackPanel Orientation="{Binding (controls:CardLayoutScope.Layout).ButtonsOrientation, RelativeSource={RelativeSource Self}}">

                <ui:Button
                    Style="{StaticResource CardActionButton}"
                    Padding="0"
                    MinWidth="0"
                    MinHeight="0"
                    Width="30"
                    Height="30"
                    HorizontalAlignment="Center"
                    Appearance="Transparent"
                    Command="{Binding DataContext.ToggleDisableCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                    CommandParameter="{Binding}"
                    ToolTip="{Binding DisableToggleTooltip}"
                    Visibility="{Binding (controls:CardLayoutScope.Layout).ShowDisableToggle, RelativeSource={RelativeSource Self}, Converter={StaticResource CardBoolToVis}}">
                    <ui:SymbolIcon Symbol="{Binding DisableToggleGlyph}" FontSize="16" />
                </ui:Button>

                <Border Visibility="{Binding (controls:CardLayoutScope.Layout).ShowQuickUpdate, RelativeSource={RelativeSource Self}, Converter={StaticResource CardBoolToVis}}">
                    <ui:Button
                        Style="{StaticResource CardActionButton}"
                        Padding="0"
                        MinWidth="0"
                        MinHeight="0"
                        Width="30"
                        Height="30"
                        HorizontalAlignment="Center"
                        Appearance="Transparent"
                        Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                        Visibility="{Binding CanQuickUpdate, Converter={StaticResource CardBoolToVis}}"
                        Command="{Binding DataContext.UpdateOneCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                        CommandParameter="{Binding}"
                        ToolTip="{Binding QuickUpdateToolTip}">
                        <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" />
                    </ui:Button>
                </Border>

                <ui:Button
                    Style="{StaticResource CardActionButton}"
                    Padding="0"
                    MinWidth="0"
                    MinHeight="0"
                    Width="30"
                    Height="30"
                    HorizontalAlignment="Center"
                    Appearance="Transparent"
                    Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                    CommandParameter="{Binding}"
                    ToolTip="{Binding PinTooltip}"
                    Visibility="{Binding (controls:CardLayoutScope.Layout).ShowPinInButtons, RelativeSource={RelativeSource Self}, Converter={StaticResource CardBoolToVis}}">
                    <ui:SymbolIcon Symbol="{Binding PinGlyph}" FontSize="16" />
                </ui:Button>

                <ui:Button
                    Style="{StaticResource CardActionButton}"
                    Padding="0"
                    MinWidth="0"
                    MinHeight="0"
                    Width="30"
                    Height="30"
                    HorizontalAlignment="Center"
                    Appearance="Transparent"
                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                    CommandParameter="{Binding}"
                    ToolTip="{loc:Str Installed_RemoveToolTip}"
                    Visibility="{Binding (controls:CardLayoutScope.Layout).ShowRemoveButton, RelativeSource={RelativeSource Self}, Converter={StaticResource CardBoolToVis}}">
                    <ui:SymbolIcon Symbol="Delete24" FontSize="16" />
                </ui:Button>

                <Border Visibility="{Binding (controls:CardLayoutScope.Layout).ShowInstalledAddons, RelativeSource={RelativeSource Self}, Converter={StaticResource CardBoolToVis}}">
                    <ui:Button
                        Style="{StaticResource CardActionButton}"
                        Padding="0"
                        MinWidth="0"
                        MinHeight="0"
                        Width="30"
                        Height="30"
                        HorizontalAlignment="Center"
                        Appearance="Transparent"
                        Visibility="{Binding HasInstalledAddons, Converter={StaticResource CardBoolToVis}}"
                        Command="{Binding DataContext.ShowFamilyCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                        CommandParameter="{Binding}"
                        ToolTip="{Binding InstalledAddonsToolTip}">
                        <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="16" />
                    </ui:Button>
                </Border>

                <Border Visibility="{Binding (controls:CardLayoutScope.Layout).ShowNeededBy, RelativeSource={RelativeSource Self}, Converter={StaticResource CardBoolToVis}}">
                    <ui:Button
                        Style="{StaticResource CardActionButton}"
                        Padding="0"
                        MinWidth="0"
                        MinHeight="0"
                        Width="30"
                        Height="30"
                        HorizontalAlignment="Center"
                        Appearance="Transparent"
                        Visibility="{Binding IsNeeded, Converter={StaticResource CardBoolToVis}}"
                        Command="{Binding DataContext.ShowNeededByCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                        CommandParameter="{Binding}"
                        ToolTip="{Binding NeededByToolTip}">
                        <ui:SymbolIcon Symbol="Branch24" FontSize="16" />
                    </ui:Button>
                </Border>

                <!-- OPEN-76 R11: sp-mod's Subscribe / Endorse / Add to list and reactions, signed in only. -->
                <Border Visibility="{Binding (controls:CardLayoutScope.Layout).ShowSpModActions, RelativeSource={RelativeSource Self}, Converter={StaticResource CardBoolToVis}}">
                    <Border Visibility="{Binding SpModActionsModId, Converter={StaticResource CardNullToCollapsed}}">
                        <ui:Button
                            Style="{StaticResource CardActionButton}"
                            Padding="0"
                            MinWidth="0"
                            MinHeight="0"
                            Width="30"
                            Height="30"
                            HorizontalAlignment="Center"
                            Appearance="Transparent"
                            behaviors:SpModActions.ModId="{Binding SpModActionsModId}"
                            ToolTip="{loc:Str SpModActions_ToolTip}"
                            Visibility="{Binding IsSignedIn, Source={x:Static app:AppServices.SpModAccount}, Converter={StaticResource CardBoolToVis}}">
                            <ui:SymbolIcon Symbol="ThumbLike24" FontSize="16" />
                        </ui:Button>
                    </Border>
                </Border>
            </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="InstalledCardHeader" DataType="{x:Type viewmodels:InstalledModCardViewModel}">
        <Grid
            Margin="0,0,8,0"
            Background="Transparent"
            ToolTip="{StaticResource ModHoverPreview}"
            ToolTipService.InitialShowDelay="3000"
            ToolTipService.BetweenShowDelay="0"
            ToolTipService.ShowDuration="60000"
            ToolTipService.Placement="Right">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" SharedSizeGroup="InstalledCardBody" />
                <RowDefinition Height="Auto" SharedSizeGroup="InstalledCardButtonRow" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Row="0"
                Grid.ColumnSpan="4"
                Height="{DynamicResource CardBannerHeight}"
                Margin="0,0,0,8"
                ClipToBounds="True"
                CornerRadius="{DynamicResource SmallCornerRadius}"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                Visibility="{Binding (controls:CardLayoutScope.Layout).ShowBanner, RelativeSource={RelativeSource Self}, Converter={StaticResource CardBoolToVis}}">
                <Image Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <behaviors:ThumbnailLoader.LargeSource>
                        <MultiBinding Converter="{StaticResource CardPictureWhenShown}">
                            <Binding Path="(controls:CardLayoutScope.Layout).ShowBanner" RelativeSource="{RelativeSource Self}" />
                            <Binding Path="PreviewThumbnail" />
                        </MultiBinding>
                    </behaviors:ThumbnailLoader.LargeSource>
                </Image>
            </Border>

            <CheckBox
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                IsChecked="{Binding IsSelected}"
                Visibility="{Binding DataContext.SelectionMode, RelativeSource={RelativeSource AncestorType={x:Type Page}}, Converter={StaticResource CardBoolToVis}}" />

            <StackPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Top">
                <ui:SymbolIcon
                    Margin="0,1,10,0"
                    HorizontalAlignment="Center"
                    FontSize="20"
                    Symbol="{Binding StatusGlyph}"
                    Style="{StaticResource StatusIcon}"
                    ToolTip="{Binding StatusTooltip}" />

                <ui:Button
                    Margin="0,4,10,0"
                    Padding="0"
                    MinWidth="0"
                    MinHeight="0"
                    Width="30"
                    Height="30"
                    HorizontalAlignment="Center"
                    Appearance="Transparent"
                    Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                    CommandParameter="{Binding}"
                    ToolTip="{Binding PinTooltip}"
                    Visibility="{Binding (controls:CardLayoutScope.Layout).ShowPinUnderStatus, RelativeSource={RelativeSource Self}, Converter={StaticResource CardBoolToVis}}">
                    <ui:SymbolIcon Symbol="{Binding PinGlyph}" FontSize="16" />
                </ui:Button>

                <ContentPresenter
                    Margin="0,2,0,0"
                    ContentTemplate="{StaticResource InstalledCardButtons}"
                    Content="{Binding}"
                    Visibility="{Binding (controls:CardLayoutScope.Layout).ButtonsAtSide, RelativeSource={RelativeSource Self}, Converter={StaticResource CardBoolToVis}}" />
            </StackPanel>

            <Border
                Grid.Row="1"
                Grid.Column="2"
                Width="{DynamicResource CardSmallPictureSize}"
                Height="{DynamicResource CardSmallPictureSize}"
                Margin="0,0,10,0"
                VerticalAlignment="Top"
                ClipToBounds="True"
                CornerRadius="{DynamicResource SmallCornerRadius}"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                Visibility="{Binding (controls:CardLayoutScope.Layout).ShowSmallPicture, RelativeSource={RelativeSource Self}, Converter={StaticResource CardBoolToVis}}">
                <Image Stretch="UniformToFill">
                    <behaviors:ThumbnailLoader.Source>
                        <MultiBinding Converter="{StaticResource CardPictureWhenShown}">
                            <Binding Path="(controls:CardLayoutScope.Layout).ShowSmallPicture" RelativeSource="{RelativeSource Self}" />
                            <Binding Path="PreviewThumbnail" />
                        </MultiBinding>
                    </behaviors:ThumbnailLoader.Source>
                </Image>
            </Border>

            <StackPanel
                Grid.Row="1"
                Grid.Column="3"
                VerticalAlignment="Top"
                MinHeight="{Binding (controls:CardLayoutScope.Layout).HeaderMinHeight, RelativeSource={RelativeSource Self}, FallbackValue=92}">
                <TextBlock
                    FontSize="{DynamicResource CardTitleFontSize}"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis"
                    Text="{Binding DisplayTitle}"
                    ToolTip="{Binding DisplayTitle}" />
                <controls:CardFieldsPanel
                    TemplatePrefix="CardField.Installed."
                    Fields="{Binding (controls:CardLayoutScope.Layout).Fields, RelativeSource={RelativeSource Self}}" />
            </StackPanel>

            <ContentPresenter
                Grid.Row="2"
                Grid.ColumnSpan="4"
                Margin="0,6,0,0"
                HorizontalAlignment="Left"
                ContentTemplate="{StaticResource InstalledCardButtons}"
                Content="{Binding}"
                Visibility="{Binding (controls:CardLayoutScope.Layout).ButtonsAtBottom, RelativeSource={RelativeSource Self}, Converter={StaticResource CardBoolToVis}}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="InstalledListRowHeader" DataType="{x:Type viewmodels:InstalledModCardViewModel}">
        <Grid Margin="0,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
            <CheckBox
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                IsChecked="{Binding IsSelected}"
                Visibility="{Binding DataContext.SelectionMode, RelativeSource={RelativeSource AncestorType={x:Type Page}}, Converter={StaticResource CardBoolToVis}}" />
            <ui:SymbolIcon
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                FontSize="20"
                Symbol="{Binding StatusGlyph}"
                Style="{StaticResource StatusIcon}"
                ToolTip="{Binding StatusTooltip}" />
            </StackPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    FontSize="{DynamicResource CardTitleFontSize}"
                    FontWeight="SemiBold"
                    TextTrimming="CharacterEllipsis"
                    Text="{Binding DisplayTitle}" />
                <controls:CardFieldsPanel
                    TemplatePrefix="CardField.Installed."
                    Fields="{Binding (controls:CardLayoutScope.Layout).ListFields, RelativeSource={RelativeSource Self}}" />
            </StackPanel>

            <StackPanel
                Grid.Column="2"
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Margin="12,0,12,0">
                <Border Visibility="{Binding (controls:CardLayoutScope.Layout).ListShowsGroup, RelativeSource={RelativeSource Self}, Converter={StaticResource CardBoolToVis}}">
                <Border
                    Style="{StaticResource GroupChip}"
                    Visibility="{Binding IsGrouped, Converter={StaticResource CardBoolToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Folder24" FontSize="12" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="{Binding HasGroupIcon, Converter={StaticResource CardFalseToVisible}}" />
                        <controls:GroupIconView Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center" Key="{Binding GroupIcon}" Visibility="{Binding HasGroupIcon, Converter={StaticResource CardBoolToVis}}" />
                        <TextBlock Style="{StaticResource ModChipText}" Text="{Binding GroupName}" />
                    </StackPanel>
                </Border>
                </Border>

                <Border Visibility="{Binding (controls:CardLayoutScope.Layout).ListShowsDisabled, RelativeSource={RelativeSource Self}, Converter={StaticResource CardBoolToVis}}">
                <Border
                    Margin="6,0,0,0"
                    Style="{StaticResource DisabledBadge}"
                    Visibility="{Binding IsDisabled, Converter={StaticResource CardBoolToVis}}">
                    <TextBlock Style="{StaticResource DisabledBadgeText}" Text="{loc:Str Installed_DisabledTag}" />
                </Border>
                </Border>
            </StackPanel>

            <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal">
            <Border VerticalAlignment="Top" Visibility="{Binding (controls:CardLayoutScope.Layout).ListShowsInstalledAddons, RelativeSource={RelativeSource Self}, Converter={StaticResource CardBoolToVis}}">
            <ui:Button
                Padding="6"
                Margin="0,0,4,0"
                VerticalAlignment="Top"
                Appearance="Transparent"
                Visibility="{Binding HasInstalledAddons, Converter={StaticResource CardBoolToVis}}"
                Command="{Binding DataContext.ShowFamilyCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                CommandParameter="{Binding}"
                ToolTip="{Binding InstalledAddonsToolTip}">
                <ui:SymbolIcon Symbol="PuzzlePiece24" FontSize="16" />
            </ui:Button>
            </Border>
            <Border VerticalAlignment="Top" Visibility="{Binding (controls:CardLayoutScope.Layout).ListShowsNeededBy, RelativeSource={RelativeSource Self}, Converter={StaticResource CardBoolToVis}}">
            <ui:Button
                Padding="6"
                Margin="0,0,4,0"
                VerticalAlignment="Top"
                Appearance="Transparent"
                Visibility="{Binding IsNeeded, Converter={StaticResource CardBoolToVis}}"
                Command="{Binding DataContext.ShowNeededByCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                CommandParameter="{Binding}"
                ToolTip="{Binding NeededByToolTip}">
                <ui:SymbolIcon Symbol="Branch24" FontSize="16" />
            </ui:Button>
            </Border>
            <Border VerticalAlignment="Top" Visibility="{Binding (controls:CardLayoutScope.Layout).ListShowsSpModActions, RelativeSource={RelativeSource Self}, Converter={StaticResource CardBoolToVis}}">
            <Border Visibility="{Binding SpModActionsModId, Converter={StaticResource CardNullToCollapsed}}">
            <ui:Button
                Padding="6"
                Margin="0,0,4,0"
                VerticalAlignment="Top"
                Appearance="Transparent"
                behaviors:SpModActions.ModId="{Binding SpModActionsModId}"
                ToolTip="{loc:Str SpModActions_ToolTip}"
                Visibility="{Binding IsSignedIn, Source={x:Static app:AppServices.SpModAccount}, Converter={StaticResource CardBoolToVis}}">
                <ui:SymbolIcon Symbol="ThumbLike24" FontSize="16" />
            </ui:Button>
            </Border>
            </Border>
            <Border VerticalAlignment="Top" Visibility="{Binding (controls:CardLayoutScope.Layout).ListShowsQuickUpdate, RelativeSource={RelativeSource Self}, Converter={StaticResource CardBoolToVis}}">
            <ui:Button
                Padding="6"
                Margin="0,0,4,0"
                VerticalAlignment="Top"
                Appearance="Transparent"
                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                Visibility="{Binding CanQuickUpdate, Converter={StaticResource CardBoolToVis}}"
                Command="{Binding DataContext.UpdateOneCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                CommandParameter="{Binding}"
                ToolTip="{Binding QuickUpdateToolTip}">
                <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="16" />
            </ui:Button>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <ui:Button
                    Padding="6"
                    Appearance="Transparent"
                    Visibility="{Binding (controls:CardLayoutScope.Layout).ListShowsDisableToggle, RelativeSource={RelativeSource Self}, Converter={StaticResource CardBoolToVis}}"
                    Command="{Binding DataContext.ToggleDisableCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                    CommandParameter="{Binding}"
                    ToolTip="{Binding DisableToggleTooltip}">
                    <ui:SymbolIcon Symbol="{Binding DisableToggleGlyph}" FontSize="16" />
                </ui:Button>

                <Border Visibility="{Binding (controls:CardLayoutScope.Layout).ListShowsPinned, RelativeSource={RelativeSource Self}, Converter={StaticResource CardBoolToVis}}">
                <ui:SymbolIcon
                    Symbol="Pin24"
                    FontSize="12"
                    Margin="0,1,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    ToolTip="{loc:Str Common_PinnedToolTip}"
                    Visibility="{Binding IsPinned, Converter={StaticResource CardBoolToVis}}" />
                </Border>
            </StackPanel>
            </StackPanel>
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="ModDetailLines" DataType="{x:Type viewmodels:InstalledModCardViewModel}">
        <StackPanel>
            <TextBlock
                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                TextWrapping="Wrap"
                Text="{Binding AddonSubtitle}"
                Visibility="{Binding AddonSubtitle, Converter={StaticResource CardNullToCollapsed}}" />

            <TextBlock
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                TextWrapping="Wrap"
                Text="{Binding SharedFolderLine, Mode=OneWay}"
                Visibility="{Binding SharedFolderLine, Converter={StaticResource CardNullToCollapsed}}" />

            <TextBlock
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                TextWrapping="Wrap"
                Text="{Binding FolderNameIfDifferent, Mode=OneWay, StringFormat={loc:Str Installed_DetailInstalledAsFormat}}"
                Visibility="{Binding FolderNameIfDifferent, Converter={StaticResource CardNullToCollapsed}}" />

            <TextBlock
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                TextWrapping="Wrap"
                Text="{Binding Guid, Mode=OneWay, StringFormat={loc:Str Installed_DetailGuidFormat}}"
                Visibility="{Binding Guid, Converter={StaticResource CardNullToCollapsed}}" />

            <TextBlock
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                TextWrapping="Wrap"
                Text="{Binding InstalledVersion, Mode=OneWay, TargetNullValue={loc:Str Common_Unknown}, StringFormat={loc:Str Installed_DetailInstalledVersionFormat}}" />

            <TextBlock
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                TextWrapping="Wrap"
                Text="{Binding LatestPublishedText, Mode=OneWay, StringFormat={loc:Str Installed_DetailLatestPublishedFormat}}" />

            <TextBlock
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Text="{Binding LatestUpdatedAt, Mode=OneWay, StringFormat={loc:Str Installed_DetailLastUpdatedFormat}}"
                Visibility="{Binding LatestUpdatedAt, Converter={StaticResource CardNullToCollapsed}}" />

            <TextBlock
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                Text="{Binding InstalledAt, Mode=OneWay, StringFormat={loc:Str Installed_DetailInstalledOnFormat}}"
                Visibility="{Binding InstalledAt, Converter={StaticResource CardNullToCollapsed}}" />

            <TextBlock
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                TextWrapping="Wrap"
                Text="{Binding InstalledVersionDetail}"
                Visibility="{Binding InstalledVersionDetail, Converter={StaticResource CardNullToCollapsed}}" />

            <TextBlock
                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                TextWrapping="Wrap"
                Text="{Binding IncompleteSummary}"
                Visibility="{Binding IncompleteSummary, Converter={StaticResource CardNullToCollapsed}}" />

            <TextBlock
                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                TextWrapping="Wrap"
                Text="{Binding LeftoverSummary}"
                Visibility="{Binding LeftoverSummary, Converter={StaticResource CardNullToCollapsed}}" />

            <TextBlock
                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                TextWrapping="Wrap"
                Text="{Binding DownloadSummary}"
                Visibility="{Binding DownloadSummary, Converter={StaticResource CardNullToCollapsed}}" />

            <TextBlock
                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                TextWrapping="Wrap"
                Text="{Binding HeldBackNote}"
                Visibility="{Binding HeldBackNote, Converter={StaticResource CardNullToCollapsed}}" />

            <TextBlock
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Text="{Binding SkippedNote}"
                Visibility="{Binding SkippedNote, Converter={StaticResource CardNullToCollapsed}}" />

            <TextBlock
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap"
                Text="{Binding WaitingNote}"
                Visibility="{Binding WaitingNote, Converter={StaticResource CardNullToCollapsed}}" />

            <TextBlock
                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                TextWrapping="Wrap"
                Text="{Binding SptNote}"
                Visibility="{Binding SptNote, Converter={StaticResource CardNullToCollapsed}}" />
            <TextBlock
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                TextWrapping="Wrap"
                Text="{Binding SptDismissedNote}"
                Visibility="{Binding SptDismissedNote, Converter={StaticResource CardNullToCollapsed}}" />

            <TextBlock
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                TextWrapping="Wrap"
                Text="{Binding FlagsSummary}"
                Visibility="{Binding FlagsSummary, Converter={StaticResource CardNullToCollapsed}}" />

            <TextBlock
                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                TextWrapping="Wrap"
                Margin="0,4,0,0"
                Text="{Binding SourceLabel}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ModCardActions" DataType="{x:Type viewmodels:InstalledModCardViewModel}">
        <WrapPanel>
            <ui:Button
                Margin="0,0,4,4"
                Padding="6,3"
                Appearance="Transparent"
                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                Icon="{ui:SymbolIcon EyeOff24}"
                Content="{loc:Str Installed_SptDismiss}"
                ToolTip="{loc:Str Installed_SptDismissToolTip}"
                Visibility="{Binding CanDismissSptWarning, Converter={StaticResource CardBoolToVis}}"
                Command="{Binding DataContext.DismissSptWarningCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                CommandParameter="{Binding}" />
            <ui:Button
                Margin="0,0,4,4"
                Padding="6,3"
                Appearance="Transparent"
                Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                Content="{loc:Str Installed_SptUndismiss}"
                ToolTip="{loc:Str Installed_SptUndismissToolTip}"
                Visibility="{Binding SptDismissedNote, Converter={StaticResource CardNullToCollapsed}}"
                Command="{Binding DataContext.RestoreSptWarningCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                CommandParameter="{Binding}" />
            <StackPanel Orientation="Horizontal" Visibility="{Binding (controls:CardLayoutScope.Layout).ShowFolderButtons, RelativeSource={RelativeSource Self}, Converter={StaticResource CardBoolToVis}}">
                <ui:Button
                    Margin="0,0,4,4"
                    Padding="6,3"
                    Appearance="Transparent"
                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    Icon="{ui:SymbolIcon FolderOpen24}"
                    Content="{loc:Str Installed_ClientFolder}"
                    Visibility="{Binding ClientFolderLink, Converter={StaticResource CardNullToCollapsed}}"
                    Command="{Binding DataContext.OpenModFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                    CommandParameter="{Binding ClientFolderLink}"
                    ToolTip="{Binding ClientFolderLink}"
                    ToolTipService.ShowDuration="20000" />
                <ui:Button
                    Margin="0,0,4,4"
                    Padding="6,3"
                    Appearance="Transparent"
                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                    Icon="{ui:SymbolIcon FolderOpen24}"
                    Content="{loc:Str Installed_ServerFolder}"
                    Visibility="{Binding ServerFolderLink, Converter={StaticResource CardNullToCollapsed}}"
                    Command="{Binding DataContext.OpenModFolderCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                    CommandParameter="{Binding ServerFolderLink}"
                    ToolTip="{Binding ServerFolderLink}"
                    ToolTipService.ShowDuration="20000" />
            </StackPanel>
            <ui:Button
                Margin="0,0,4,4"
                Padding="6,3"
                Appearance="Transparent"
                Foreground="{DynamicResource SystemFillColorCautionBrush}"
                Icon="{ui:SymbolIcon Warning24}"
                Content="{loc:Str Installed_SortOut}"
                Visibility="{Binding HasDuplicateFolders, Converter={StaticResource CardBoolToVis}}"
                Command="{Binding DataContext.ResolveDuplicateCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                CommandParameter="{Binding}"
                ToolTip="{loc:Str Installed_SortOutToolTip}" />
            <ui:Button
                Margin="0,0,4,4"
                Padding="6,3"
                Appearance="Transparent"
                Icon="{ui:SymbolIcon CheckmarkCircle24}"
                Content="{loc:Str Installed_ConfirmDownload}"
                Visibility="{Binding CanConfirmDownload, Converter={StaticResource CardBoolToVis}}"
                Command="{Binding DataContext.ConfirmDownloadCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                CommandParameter="{Binding}"
                ToolTip="{loc:Str Installed_ConfirmDownloadToolTip}" />
        </WrapPanel>
    </DataTemplate>
</ResourceDictionary>
