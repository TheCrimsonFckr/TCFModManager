<UserControl
    x:Class="TCFModManager.App.Views.Play.MessageCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework">
    <UserControl.Resources>
        <controls:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <ui:Card
        Padding="16"
        VerticalAlignment="Top"
        Margin="0,0,0,16"
        Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
        <StackPanel>
            <TextBox
                Style="{StaticResource SelectableErrorText}"
                Text="{Binding Message, Mode=OneWay}" />
            <!-- OPEN-54 N27: offered when the server stopped before it was ready. -->
            <ui:Button
                Margin="0,10,0,0"
                HorizontalAlignment="Left"
                Appearance="Primary"
                Content="{loc:Str Search_Title}"
                Icon="{ui:SymbolIcon Search24}"
                ToolTip="{loc:Str Search_Description}"
                Command="{Binding FindBrokenModCommand}"
                Visibility="{Binding OfferBrokenModSearch, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
    </ui:Card>
</UserControl>
