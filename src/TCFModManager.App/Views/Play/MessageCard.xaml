<UserControl
    x:Class="TCFModManager.App.Views.Play.MessageCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework">
    <UserControl.Resources>
        <controls:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    <ui:Card
        Padding="16"
        VerticalAlignment="Top"
        Margin="0,0,0,16"
        Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
        <TextBlock
            TextWrapping="Wrap"
            Style="{StaticResource ErrorText}"
            Text="{Binding Message}" />
    </ui:Card>
</UserControl>
