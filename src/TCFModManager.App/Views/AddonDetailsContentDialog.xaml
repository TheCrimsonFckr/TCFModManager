<ui:ContentDialog
    x:Class="TCFModManager.App.Views.AddonDetailsContentDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:views="clr-namespace:TCFModManager.App.Views"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    Style="{DynamicResource {x:Type ui:ContentDialog}}"
    IsFooterVisible="False">
    <!--
        One addon on its own, opened from Browse's Addons strip (OPEN-36 D3). Built from the cached
        addon listing, so it opens without waiting on sp-mod. Title is the addon's name.
    -->
    <ui:ContentDialog.TitleTemplate>
        <DataTemplate>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Text="{Binding}"
                    TextWrapping="WrapWithOverflow" />

                <ui:Button
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Padding="6"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Appearance="Transparent"
                    Command="{Binding RelativeSource={RelativeSource AncestorType={x:Type ui:ContentDialog}}, Path=TemplateButtonCommand}"
                    CommandParameter="{x:Static ui:ContentDialogButton.Close}"
                    Icon="{ui:SymbolIcon Dismiss24}"
                    IsCancel="True"
                    ToolTip="{loc:Str Common_Close}" />
            </Grid>
        </DataTemplate>
    </ui:ContentDialog.TitleTemplate>

    <StackPanel>
        <DockPanel Margin="0,0,0,8">
            <ui:Button
                x:Name="OpenModButton"
                DockPanel.Dock="Right"
                Margin="8,0,0,0"
                Click="OpenMod_Click" />
            <TextBlock
                x:Name="AddonForText"
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </DockPanel>

        <views:AddonRowView x:Name="Row" />
    </StackPanel>
</ui:ContentDialog>
