<!-- ScrollViewer.CanContentScroll="False" opts this page out of WPF-UI's automatic outer
     DynamicScrollViewer: the ScrollViewer below is the page's own, and the wrapper only fights it.
     Background="Transparent" on the root Grid is the other half - a Grid with no Background only
     takes part in hit-testing where a child paints.

     Every TextBlock sets its Foreground from a DynamicResource brush, and de-emphasis is a
     Secondary/Tertiary brush rather than Opacity. -->
<Page
    x:Class="TCFModManager.App.Views.FootprintPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    Title="Mod footprint"
    Loaded="FootprintPage_Loaded"
    ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <converters:FootprintLevelToAppearanceConverter x:Key="LevelAppearance" />
        <converters:FalseToVisibilityConverter x:Key="FalseToVisible" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Page.Resources>

    <Grid
        x:Name="RootGrid"
        Margin="20"
        Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <ui:Button
                DockPanel.Dock="Left"
                Appearance="Primary"
                Icon="{ui:SymbolIcon ArrowSync24}"
                Content="Rescan"
                IsEnabled="{Binding IsIdle}"
                Command="{Binding RescanCommand}" />

            <ui:ProgressRing
                DockPanel.Dock="Left"
                Width="20"
                Height="20"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                IsIndeterminate="True"
                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />

            <TextBlock
                DockPanel.Dock="Left"
                Margin="12,0,0,0"
                VerticalAlignment="Center"
                TextTrimming="CharacterEllipsis"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding Status}" />

            <ComboBox
                DockPanel.Dock="Right"
                MinWidth="220"
                ItemsSource="{Binding SortOptions}"
                SelectedItem="{Binding SelectedSort}" />

            <TextBlock
                DockPanel.Dock="Right"
                Margin="0,0,8,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Sort by" />
        </DockPanel>

        <!--
            The caveat is part of the feature, not decoration. Everything here is read from what a
            mod ships on disk, and a user who reads these levels as measured frame cost has been
            misled by the page rather than by the numbers.
        -->
        <ui:Card Grid.Row="1" Margin="0,16,0,0" Padding="16">
            <StackPanel>
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="What this reads" />
                <TextBlock
                    Margin="0,4,0,0"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Each mod is read from the files it installs - how much of the game it patches, what it runs every frame, and what it puts on disk. That says how much a mod is positioned to affect the game, and where any cost would land. Nothing here is timed or measured, and a heavy footprint is not the same as a mod that costs you frames. Open a mod to see what was found and what it does and does not tell you." />
            </StackPanel>
        </ui:Card>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <TextBlock
                Margin="4,8,0,0"
                TextWrapping="Wrap"
                VerticalAlignment="Top"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="Nothing to show yet."
                Visibility="{Binding HasRows, Converter={StaticResource FalseToVisible}}" />

            <ScrollViewer
                x:Name="RowsScrollViewer"
                Focusable="False"
                VerticalScrollBarVisibility="Auto"
                HorizontalScrollBarVisibility="Disabled"
                Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}">
                <ItemsControl Focusable="False" ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Same shape as the Dependencies page's trees: the header is the
                                 summary, and opening it shows the breakdown. -->
                            <ui:CardExpander
                                Style="{StaticResource HoverCardExpander}"
                                Margin="0,0,0,8"
                                IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                <ui:CardExpander.Header>
                                    <Grid Margin="0,0,12,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                TextTrimming="CharacterEllipsis"
                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                Text="{Binding Title}" />

                                            <TextBlock
                                                Margin="0,3,0,0"
                                                TextTrimming="CharacterEllipsis"
                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Detail}" />
                                        </StackPanel>

                                        <ui:Badge
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Appearance="{Binding Level, Converter={StaticResource LevelAppearance}}"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Content="{Binding LevelText}" />
                                    </Grid>
                                </ui:CardExpander.Header>

                                <StackPanel>
                                    <ItemsControl Focusable="False" ItemsSource="{Binding Findings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource HoverRow}" Padding="10,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Fixed width so every finding's wording
                                                             starts on the same line down the card,
                                                             rather than stepping in and out with
                                                             the length of each area label. -->
                                                        <ui:Badge
                                                            Grid.Column="0"
                                                            Width="120"
                                                            Margin="0,0,12,0"
                                                            VerticalAlignment="Top"
                                                            HorizontalContentAlignment="Center"
                                                            FontSize="11"
                                                            Appearance="Secondary"
                                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                            Content="{Binding Area}" />

                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock
                                                                TextWrapping="Wrap"
                                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                Text="{Binding What}" />
                                                            <TextBlock
                                                                Margin="0,3,0,0"
                                                                TextWrapping="Wrap"
                                                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                Text="{Binding Effect}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock
                                        Margin="10,10,0,0"
                                        TextWrapping="Wrap"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding PerFrameTooltip}"
                                        Visibility="{Binding HasPerFrameTooltip, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </ui:CardExpander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
