<Page
    x:Class="TCFModManager.App.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    xmlns:behaviors="clr-namespace:TCFModManager.App.Behaviors"
    Title="Downloads">
    <Page.Resources>
        <converters:DownloadQueueStatusToAppearanceConverter x:Key="StatusAppearance" />
        <converters:CountToVisibilityConverter x:Key="HasItems" />
        <controls:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <ui:Button
                DockPanel.Dock="Right"
                Content="Clear finished"
                Click="ClearFinishedButton_Click" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Opacity="0.8"
                    TextWrapping="Wrap"
                    Text="Downloads install strictly one at a time, in the order you queued them - queue as many as you like from Browse or an update dialog and check back here for progress." />

                <!-- How far through the whole queue we are. Matters most for a mod list, which can
                     put forty items here at once; the per-card line answers how one of them is
                     doing, not how long until you can play. -->
                <TextBlock
                    Margin="0,6,0,0"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}"
                    Text="{Binding Summary}" />
            </StackPanel>
        </DockPanel>

        <!-- Empty-queue message, shown only when the queue has no items. -->
        <TextBlock
            Grid.Row="1"
            MaxWidth="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            Opacity="0.6"
            Text="Nothing queued yet - click Install on a Browse card, or Update in a mod's details dialog, to add something here."
            Visibility="{Binding Items.Count, Converter={StaticResource HasItems}, ConverterParameter=Invert}" />

        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            Visibility="{Binding Items.Count, Converter={StaticResource HasItems}}">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <!-- Card for one queued/in-progress/finished download item. -->
                    <DataTemplate>
                        <ui:Card Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Image
                                    Grid.Column="0"
                                    Width="48"
                                    Height="48"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    Stretch="UniformToFill"
                                    behaviors:ThumbnailLoader.Source="{Binding Thumbnail}" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding ModName, Mode=OneWay}" />
                                        <Run Text=" " />
                                        <!-- De-emphasized via Foreground since Run has no Opacity. -->
                                        <Run Text="{Binding VersionLabel, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </TextBlock>

                                    <!-- Indeterminate while installing, otherwise tracks download progress. -->
                                    <ProgressBar
                                        Height="6"
                                        Margin="0,8,0,0"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="{Binding Progress, Mode=OneWay}"
                                        IsIndeterminate="{Binding IsIndeterminateProgress}" />

                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="11"
                                        Opacity="0.7"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{Binding StatusMessage}" />

                                    <TextBlock
                                        Margin="0,2,0,0"
                                        TextWrapping="Wrap"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Visibility="{Binding HasTransferLabel, Converter={StaticResource BoolToVisibility}}"
                                        Text="{Binding TransferLabel}" />
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    Margin="12,0,0,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top">
                                    <ui:Badge
                                        HorizontalAlignment="Right"
                                        Appearance="{Binding Status, Converter={StaticResource StatusAppearance}}"
                                        Content="{Binding StatusLabel}" />

                                    <!-- Cancels this item and any dependencies it queued; hidden once the item is finished. -->
                                    <ui:Button
                                        Margin="0,8,0,0"
                                        Padding="10,4"
                                        HorizontalAlignment="Right"
                                        Appearance="Secondary"
                                        Content="Cancel"
                                        ToolTip="Cancel this download and any dependencies it queued."
                                        Command="{Binding CancelCommand}"
                                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
