<Page
    x:Class="TCFModManager.App.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    xmlns:behaviors="clr-namespace:TCFModManager.App.Behaviors"
    Title="Downloads">
    <Page.Resources>
        <converters:DownloadQueueStatusToAppearanceConverter x:Key="StatusAppearance" />
        <converters:CountToVisibilityConverter x:Key="HasItems" />
        <controls:BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- One figure in its own fixed-width container. Run together on a single line, a transfer
             readout shuffles sideways every time a number changes width; a box per figure keeps
             each one anchored to its own left edge and its caption says which is which. -->
        <Style x:Key="StatBox" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Margin" Value="0,6,6,0" />
        </Style>
    </Page.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <ui:Button
                DockPanel.Dock="Right"
                Content="Clear finished"
                Click="ClearFinishedButton_Click" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Opacity="0.8"
                    TextWrapping="Wrap"
                    Text="Downloads install strictly one at a time, in the order you queued them - queue as many as you like from Browse or an update dialog and check back here for progress." />

                <!-- How far through the whole queue we are. Matters most for a mod list, which can
                     put forty items here at once; the per-card boxes answer how one of them is
                     doing, not how long until you can play. -->
                <WrapPanel
                    Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}">
                    <Border Style="{StaticResource StatBox}" Width="130">
                        <StackPanel>
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="Queue" />
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding SummaryProgress}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatBox}" Width="130">
                        <StackPanel>
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="Left to fetch" />
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding SummaryRemaining}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource StatBox}" Width="130">
                        <StackPanel>
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="Time to go" />
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding SummaryEta}" />
                        </StackPanel>
                    </Border>

                    <!-- Only when something in the queue has no size yet, so the figures above are
                         read as covering less than the whole queue. -->
                    <Border
                        Style="{StaticResource StatBox}"
                        Width="130"
                        Visibility="{Binding HasUnsized, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="Not sized yet" />
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding SummaryUnsized}" />
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </DockPanel>

        <!-- Empty-queue message, shown only when the queue has no items. -->
        <TextBlock
            Grid.Row="1"
            MaxWidth="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
            Opacity="0.6"
            Text="Nothing queued yet - click Install on a Browse card, or Update in a mod's details dialog, to add something here."
            Visibility="{Binding Items.Count, Converter={StaticResource HasItems}, ConverterParameter=Invert}" />

        <ScrollViewer
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            Visibility="{Binding Items.Count, Converter={StaticResource HasItems}}">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <!-- Card for one queued/in-progress/finished download item. -->
                    <DataTemplate>
                        <ui:Card Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Image
                                    Grid.Column="0"
                                    Width="48"
                                    Height="48"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    Stretch="UniformToFill"
                                    behaviors:ThumbnailLoader.Source="{Binding Thumbnail}" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding ModName, Mode=OneWay}" />
                                        <Run Text=" " />
                                        <!-- De-emphasized via Foreground since Run has no Opacity. -->
                                        <Run Text="{Binding VersionLabel, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </TextBlock>

                                    <!-- An addon's name rarely says it is one, and its version
                                         number belongs to a different sequence from its parent's. -->
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="Addon"
                                        Visibility="{Binding IsAddon, Converter={StaticResource BoolToVisibility}}" />

                                    <!-- Indeterminate while installing, otherwise tracks download progress. -->
                                    <ProgressBar
                                        Height="6"
                                        Margin="0,8,0,0"
                                        Minimum="0"
                                        Maximum="1"
                                        Value="{Binding Progress, Mode=OneWay}"
                                        IsIndeterminate="{Binding IsIndeterminateProgress}" />

                                    <TextBlock
                                        Margin="0,6,0,0"
                                        FontSize="11"
                                        Opacity="0.7"
                                        TextTrimming="CharacterEllipsis"
                                        Text="{Binding StatusMessage}" />

                                    <!-- One box per figure - see StatBox above for why they aren't
                                         a single line. Speed and time read as a dash until the
                                         download has run long enough to measure honestly. -->
                                    <WrapPanel Visibility="{Binding HasTransferDetails, Converter={StaticResource BoolToVisibility}}">
                                        <Border Style="{StaticResource StatBox}" Width="150">
                                            <StackPanel>
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="Downloaded" />
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    TextTrimming="CharacterEllipsis"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Text="{Binding TransferredValue}" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource StatBox}" Width="110">
                                            <StackPanel>
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="Speed" />
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    TextTrimming="CharacterEllipsis"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Text="{Binding RateValue}" />
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource StatBox}" Width="110">
                                            <StackPanel>
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                    Text="Time left" />
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    TextTrimming="CharacterEllipsis"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Text="{Binding EtaValue}" />
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="2"
                                    Margin="12,0,0,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top">
                                    <ui:Badge
                                        HorizontalAlignment="Right"
                                        Appearance="{Binding Status, Converter={StaticResource StatusAppearance}}"
                                        Content="{Binding StatusLabel}" />

                                    <!-- Cancels this item and any dependencies it queued; hidden once the item is finished. -->
                                    <ui:Button
                                        Margin="0,8,0,0"
                                        Padding="10,4"
                                        HorizontalAlignment="Right"
                                        Appearance="Secondary"
                                        Content="Cancel"
                                        ToolTip="Cancel this download and any dependencies it queued."
                                        Command="{Binding CancelCommand}"
                                        Visibility="{Binding CanCancel, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
