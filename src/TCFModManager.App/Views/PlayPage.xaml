<Page
    x:Class="TCFModManager.App.Views.PlayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
    Title="Play">
    <Page.Resources>
        <controls:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>
    <StackPanel Margin="16">

        <ui:Card Padding="16" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock
                    Text="SPT server"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="Starts this install's server and leaves it running in its own console window. It keeps running if you close this app, and nothing here will stop it - close its window when you're done." />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:Button
                        Appearance="Primary"
                        Content="Start server"
                        Icon="{ui:SymbolIcon Play24}"
                        IsEnabled="{Binding CanStartServer}"
                        Command="{Binding StartServerCommand}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding ServerState}" />
                </StackPanel>

                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding ServerPath}" />
            </StackPanel>
        </ui:Card>

        <ui:Card Padding="16" VerticalAlignment="Top" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock
                    Text="Game launcher"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="Opens SPT.Launcher.exe, where you pick a profile and start the game. Start the server first - the launcher has nothing to log in to without it." />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:Button
                        Appearance="Primary"
                        Content="Open launcher"
                        Icon="{ui:SymbolIcon Play24}"
                        IsEnabled="{Binding CanStartClient}"
                        Command="{Binding StartClientCommand}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding ClientState}" />
                </StackPanel>

                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding ClientPath}" />
            </StackPanel>
        </ui:Card>

        <!-- Only an install running a headless client has this launcher, so the card is off the
             page entirely on every other one rather than showing a dead button. -->
        <ui:Card
            Padding="16"
            VerticalAlignment="Top"
            Margin="0,16,0,0"
            Visibility="{Binding HasHeadless, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock
                    Text="Fika headless client"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="This install has a Fika headless launcher, which only appears on a setup running a headless client. It hosts raids for other players rather than being the one you play on - start the server first, same as the game launcher." />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:Button
                        Content="Open headless launcher"
                        Icon="{ui:SymbolIcon Play24}"
                        IsEnabled="{Binding CanStartHeadless}"
                        Command="{Binding StartHeadlessCommand}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding HeadlessState}" />
                </StackPanel>

                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding HeadlessPath}" />
            </StackPanel>
        </ui:Card>

        <ui:Card
            Padding="16"
            VerticalAlignment="Top"
            Margin="0,16,0,0"
            Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
            <TextBlock
                TextWrapping="Wrap"
                Style="{StaticResource ErrorText}"
                Text="{Binding Message}" />
        </ui:Card>

    </StackPanel>
</Page>
