<Page
    x:Class="TCFModManager.App.Views.PlayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
    xmlns:app="clr-namespace:TCFModManager.App"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    xmlns:behaviors="clr-namespace:TCFModManager.App.Behaviors"
    Title="{loc:Str Nav_Play}">
    <Page.Resources>
        <controls:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:NullToVisibilityConverter x:Key="NullToCollapsed" />
        <converters:FalseToVisibilityConverter x:Key="FalseToVisible" />
        <converters:InverseBooleanConverter x:Key="Inverse" />
    </Page.Resources>
    <StackPanel Margin="16">

        <!-- OPEN-23 R4: SPT would load no server mods. Shown only then, and never a gate. -->
        <ui:Card
            Padding="16"
            VerticalAlignment="Top"
            Margin="0,0,0,16"
            Visibility="{Binding InstallWideWarning, Converter={StaticResource NullToCollapsed}}">
            <StackPanel>
                <ui:Button
                    Padding="0"
                    HorizontalContentAlignment="Left"
                    Appearance="Transparent"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                    Icon="{ui:SymbolIcon ErrorCircle20}"
                    Command="{Binding ShowConflictsCommand}">
                    <TextBlock TextWrapping="Wrap" Text="{Binding InstallWideWarning}" />
                </ui:Button>
                <TextBlock
                    Margin="0,4,0,0"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{loc:Str Play_InstallWideHint}" />
            </StackPanel>
        </ui:Card>

        <!-- Conflicts in this install (OPEN-11 R4): shown only when there are any, and never a gate. -->
        <ui:Card
            Padding="16"
            VerticalAlignment="Top"
            Margin="0,0,0,16"
            Visibility="{Binding ConflictWarning, Converter={StaticResource NullToCollapsed}}">
            <StackPanel>
                <ui:Button
                    Padding="0"
                    Appearance="Transparent"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                    Icon="{ui:SymbolIcon ErrorCircle20}"
                    Content="{Binding ConflictWarning}"
                    Command="{Binding ShowConflictsCommand}" />
                <TextBlock
                    Margin="0,4,0,0"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{loc:Str Play_ConflictsHint}" />
            </StackPanel>
        </ui:Card>

        <!--
            The pre-launch check, above the buttons because that is the order it matters in.
            Hidden entirely unless a server is set up, so an install that plays alone never sees it.

            It never blocks a launch. It replaces a BepInEx plugin that spoke at the splash screen -
            the honest moment, seconds before joining - and the reason that plugin was dropped was
            containment, not that warning people was wrong. What it must not become is a gate: the
            mods it compares may not matter, the server may be wrong, and a raid held up by a
            warning nobody can override is worse than a version mismatch.
        -->
        <ui:Card
            Padding="16"
            VerticalAlignment="Top"
            Margin="0,0,0,16"
            DataContext="{x:Static app:AppServices.PreLaunchCheck}"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <ui:SymbolIcon
                        Symbol="Connected20"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding Title}" />
                    <ProgressBar
                        Width="60"
                        Height="4"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        IsIndeterminate="True"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Message}" />

                <!-- Named, not counted. "Three mods behind" is not something anyone can act on;
                     the names are, and they are what you check against what the server runs. -->
                <TextBlock
                    Margin="0,8,0,0"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding Outstanding}"
                    Visibility="{Binding HasOutstanding, Converter={StaticResource BoolToVisibility}}" />

                <!-- Review and install only when behind a list a server served: it opens Mod lists
                     with that list previewed, and installing is still the Apply there. -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Button
                        Appearance="Primary"
                        Margin="0,0,8,0"
                        Content="{loc:Str Common_ReviewAndInstall}"
                        Icon="{ui:SymbolIcon ArrowDownload24}"
                        ToolTip="{loc:Str Common_ReviewAndInstallToolTip}"
                        Command="{Binding ReviewCommand}"
                        Visibility="{Binding CanReview, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button
                        Content="{loc:Str Play_CheckAgain}"
                        Icon="{ui:SymbolIcon ArrowSync24}"
                        Command="{Binding CheckCommand}" />
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <ui:Card Padding="16" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock
                    Text="{loc:Str Play_ServerHeader}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="{Binding ServerDescription}" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:Button
                        Appearance="Primary"
                        Content="{loc:Str Play_StartServer}"
                        Icon="{ui:SymbolIcon Play24}"
                        IsEnabled="{Binding CanStartServer}"
                        Command="{Binding StartServerCommand}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Content="{loc:Str Play_Restart}"
                        Icon="{ui:SymbolIcon ArrowSync24}"
                        ToolTip="{loc:Str Play_RestartServerToolTip}"
                        Command="{Binding AskRestartServerCommand}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Content="{loc:Str Play_Stop}"
                        Icon="{ui:SymbolIcon Stop24}"
                        ToolTip="{loc:Str Play_StopServerToolTip}"
                        Command="{Binding AskStopServerCommand}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding ServerState}" />
                    <ProgressBar
                        Width="60"
                        Height="4"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        IsIndeterminate="True"
                        Visibility="{Binding IsWaitingForServer, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Asked on the card, not in a dialog: the warning is about the thing the card is
                     describing. Asked at all because a raid in progress does not survive it. -->
                <StackPanel
                    Margin="0,0,0,8"
                    Visibility="{Binding ConfirmingServerRestart, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        TextWrapping="Wrap"
                        Margin="0,0,0,8"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Text="{loc:Str Play_RestartServerWarning}" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button
                            Appearance="Danger"
                            Content="{loc:Str Play_RestartServerConfirm}"
                            Icon="{ui:SymbolIcon ArrowSync24}"
                            Command="{Binding ConfirmRestartCommand}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Appearance="Transparent"
                            Content="{loc:Str Common_Cancel}"
                            Command="{Binding CancelRestartCommand}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Margin="0,0,0,8"
                    Visibility="{Binding ConfirmingServerStop, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        TextWrapping="Wrap"
                        Margin="0,0,0,8"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Text="{loc:Str Play_StopServerWarning}" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button
                            Appearance="Danger"
                            Content="{loc:Str Play_StopServerConfirm}"
                            Icon="{ui:SymbolIcon Stop24}"
                            Command="{Binding ConfirmStopCommand}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Appearance="Transparent"
                            Content="{loc:Str Common_Cancel}"
                            Command="{Binding CancelStopCommand}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding ServerPath}" />

                <!-- The server's own log file, read on the poll while this is open (ServerLogs).
                     Opens by itself when the server runs without its window. -->
                <Expander
                    Margin="0,12,0,0"
                    Header="{loc:Str Play_ServerLog}"
                    IsExpanded="{Binding ShowServerLog}">
                    <StackPanel Margin="0,8,0,0">
                        <!-- Drawn as a console: dark whatever the theme, lines coloured by level
                             (Behaviors/ConsoleLog). Selectable, so lines can be copied. -->
                        <Border
                            CornerRadius="4"
                            Padding="8,6"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            Background="{x:Static behaviors:ConsoleLog.Background}">
                            <!-- Style cleared: the themed one repaints the box on focus, and a console doesn't. -->
                            <RichTextBox
                                Style="{x:Null}"
                                Height="300"
                                Padding="0"
                                BorderThickness="0"
                                Background="Transparent"
                                Foreground="#CCCCCC"
                                CaretBrush="Transparent"
                                IsReadOnly="True"
                                IsReadOnlyCaretVisible="False"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="12"
                                HorizontalScrollBarVisibility="Auto"
                                VerticalScrollBarVisibility="Auto"
                                behaviors:ConsoleLog.Lines="{Binding ServerLogLines}" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <ui:Button
                                Content="{loc:Str Play_ServerLogOpenFolder}"
                                Icon="{ui:SymbolIcon FolderOpen24}"
                                Command="{Binding OpenServerLogFolderCommand}" />
                            <TextBlock
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                Text="{Binding ServerLogPath}" />
                        </StackPanel>
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ui:Card>

        <!-- OPEN-12 F20, experimental and off by default: Play starts the server and the game itself
             (SptDirectLaunch). On an SPT version it was not made for, the card says so and the
             launcher card below is the way in. -->
        <ui:Card
            Padding="16"
            VerticalAlignment="Top"
            Margin="0,16,0,0"
            Visibility="{Binding IsDirectLaunchEnabled, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock
                    Text="{loc:Str Play_DirectHeader}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Margin="0,0,0,4" />

                <TextBlock
                    Margin="0,0,0,8"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    Text="{Binding DirectLaunchUnavailable}"
                    Visibility="{Binding DirectLaunchUnavailable, Converter={StaticResource NullToCollapsed}}" />

                <StackPanel Visibility="{Binding IsDirectLaunchOn, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Margin="0,0,0,10"
                        ToolTip="{loc:Str Play_DirectDescription}"
                        ToolTipService.ShowDuration="30000"
                        Text="{loc:Str Play_DirectSummary}" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox
                            MinWidth="320"
                            ItemsSource="{Binding Profiles}"
                            SelectedItem="{Binding SelectedProfile}"
                            IsEnabled="{Binding IsPlaying, Converter={StaticResource Inverse}}"
                            ToolTip="{loc:Str Play_DirectProfileToolTip}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Detail}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ui:Button
                            Margin="10,0,0,0"
                            MinWidth="120"
                            VerticalAlignment="Stretch"
                            Appearance="Primary"
                            FontWeight="SemiBold"
                            Content="{loc:Str Play_DirectPlay}"
                            Icon="{ui:SymbolIcon Play24}"
                            ToolTip="{loc:Str Play_DirectPlayToolTip}"
                            Command="{Binding PlayCommand}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            VerticalAlignment="Stretch"
                            Icon="{ui:SymbolIcon MoreHorizontal24}"
                            ToolTip="{loc:Str Play_DirectMoreToolTip}"
                            Click="DirectMore_Click" />
                        <ui:Button
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Appearance="Transparent"
                            Content="{loc:Str Common_Cancel}"
                            Command="{Binding CancelPlayCommand}"
                            Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <!-- What Play is doing, or why it stopped. -->
                    <StackPanel Margin="0,0,0,8" Visibility="{Binding PlayStatus, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock TextWrapping="Wrap" Text="{Binding PlayStatus}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PlayStatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ProgressBar
                            Height="4"
                            Margin="0,6,0,0"
                            Width="500"
                            HorizontalAlignment="Left"
                            Minimum="0"
                            Maximum="100"
                            Value="{Binding PlayProgress, Mode=OneWay, TargetNullValue=0}"
                            Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                    <Setter Property="IsIndeterminate" Value="False" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PlayProgress}" Value="{x:Null}">
                                            <Setter Property="IsIndeterminate" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                    </StackPanel>

                    <TextBlock
                        Margin="0,0,0,8"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Text="{Binding WipeWarning}"
                        Visibility="{Binding WipeWarning, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock
                        Margin="0,0,0,8"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Text="{Binding DirectLaunchUntested}"
                        Visibility="{Binding DirectLaunchUntested, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock
                        Margin="0,0,0,8"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{loc:Str Play_DirectNoProfiles}"
                        Visibility="{Binding HasNoProfiles, Converter={StaticResource BoolToVisibility}}" />

                    <!-- New profile, on the card. -->
                    <Border
                        Margin="0,0,0,8"
                        Padding="12"
                        CornerRadius="4"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        Visibility="{Binding ShowNewProfile, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Margin="0,0,0,8" Text="{loc:Str Play_DirectNewProfileHeader}" />
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBox
                                    MinWidth="220"
                                    PlaceholderText="{loc:Str Play_DirectNewProfileName}"
                                    Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox
                                    Margin="8,0,0,0"
                                    MinWidth="220"
                                    ItemsSource="{Binding Editions}"
                                    SelectedItem="{Binding SelectedEdition}"
                                    DisplayMemberPath="Key"
                                    ToolTip="{Binding SelectedEdition.Value}" />
                                <ui:Button
                                    Margin="8,0,0,0"
                                    Appearance="Primary"
                                    Content="{loc:Str Play_DirectCreateProfile}"
                                    Command="{Binding CreateProfileCommand}" />
                                <ui:Button
                                    Margin="8,0,0,0"
                                    Appearance="Transparent"
                                    Content="{loc:Str Common_Cancel}"
                                    Command="{Binding CancelNewProfileCommand}" />
                            </StackPanel>
                            <TextBlock
                                Margin="0,8,0,0"
                                TextWrapping="Wrap"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding SelectedEdition.Value}" />
                        </StackPanel>
                    </Border>

                    <!-- Delete profile, asked on the card. -->
                    <StackPanel Margin="0,0,0,8" Visibility="{Binding ConfirmingDeleteProfile, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            TextWrapping="Wrap"
                            Margin="0,0,0,8"
                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                            Text="{Binding DeleteProfileWarning}" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button
                                Appearance="Danger"
                                Content="{loc:Str Play_DirectDeleteConfirm}"
                                Icon="{ui:SymbolIcon Delete24}"
                                Command="{Binding ConfirmDeleteProfileCommand}" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Appearance="Transparent"
                                Content="{loc:Str Common_Cancel}"
                                Command="{Binding CancelDeleteProfileCommand}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <ui:Card Padding="16" VerticalAlignment="Top" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock
                    Text="{loc:Str Play_LauncherHeader}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="{loc:Str Play_LauncherDescription}" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:Button
                        Appearance="Primary"
                        Content="{loc:Str Play_OpenLauncher}"
                        Icon="{ui:SymbolIcon Play24}"
                        IsEnabled="{Binding CanStartClient}"
                        Command="{Binding StartClientCommand}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Content="{loc:Str Play_CloseGame}"
                        Icon="{ui:SymbolIcon Dismiss24}"
                        ToolTip="{loc:Str Play_CloseGameToolTip}"
                        IsEnabled="{Binding CanCloseGame}"
                        Command="{Binding AskCloseGameCommand}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding ClientState}" />
                </StackPanel>

                <StackPanel
                    Margin="0,0,0,8"
                    Visibility="{Binding ConfirmingCloseGame, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        TextWrapping="Wrap"
                        Margin="0,0,0,8"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Text="{loc:Str Play_CloseGameWarning}" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button
                            Appearance="Danger"
                            Content="{loc:Str Play_CloseGameConfirm}"
                            Icon="{ui:SymbolIcon Dismiss24}"
                            Command="{Binding ConfirmCloseGameCommand}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Appearance="Transparent"
                            Content="{loc:Str Common_Cancel}"
                            Command="{Binding CancelCloseGameCommand}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding ClientPath}" />

                <CheckBox
                    Margin="0,8,0,0"
                    Content="{loc:Str Play_CloseGameWithServer}"
                    ToolTip="{loc:Str Play_CloseGameWithServerToolTip}"
                    ToolTipService.ShowDuration="20000"
                    IsChecked="{Binding CloseGameWithServer}" />
            </StackPanel>
        </ui:Card>

        <!-- Mod tools - every .exe an installed mod put in the SPT folder, found by itself
             (ModTools). Shown while there is anything to list, hidden tools included. -->
        <ui:Card
            Padding="16"
            VerticalAlignment="Top"
            Margin="0,16,0,0"
            Visibility="{Binding HasTools, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock
                    Text="{loc:Str Play_ToolsHeader}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="{loc:Str Play_ToolsDescription}" />

                <ItemsControl Focusable="False" ItemsSource="{Binding Tools}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                x:Name="ToolRow"
                                Margin="0,0,0,6"
                                Padding="10,8"
                                CornerRadius="4"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                                <DockPanel>
                                    <!-- Open, the folder, and Hide (or Show on Play while it is hidden). -->
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Button
                                            Margin="0,0,6,0"
                                            Content="{loc:Str Play_StartServer}"
                                            Icon="{ui:SymbolIcon Play24}"
                                            Command="{Binding DataContext.StartServerCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            Visibility="{Binding ShowStartServer, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:Button
                                            Appearance="Primary"
                                            Content="{loc:Str Play_ToolOpen}"
                                            Icon="{ui:SymbolIcon Open24}"
                                            ToolTip="{loc:Str Play_ToolOpenToolTip}"
                                            IsEnabled="{Binding CanOpen}"
                                            Command="{Binding DataContext.OpenToolCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}" />
                                        <ui:Button
                                            Margin="6,0,0,0"
                                            Padding="8,6"
                                            Icon="{ui:SymbolIcon Folder24}"
                                            ToolTip="{loc:Str Play_ToolFolderToolTip}"
                                            Command="{Binding DataContext.OpenToolFolderCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}" />
                                        <ui:Button
                                            Margin="6,0,0,0"
                                            Appearance="Transparent"
                                            Content="{loc:Str Play_ToolHide}"
                                            ToolTip="{loc:Str Play_ToolHideToolTip}"
                                            Command="{Binding DataContext.HideToolCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsHidden, Converter={StaticResource FalseToVisible}}" />
                                        <ui:Button
                                            Margin="6,0,0,0"
                                            Appearance="Transparent"
                                            Content="{loc:Str Play_ToolUnhide}"
                                            Command="{Binding DataContext.UnhideToolCommand, RelativeSource={RelativeSource AncestorType=Page}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsHidden, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>

                                    <!-- The tool's own icon, or a plain tool symbol when it has none. -->
                                    <Grid Width="32" Height="32" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <Image Source="{Binding Icon}" Width="32" Height="32" Visibility="{Binding HasIcon, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:SymbolIcon FontSize="24" Symbol="Wrench24" Visibility="{Binding HasIcon, Converter={StaticResource FalseToVisible}}" />
                                    </Grid>

                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Name}" />
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding FromText}" />
                                        <TextBlock
                                            x:Name="Note"
                                            FontSize="12"
                                            TextWrapping="Wrap"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Note}"
                                            Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock
                                            FontSize="12"
                                            TextWrapping="Wrap"
                                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                            Text="{Binding DisabledText}"
                                            Visibility="{Binding DisabledText, Converter={StaticResource NullToCollapsed}}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding NoteIsCaution}" Value="True">
                                    <Setter TargetName="Note" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CanOpen}" Value="False">
                                    <Setter TargetName="ToolRow" Property="Opacity" Value="0.6" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                    <Setter TargetName="ToolRow" Property="Opacity" Value="0.6" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Show the hidden ones, or hide them again. -->
                <ui:Button
                    Appearance="Transparent"
                    HorizontalAlignment="Left"
                    Content="{Binding ShowHiddenToolsText}"
                    Command="{Binding ToggleHiddenToolsCommand}"
                    Visibility="{Binding HasHiddenTools, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ui:Card>

        <!-- Only an install running a headless client has this launcher - or has been told in
             Options that it is one - so the card is off the page entirely on every other one
             rather than showing a dead button. -->
        <ui:Card
            Padding="16"
            VerticalAlignment="Top"
            Margin="0,16,0,0"
            Visibility="{Binding HasHeadless, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock
                    Text="{loc:Str Play_HeadlessHeader}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="{loc:Str Play_HeadlessDescription}" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:Button
                        Content="{loc:Str Play_OpenHeadless}"
                        Icon="{ui:SymbolIcon Play24}"
                        IsEnabled="{Binding CanStartHeadless}"
                        Command="{Binding StartHeadlessCommand}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Content="{loc:Str Play_Restart}"
                        Icon="{ui:SymbolIcon ArrowSync24}"
                        ToolTip="{loc:Str Play_RestartHeadlessToolTip}"
                        Command="{Binding AskRestartHeadlessCommand}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding HeadlessState}" />
                </StackPanel>

                <StackPanel
                    Margin="0,0,0,8"
                    Visibility="{Binding ConfirmingHeadlessRestart, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        TextWrapping="Wrap"
                        Margin="0,0,0,8"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Text="{loc:Str Play_RestartHeadlessWarning}" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button
                            Appearance="Danger"
                            Content="{loc:Str Play_RestartHeadlessConfirm}"
                            Icon="{ui:SymbolIcon ArrowSync24}"
                            Command="{Binding ConfirmRestartCommand}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Appearance="Transparent"
                            Content="{loc:Str Common_Cancel}"
                            Command="{Binding CancelRestartCommand}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding HeadlessPath}" />

                <!-- What Options has been told this machine is, since that is what decides which
                     mods a served list brings here. Blank, and so zero height, on an install that
                     has not said. -->
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,8,0,0"
                    Text="{Binding RoleSummary}" />

                <!--
                    The launcher is here but nobody has answered the question, so a served list is
                    being filtered as though this were an ordinary player.
                    The setup prompt fires when the install folder is set, which somebody who set
                    theirs months ago will never do again - this is how they find out there is
                    something to answer.
                -->
                <ui:InfoBar
                    Margin="0,12,0,0"
                    IsOpen="True"
                    IsClosable="False"
                    Severity="Informational"
                    Title="{loc:Str Play_RoleNoticeTitle}"
                    Message="{loc:Str Play_RoleNoticeMessage}"
                    Visibility="{Binding NeedsRoleAnswer, Converter={StaticResource BoolToVisibility}}" />
                <!-- The answer to the notice above, in Help (Help S5). -->
                <ui:Button
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    Content="{loc:Str Help_ShowMeHow}"
                    Icon="{ui:SymbolIcon BookQuestionMark24}"
                    Click="RoleShowMeHow_Click"
                    Visibility="{Binding NeedsRoleAnswer, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </ui:Card>

        <ui:Card
            Padding="16"
            VerticalAlignment="Top"
            Margin="0,16,0,0"
            Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
            <TextBlock
                TextWrapping="Wrap"
                Style="{StaticResource ErrorText}"
                Text="{Binding Message}" />
        </ui:Card>

    </StackPanel>
</Page>
