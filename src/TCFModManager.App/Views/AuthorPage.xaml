<!--
    OPEN-12 A4 (R22): an sp-mod author's page. Opened from any author name - Browse cards, Installed,
    a mod's details, the right-click menu - and not from the sidebar, so Back returns to where it was
    opened. Everything on it comes from the cached catalog and addon list.

    ScrollViewer.CanContentScroll="False" opts out of WPF-UI's outer wrapper, as the other pages do:
    the ScrollViewer below is the page's own.
-->
<Page
    x:Class="TCFModManager.App.Views.AuthorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    xmlns:behaviors="clr-namespace:TCFModManager.App.Behaviors"
    xmlns:markup="clr-namespace:TCFModManager.App.Behaviors.Markup"
    Title="{loc:Str Author_Title}"
    Loaded="AuthorPage_Loaded"
    ScrollViewer.CanContentScroll="False">
    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:NullToVisibilityConverter x:Key="NullToCollapsed" />
    </Page.Resources>

    <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <!-- The cover, when the author has one, behind the header. -->
            <Border
                Height="150"
                CornerRadius="8"
                ClipToBounds="True"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                Visibility="{Binding CoverUrl, Converter={StaticResource NullToCollapsed}}">
                <markup:RemotePicture
                    LimitToNaturalSize="False"
                    Stretch="UniformToFill"
                    StretchDirection="Both"
                    Url="{Binding CoverUrl}" />
            </Border>

            <DockPanel Margin="0,12,0,16">
                <Border
                    DockPanel.Dock="Left"
                    Width="72"
                    Height="72"
                    Margin="0,0,16,0"
                    CornerRadius="36"
                    ClipToBounds="True"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                    <Border.Clip>
                        <EllipseGeometry Center="36,36" RadiusX="36" RadiusY="36" />
                    </Border.Clip>
                    <markup:RemotePicture
                        LimitToNaturalSize="False"
                        Stretch="UniformToFill"
                        StretchDirection="Both"
                        Url="{Binding AvatarUrl}" />
                </Border>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button
                        Margin="0,0,8,0"
                        Appearance="Primary"
                        Content="{Binding FollowLabel}"
                        Icon="{ui:SymbolIcon PersonAdd24}"
                        ToolTip="{loc:Str Author_FollowToolTip}"
                        Command="{Binding ToggleFollowCommand}" />
                    <ui:Button
                        Content="{loc:Str Author_OpenOnSite}"
                        Icon="{ui:SymbolIcon Open24}"
                        Command="{Binding OpenOnSiteCommand}" />
                </StackPanel>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontSize="24"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding Name}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding CountsLabel}" />
                </StackPanel>
            </DockPanel>

            <TextBlock
                Margin="0,0,0,12"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding StatusMessage}"
                Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsed}}" />

            <ui:ProgressRing
                Width="32"
                Height="32"
                Margin="0,24"
                HorizontalAlignment="Center"
                IsIndeterminate="True"
                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" />

            <!-- Their mods, newest first. A click opens the mod's details, as on Browse. -->
            <TextBlock
                Margin="0,0,0,8"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{loc:Str Author_ModsHeader}" />
            <ItemsControl Focusable="False" ItemsSource="{Binding Mods}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,4"
                            Padding="8"
                            Style="{StaticResource ClickableCardRow}"
                            ToolTip="{loc:Str Author_OpenModToolTip}"
                            MouseLeftButtonUp="ModRow_MouseLeftButtonUp">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Image
                                    Grid.Column="0"
                                    Width="48"
                                    Height="48"
                                    Margin="0,0,12,0"
                                    Stretch="UniformToFill"
                                    behaviors:ThumbnailLoader.Source="{Binding Thumbnail}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        FontSize="12"
                                        TextTrimming="CharacterEllipsis"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Teaser}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock
                                        HorizontalAlignment="Right"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Text="{Binding Published}" />
                                    <Border
                                        Margin="0,4,0,0"
                                        Padding="8,2"
                                        HorizontalAlignment="Right"
                                        CornerRadius="3"
                                        Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                                        Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                        <TextBlock
                                            FontSize="10"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource SystemFillColorSuccessBrush}"
                                            Text="{loc:Str Author_InstalledTag}" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Their addons, each with the mod it belongs to; a click opens the addon's sp-mod page. -->
            <TextBlock
                Margin="0,16,0,8"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{loc:Str Author_AddonsHeader}"
                Visibility="{Binding HasAddons, Converter={StaticResource BoolToVis}}" />
            <ItemsControl Focusable="False" ItemsSource="{Binding Addons}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border
                            Margin="0,0,0,4"
                            Padding="8"
                            Style="{StaticResource ClickableCardRow}"
                            ToolTip="{loc:Str Author_OpenAddonToolTip}"
                            MouseLeftButtonUp="AddonRow_MouseLeftButtonUp">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Image
                                    Grid.Column="0"
                                    Width="40"
                                    Height="40"
                                    Margin="0,0,12,0"
                                    Stretch="UniformToFill"
                                    behaviors:ThumbnailLoader.Source="{Binding Thumbnail}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding ForMod}"
                                        Visibility="{Binding ForMod, Converter={StaticResource NullToCollapsed}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
