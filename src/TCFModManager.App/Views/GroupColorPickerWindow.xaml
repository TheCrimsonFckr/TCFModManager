<ui:FluentWindow
    x:Class="TCFModManager.App.Views.GroupColorPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    Width="460"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    ExtendsContentIntoTitleBar="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="WindowTitleBar"
            Grid.Row="0"
            ShowMinimize="False"
            ShowMaximize="False" />

        <ItemsControl x:Name="ColorList" Grid.Row="1" Margin="24,12,24,6" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <ui:Button
                        Width="48"
                        Height="48"
                        Margin="0,0,6,6"
                        Padding="0"
                        Appearance="{Binding Appearance}"
                        ToolTip="{Binding Name}"
                        Tag="{Binding Key}"
                        Click="Color_Click">
                        <Grid Width="24" Height="24">
                            <Ellipse Fill="{Binding Brush}" />
                            <Ellipse
                                x:Name="NoColorRing"
                                Stroke="{DynamicResource TextFillColorTertiaryBrush}"
                                StrokeThickness="1.5"
                                StrokeDashArray="2 1.5"
                                Visibility="Collapsed" />
                        </Grid>
                    </ui:Button>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsNone}" Value="True">
                            <Setter TargetName="NoColorRing" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <WrapPanel Grid.Row="2" Style="{StaticResource DialogButtonBar}">
            <ui:Button
                Style="{StaticResource DialogButton}"
                IsCancel="True"
                Content="{loc:Str Common_Cancel}" />
        </WrapPanel>
    </Grid>
</ui:FluentWindow>
