<ui:FluentWindow
    x:Class="TCFModManager.App.Views.ReadModPageConfirmationWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    Width="440"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    ExtendsContentIntoTitleBar="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">
    <!--
        A plain modal FluentWindow, shown via ShowDialog() from any call site.
        SizeToContent="Height" with a fixed Width keeps a consistent size regardless of content length.
        Lists one row per mod page that must be opened before Continue unlocks.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="WindowTitleBar"
            Grid.Row="0"
            Title="{loc:Str ReadModPage_Title}"
            ShowMinimize="False"
            ShowMaximize="False" />

        <StackPanel
            Grid.Row="1"
            Margin="24,12,24,0">
            <TextBlock
                Style="{StaticResource DialogText}"
                x:Name="IntroText"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Margin="0,0,0,16"
                Text="{loc:Str ReadModPage_OpenFirst}" />

            <!-- Shown only for a batch too long to open a page at a time. -->
            <StackPanel x:Name="BatchBar" Margin="0,0,0,16" Visibility="Collapsed">
                <TextBlock
                    Style="{StaticResource DialogText}"
                    x:Name="BatchProgress"
                    TextWrapping="Wrap"
                    Margin="0,0,0,8"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                <WrapPanel>
                    <ui:Button
                        x:Name="OpenBatchButton"
                        Margin="0,0,8,0"
                        Icon="{ui:SymbolIcon Open24}"
                        Click="OpenBatchButton_Click" />

                    <ui:Button
                        x:Name="SkipOpeningButton"
                        Content="{loc:Str ReadModPage_SkipOpening}"
                        Click="SkipOpeningButton_Click" />
                </WrapPanel>
            </StackPanel>

            <ScrollViewer
                MaxHeight="320"
                VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="LinksList" Margin="0,0,0,-10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    TextWrapping="Wrap"
                                    Margin="0,0,12,0"
                                    Text="{Binding Name}" />

                                <ui:Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    IsEnabled="{Binding HasUrl}"
                                    Content="{Binding ButtonLabel}"
                                    Icon="{ui:SymbolIcon Open24}"
                                    Click="OpenLinkButton_Click" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>

        <WrapPanel Grid.Row="2" Style="{StaticResource DialogButtonBar}">
            <ui:Button
                Style="{StaticResource DialogButton}"
                IsCancel="True"
                Content="{loc:Str Common_Cancel}"
                Click="CancelButton_Click" />

            <ui:Button
                x:Name="ContinueButton"
                Style="{StaticResource DialogButton}"
                Appearance="Primary"
                IsDefault="True"
                IsEnabled="False"
                Content="{loc:Str Common_Continue}"
                Click="ContinueButton_Click" />
        </WrapPanel>
    </Grid>
</ui:FluentWindow>
