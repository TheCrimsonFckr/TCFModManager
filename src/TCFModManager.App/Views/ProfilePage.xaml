<Page
    x:Class="TCFModManager.App.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    xmlns:play="clr-namespace:TCFModManager.App.Views.Play"
    Title="{loc:Str Nav_Profile}">
    <StackPanel x:Name="Root" Margin="16">

        <play:InstallWarningCards />

        <play:BeforeYouJoinCard />

        <play:PlayCard />

        <play:ProfileStatsCard />

        <play:GameLauncherCard />

        <play:MessageCard />

    </StackPanel>
</Page>
