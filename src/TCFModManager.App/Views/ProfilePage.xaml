<Page
    x:Class="TCFModManager.App.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
    xmlns:app="clr-namespace:TCFModManager.App"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    Title="{loc:Str Nav_Profile}">
    <Page.Resources>
        <controls:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:NullToVisibilityConverter x:Key="NullToCollapsed" />
        <converters:InverseBooleanConverter x:Key="Inverse" />
        <converters:FalseToVisibilityConverter x:Key="FalseToVisible" />
        <ItemsPanelTemplate x:Key="StatCells">
            <WrapPanel />
        </ItemsPanelTemplate>
        <DataTemplate x:Key="StatCell">
            <Border
                Width="170"
                Margin="0,8,8,0"
                Padding="10,8"
                CornerRadius="{DynamicResource ControlCornerRadius}"
                Background="{DynamicResource ControlFillColorDefaultBrush}">
                <StackPanel>
                    <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Label}" ToolTip="{Binding Label}" />
                    <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Text="{Binding Value}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </Page.Resources>
    <StackPanel x:Name="Root" Margin="16">

        <!-- OPEN-23 R4: SPT would load no server mods. Shown only then, and never a gate. -->
        <ui:Card
            Padding="16"
            VerticalAlignment="Top"
            Margin="0,0,0,16"
            Visibility="{Binding InstallWideWarning, Converter={StaticResource NullToCollapsed}}">
            <StackPanel>
                <ui:Button
                    Padding="0"
                    HorizontalContentAlignment="Left"
                    Appearance="Transparent"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                    Icon="{ui:SymbolIcon ErrorCircle20}"
                    Command="{Binding ShowConflictsCommand}">
                    <TextBlock TextWrapping="Wrap" Text="{Binding InstallWideWarning}" />
                </ui:Button>
                <TextBlock
                    Margin="0,4,0,0"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{loc:Str Play_InstallWideHint}" />
            </StackPanel>
        </ui:Card>

        <!-- OPEN-13 R4: installed mods not for this SPT (or for Fika). A note, never a gate. -->
        <ui:Card
            Padding="16"
            VerticalAlignment="Top"
            Margin="0,0,0,16"
            Visibility="{Binding NotForSptWarning, Converter={StaticResource NullToCollapsed}}">
            <StackPanel>
                <ui:Button
                    Padding="0"
                    HorizontalContentAlignment="Left"
                    Appearance="Transparent"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    Icon="{ui:SymbolIcon Warning20}"
                    Command="{Binding ShowNotForSptCommand}">
                    <TextBlock TextWrapping="Wrap" Text="{Binding NotForSptWarning}" />
                </ui:Button>
                <TextBlock
                    Margin="0,4,0,0"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{loc:Str Play_NotForSptHint}" />
            </StackPanel>
        </ui:Card>

        <!-- Conflicts in this install (OPEN-11 R4): shown only when there are any, and never a gate. -->
        <ui:Card
            Padding="16"
            VerticalAlignment="Top"
            Margin="0,0,0,16"
            Visibility="{Binding ConflictWarning, Converter={StaticResource NullToCollapsed}}">
            <StackPanel>
                <ui:Button
                    Padding="0"
                    Appearance="Transparent"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                    Icon="{ui:SymbolIcon ErrorCircle20}"
                    Content="{Binding ConflictWarning}"
                    Command="{Binding ShowConflictsCommand}" />
                <TextBlock
                    Margin="0,4,0,0"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{loc:Str Play_ConflictsHint}" />
            </StackPanel>
        </ui:Card>

        <!--
            The pre-launch check, above the buttons because that is the order it matters in.
            Hidden entirely unless a server is set up, so an install that plays alone never sees it.

            It never blocks a launch. It replaces a BepInEx plugin that spoke at the splash screen -
            the honest moment, seconds before joining - and the reason that plugin was dropped was
            containment, not that warning people was wrong. What it must not become is a gate: the
            mods it compares may not matter, the server may be wrong, and a raid held up by a
            warning nobody can override is worse than a version mismatch.
        -->
        <ui:Card
            Padding="16"
            VerticalAlignment="Top"
            Margin="0,0,0,16"
            DataContext="{x:Static app:AppServices.PreLaunchCheck}"
            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <ui:SymbolIcon
                        Symbol="Connected20"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding Title}" />
                    <ProgressBar
                        Width="60"
                        Height="4"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        IsIndeterminate="True"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Message}" />

                <!-- Named, not counted. "Three mods behind" is not something anyone can act on;
                     the names are, and they are what you check against what the server runs. -->
                <TextBlock
                    Margin="0,8,0,0"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding Outstanding}"
                    Visibility="{Binding HasOutstanding, Converter={StaticResource BoolToVisibility}}" />

                <!-- Review and install only when behind a list a server served: it opens Mod lists
                     with that list previewed, and installing is still the Apply there. -->
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Button
                        Appearance="Primary"
                        Margin="0,0,8,0"
                        Content="{loc:Str Common_ReviewAndInstall}"
                        Icon="{ui:SymbolIcon ArrowDownload24}"
                        ToolTip="{loc:Str Common_ReviewAndInstallToolTip}"
                        Command="{Binding ReviewCommand}"
                        Visibility="{Binding CanReview, Converter={StaticResource BoolToVisibility}}" />
                    <ui:Button
                        Content="{loc:Str Play_CheckAgain}"
                        Icon="{ui:SymbolIcon ArrowSync24}"
                        Command="{Binding CheckCommand}" />
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <!-- OPEN-12 F20, experimental and off by default: Play starts the server and the game itself
             (SptDirectLaunch). On an SPT version it was not made for, the card says so and the
             launcher card below is the way in. -->
        <ui:Card
            Padding="16"
            VerticalAlignment="Top"
            Margin="0,0,0,16"
            Visibility="{Binding IsDirectLaunchEnabled, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock
                    Text="{loc:Str Play_DirectHeader}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Margin="0,0,0,4" />

                <TextBlock
                    Margin="0,0,0,8"
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    Text="{Binding DirectLaunchUnavailable}"
                    Visibility="{Binding DirectLaunchUnavailable, Converter={StaticResource NullToCollapsed}}" />

                <StackPanel Visibility="{Binding IsDirectLaunchOn, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Margin="0,0,0,10"
                        ToolTip="{loc:Str Play_DirectDescription}"
                        ToolTipService.ShowDuration="30000"
                        Text="{loc:Str Play_DirectSummary}" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <ComboBox
                            MinWidth="320"
                            ItemsSource="{Binding Profiles}"
                            SelectedItem="{Binding SelectedProfile}"
                            IsEnabled="{Binding IsPlaying, Converter={StaticResource Inverse}}"
                            ToolTip="{loc:Str Play_DirectProfileToolTip}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Detail}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ui:Button
                            Margin="10,0,0,0"
                            MinWidth="120"
                            VerticalAlignment="Stretch"
                            Appearance="Primary"
                            FontWeight="SemiBold"
                            Content="{loc:Str Play_DirectPlay}"
                            Icon="{ui:SymbolIcon Play24}"
                            ToolTip="{loc:Str Play_DirectPlayToolTip}"
                            Command="{Binding PlayCommand}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            VerticalAlignment="Stretch"
                            Icon="{ui:SymbolIcon MoreHorizontal24}"
                            ToolTip="{loc:Str Play_DirectMoreToolTip}"
                            Click="DirectMore_Click" />
                        <ui:Button
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Appearance="Transparent"
                            Content="{loc:Str Common_Cancel}"
                            Command="{Binding CancelPlayCommand}"
                            Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <!-- What Play is doing, or why it stopped. -->
                    <StackPanel Margin="0,0,0,8" Visibility="{Binding PlayStatus, Converter={StaticResource NullToCollapsed}}">
                        <TextBlock TextWrapping="Wrap" Text="{Binding PlayStatus}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PlayStatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ProgressBar
                            Height="4"
                            Margin="0,6,0,0"
                            Width="500"
                            HorizontalAlignment="Left"
                            Minimum="0"
                            Maximum="100"
                            Value="{Binding PlayProgress, Mode=OneWay, TargetNullValue=0}"
                            Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
                                    <Setter Property="IsIndeterminate" Value="False" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PlayProgress}" Value="{x:Null}">
                                            <Setter Property="IsIndeterminate" Value="True" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <ui:Button
                            Margin="0,8,0,0"
                            Content="{loc:Str Play_DirectShowServerLog}"
                            Icon="{ui:SymbolIcon Server24}"
                            Command="{Binding ShowServerLogOnServerCommand}"
                            Visibility="{Binding OfferServerLog, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>

                    <TextBlock
                        Margin="0,0,0,8"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Text="{Binding WipeWarning}"
                        Visibility="{Binding WipeWarning, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock
                        Margin="0,0,0,8"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Text="{Binding DirectLaunchUntested}"
                        Visibility="{Binding DirectLaunchUntested, Converter={StaticResource NullToCollapsed}}" />
                    <TextBlock
                        Margin="0,0,0,8"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{loc:Str Play_DirectNoProfiles}"
                        Visibility="{Binding HasNoProfiles, Converter={StaticResource BoolToVisibility}}" />

                    <!-- New profile, on the card. -->
                    <Border
                        Margin="0,0,0,8"
                        Padding="12"
                        CornerRadius="{DynamicResource ControlCornerRadius}"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        Visibility="{Binding ShowNewProfile, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Margin="0,0,0,8" Text="{loc:Str Play_DirectNewProfileHeader}" />
                            <StackPanel Orientation="Horizontal">
                                <ui:TextBox
                                    MinWidth="220"
                                    PlaceholderText="{loc:Str Play_DirectNewProfileName}"
                                    Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox
                                    Margin="8,0,0,0"
                                    MinWidth="220"
                                    ItemsSource="{Binding Editions}"
                                    SelectedItem="{Binding SelectedEdition}"
                                    DisplayMemberPath="Key"
                                    ToolTip="{Binding SelectedEdition.Value}" />
                                <ui:Button
                                    Margin="8,0,0,0"
                                    Appearance="Primary"
                                    Content="{loc:Str Play_DirectCreateProfile}"
                                    Command="{Binding CreateProfileCommand}" />
                                <ui:Button
                                    Margin="8,0,0,0"
                                    Appearance="Transparent"
                                    Content="{loc:Str Common_Cancel}"
                                    Command="{Binding CancelNewProfileCommand}" />
                            </StackPanel>
                            <TextBlock
                                Margin="0,8,0,0"
                                TextWrapping="Wrap"
                                FontSize="12"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding SelectedEdition.Value}" />
                        </StackPanel>
                    </Border>

                    <!-- Delete profile, asked on the card. -->
                    <StackPanel Margin="0,0,0,8" Visibility="{Binding ConfirmingDeleteProfile, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock
                            TextWrapping="Wrap"
                            Margin="0,0,0,8"
                            Foreground="{DynamicResource SystemFillColorCautionBrush}"
                            Text="{Binding DeleteProfileWarning}" />
                        <StackPanel Orientation="Horizontal">
                            <ui:Button
                                Appearance="Danger"
                                Content="{loc:Str Play_DirectDeleteConfirm}"
                                Icon="{ui:SymbolIcon Delete24}"
                                Command="{Binding ConfirmDeleteProfileCommand}" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Appearance="Transparent"
                                Content="{loc:Str Common_Cancel}"
                                Command="{Binding CancelDeleteProfileCommand}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <!-- OPEN-27: the picked profile, as SPT's launcher shows it on its profile page. -->
        <ui:Card
            Padding="16"
            VerticalAlignment="Top"
            Margin="0,0,0,16"
            Visibility="{Binding HasProfileStatsCard, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock
                    Text="{loc:Str Profile_StatsHeader}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Margin="0,0,0,8" />

                <ComboBox
                    MinWidth="320"
                    Margin="0,0,0,12"
                    HorizontalAlignment="Left"
                    ItemsSource="{Binding Profiles}"
                    SelectedItem="{Binding SelectedProfile}"
                    ToolTip="{loc:Str Profile_StatsPickerToolTip}"
                    Visibility="{Binding IsDirectLaunchOn, Converter={StaticResource FalseToVisible}}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" />
                                <TextBlock FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{Binding Detail}" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{loc:Str Profile_NewCharacter}"
                    Visibility="{Binding ProfileIsNew, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    Text="{loc:Str Profile_StatsUnreadable}"
                    Visibility="{Binding StatsUnreadable, Converter={StaticResource BoolToVisibility}}" />

                <StackPanel Visibility="{Binding ProfileStats, Converter={StaticResource NullToCollapsed}}">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding ProfileStats.Name}" />
                            <TextBlock
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding ProfileStats.Detail}" />
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                    Text="{Binding ProfileStats.ProfileId}" />
                                <ui:Button
                                    Margin="4,0,0,0"
                                    Padding="6,3"
                                    Appearance="Transparent"
                                    ToolTip="{loc:Str Profile_CopyIdToolTip}"
                                    Command="{Binding CopyProfileIdCommand}">
                                    <ui:Button.Style>
                                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                                            <Setter Property="Icon" Value="{ui:SymbolIcon Copy24}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ProfileIdCopied}" Value="True">
                                                    <Setter Property="Icon" Value="{ui:SymbolIcon Checkmark24}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </StackPanel>
                        </StackPanel>

                        <Grid Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="₽" />
                            <TextBlock Grid.Row="0" Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding ProfileStats.Roubles}" />
                            <TextBlock Grid.Row="1" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="$" />
                            <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding ProfileStats.Dollars}" />
                            <TextBlock Grid.Row="2" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="€" />
                            <TextBlock Grid.Row="2" Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding ProfileStats.Euros}" />
                            <TextBlock Grid.Row="3" Margin="0,0,8,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="{loc:Str Profile_Gp}" />
                            <TextBlock Grid.Row="3" Grid.Column="1" HorizontalAlignment="Right" FontWeight="SemiBold" Text="{Binding ProfileStats.Gp}" />
                        </Grid>
                    </Grid>

                    <StackPanel Margin="0,0,0,12" Background="Transparent" ToolTip="{Binding ProfileStats.LevelSourceToolTip}">
                        <DockPanel>
                            <TextBlock
                                DockPanel.Dock="Left"
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding ProfileStats.LevelText}" />
                            <TextBlock
                                DockPanel.Dock="Right"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding ProfileStats.ToNextText}"
                                Visibility="{Binding ProfileStats.HasProgress, Converter={StaticResource BoolToVisibility}}" />
                            <ProgressBar
                                Height="6"
                                Margin="12,0"
                                VerticalAlignment="Center"
                                Minimum="0"
                                Maximum="100"
                                Value="{Binding ProfileStats.LevelPercent, Mode=OneWay}"
                                Visibility="{Binding ProfileStats.HasProgress, Converter={StaticResource BoolToVisibility}}" />
                        </DockPanel>
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                            Text="{Binding ProfileStats.ExperienceText}" />
                    </StackPanel>

                    <TabControl SelectedIndex="{Binding StatsTab}">
                        <TabItem Header="{loc:Str Profile_TabOverall}">
                            <ItemsControl
                                Focusable="False"
                                ItemsSource="{Binding ProfileStats.OverallRows}"
                                ItemsPanel="{StaticResource StatCells}"
                                ItemTemplate="{StaticResource StatCell}" />
                        </TabItem>
                        <TabItem Header="{loc:Str Profile_TabPmc}">
                            <ItemsControl
                                Focusable="False"
                                ItemsSource="{Binding ProfileStats.PmcRows}"
                                ItemsPanel="{StaticResource StatCells}"
                                ItemTemplate="{StaticResource StatCell}" />
                        </TabItem>
                        <TabItem Header="{loc:Str Profile_TabScav}">
                            <ItemsControl
                                Focusable="False"
                                ItemsSource="{Binding ProfileStats.ScavRows}"
                                ItemsPanel="{StaticResource StatCells}"
                                ItemTemplate="{StaticResource StatCell}" />
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <ui:Card Padding="16" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock
                    Text="{loc:Str Play_LauncherHeader}"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="{loc:Str Play_LauncherDescription}" />

                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:Button
                        Appearance="Primary"
                        Content="{loc:Str Play_OpenLauncher}"
                        Icon="{ui:SymbolIcon Play24}"
                        IsEnabled="{Binding CanStartClient}"
                        Command="{Binding StartClientCommand}" />
                    <ui:Button
                        Margin="8,0,0,0"
                        Content="{loc:Str Play_CloseGame}"
                        Icon="{ui:SymbolIcon Dismiss24}"
                        ToolTip="{loc:Str Play_CloseGameToolTip}"
                        IsEnabled="{Binding CanCloseGame}"
                        Command="{Binding AskCloseGameCommand}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Margin="12,0,0,0"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding ClientState}" />
                </StackPanel>

                <StackPanel
                    Margin="0,0,0,8"
                    Visibility="{Binding ConfirmingCloseGame, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        TextWrapping="Wrap"
                        Margin="0,0,0,8"
                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                        Text="{loc:Str Play_CloseGameWarning}" />
                    <StackPanel Orientation="Horizontal">
                        <ui:Button
                            Appearance="Danger"
                            Content="{loc:Str Play_CloseGameConfirm}"
                            Icon="{ui:SymbolIcon Dismiss24}"
                            Command="{Binding ConfirmCloseGameCommand}" />
                        <ui:Button
                            Margin="8,0,0,0"
                            Appearance="Transparent"
                            Content="{loc:Str Common_Cancel}"
                            Command="{Binding CancelCloseGameCommand}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{Binding ClientPath}" />

                <CheckBox
                    Margin="0,8,0,0"
                    Content="{loc:Str Play_CloseGameWithServer}"
                    ToolTip="{loc:Str Play_CloseGameWithServerToolTip}"
                    ToolTipService.ShowDuration="20000"
                    IsChecked="{Binding CloseGameWithServer}" />
            </StackPanel>
        </ui:Card>

        <ui:Card
            Padding="16"
            VerticalAlignment="Top"
            Margin="0,16,0,0"
            Visibility="{Binding HasMessage, Converter={StaticResource BoolToVisibility}}">
            <TextBlock
                TextWrapping="Wrap"
                Style="{StaticResource ErrorText}"
                Text="{Binding Message}" />
        </ui:Card>

    </StackPanel>
</Page>
