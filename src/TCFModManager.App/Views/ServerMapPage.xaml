<Page
    x:Class="TCFModManager.App.Views.ServerMapPage"
    Loaded="Page_Loaded"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
    xmlns:app="clr-namespace:TCFModManager.App"
    Title="Server map">
    <Page.Resources>
        <controls:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Page.Resources>
    <StackPanel Margin="16" DataContext="{x:Static app:AppServices.ServerMap}">

        <!-- The server's own card, pinned at the top. Client cards will sit under it once the
             registry routes exist; until then this page is honest about being one card, which is
             better than an empty list implying nobody is connected. -->
        <ui:Card Padding="16" VerticalAlignment="Top">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <ui:SymbolIcon
                        Symbol="Connected20"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="{Binding ServerName}" />
                </StackPanel>

                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="{Binding ServerDetail}" />

                <!-- Named to match the shared ErrorText style, which turns this red only when the
                     last attempt actually failed - a server that is simply off is not an error the
                     user did anything to cause. -->
                <TextBlock
                    TextWrapping="Wrap"
                    Style="{StaticResource ErrorText}"
                    Text="{Binding StatusMessage}" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Button
                        Content="Reconnect"
                        Icon="{ui:SymbolIcon Connected20}"
                        Command="{Binding ConnectCommand}" />
                    <ProgressBar
                        Width="80"
                        Height="4"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        IsIndeterminate="True"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <!-- Raised only when the certificate changed, because it is the only state on this page the
             user has to make a decision about. The two fingerprints are in the message itself -
             naming them is the whole point of showing this rather than a generic failure. -->
        <ui:InfoBar
            Margin="0,16,0,0"
            IsClosable="False"
            Severity="Warning"
            Title="This server's certificate has changed"
            Message="{Binding StatusMessage}"
            IsOpen="{Binding HasCertificateChanged, Mode=OneWay}" />

        <!--
            The list this server publishes. Fetched automatically when its revision moves, and saved
            into the user's own mod lists read-only.

            Saving is not applying, and the wording keeps that distinction: applying happens on the
            Mod lists page, which shows what would change before anything is installed or disabled.
            A server handing you a list is exactly the case where that step must not be skipped.
        -->
        <ui:Card
            Padding="16"
            VerticalAlignment="Top"
            Margin="0,16,0,0"
            Visibility="{Binding HasListStatus, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <ui:SymbolIcon
                        Symbol="AppsList24"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Text="Published mod list" />
                </StackPanel>

                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Margin="0,0,0,8"
                    Text="{Binding ListSummary}"
                    Visibility="{Binding HasList, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding ListStatus}" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <ui:Button
                        Content="Fetch again"
                        Icon="{ui:SymbolIcon ArrowSync24}"
                        ToolTip="Asks for the list again even if its revision hasn't moved - for when the copy you hold has been edited or deleted."
                        Command="{Binding FetchListCommand}" />
                </StackPanel>
            </StackPanel>
        </ui:Card>

        <!--
            What this page cannot do yet, said outright.

            /hello and /list are the only routes the server serves. An empty client list here would
            read as "nobody else is connected", which is a different and wrong statement.
        -->
        <ui:Card
            Padding="16"
            VerticalAlignment="Top"
            Margin="0,16,0,0"
            Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock
                    Text="Who else is on this map"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Margin="0,0,0,4" />
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Nothing yet. The server does not report the other machines connected to it, so this page can only show the server itself for now. Nobody's install is being sent anywhere, including yours. That arrives with a later version of the server mod, and asks before it reports anything about this machine." />
            </StackPanel>
        </ui:Card>

    </StackPanel>
</Page>
