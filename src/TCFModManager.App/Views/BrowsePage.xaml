<!--
    ScrollViewer.CanContentScroll="False" opts this page out of the outer DynamicScrollViewer that
    WPF-UI's NavigationView wraps every Page in by default (its NavigationViewContentPresenter
    overrides the CanContentScroll metadata for the Page type itself). Inside that wrapper the page
    is measured with unbounded height, so the "*" row below never got a real limit: the results grid
    grew to fit whatever was on the page and the pager under it rode down with it, moving every time
    you turned a page or the tallest card changed.

    Opted out, the page is exactly the window's height, the "*" row takes what's left, the ListBox
    scrolls inside itself and the pager stays where it is. Same fix InstalledPage and DependenciesPage
    carry - see the comment at the top of InstalledPage.xaml for the full diagnosis. Note this page
    deliberately does NOT take the other two parts of that fix (a Transparent root Background and a
    PreviewMouseWheel handler), which are only needed for scroll-anywhere.
-->
<Page
    x:Class="TCFModManager.App.Views.BrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:app="clr-namespace:TCFModManager.App"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    xmlns:behaviors="clr-namespace:TCFModManager.App.Behaviors"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    ScrollViewer.CanContentScroll="False"
    Title="{loc:Str Nav_Browse}"
    Loaded="BrowsePage_Loaded">
    <Page.Resources>
        <!-- One width for every filter in the filter row, so a wrapped row lines up in columns. -->
        <sys:Double x:Key="FilterWidth">210</sys:Double>

        <converters:NullToVisibilityConverter x:Key="NullToCollapsed" />
        <converters:UpdateAvailableToVisibilityConverter x:Key="TrueToVisible" />
        <converters:FalseToVisibilityConverter x:Key="FalseToVisible" />
        <converters:CountToVisibilityConverter x:Key="HasCount" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

    </Page.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="FiltersColumn" Width="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--
             Search and the filters, the same shape as Installed's: what is reached for most - search,
             SPT version and sort - sits in the row, the rest behind Filters and view options, which says how many of them
             are set. One line at almost any width, so the results keep the room. Save as default and
             Clear filters are inside the panel; Refresh cache, an action rather than a filter, stays out.
        -->
        <DockPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,8">
            <ui:Button
                DockPanel.Dock="Right"
                VerticalAlignment="Top"
                Content="{loc:Str Browse_RefreshCache}"
                Command="{Binding RefreshCacheCommand}" />

            <WrapPanel>
                <ui:TextBox
                    Width="320"
                    Margin="0,0,8,4"
                    VerticalAlignment="Center"
                    PlaceholderText="{loc:Str Common_SearchPlaceholder}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                <!-- SPT version multi-select filter, styled to match the ComboBoxes beside it. -->
                <ToggleButton
                    x:Name="SptVersionToggle"
                    behaviors:DropDownToggle.Popup="{Binding ElementName=SptVersionPopup}"
                    Width="{StaticResource FilterWidth}"
                    Margin="0,0,8,4"
                    VerticalAlignment="Center"
                    ToolTip="{loc:Str Browse_SptVersionFilterToolTip}"
                    Style="{StaticResource FilterDropDownToggle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{Binding SptVersionFilterSummary}" />
                        </Grid>
                </ToggleButton>
                <Popup
                    x:Name="SptVersionPopup"
                    IsOpen="{Binding IsChecked, ElementName=SptVersionToggle, Mode=TwoWay}"
                    PlacementTarget="{Binding ElementName=SptVersionToggle}"
                    Placement="Bottom"
                    StaysOpen="False"
                    AllowsTransparency="True">
                    <Border Style="{StaticResource FilterDropDownPopup}" MinWidth="{Binding ActualWidth, ElementName=SptVersionToggle}">
                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                            <ItemsControl Margin="8,4" ItemsSource="{Binding SptVersionOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            Margin="2"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                            Content="{Binding Label, StringFormat={loc:Str Browse_SptVersionItemFormat}}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                </Popup>

                <ComboBox
                    Width="{StaticResource FilterWidth}"
                    Margin="0,0,8,4"
                    VerticalAlignment="Center"
                    ToolTip="{loc:Str Common_SortToolTip}"
                    ItemsSource="{Binding SortOptions}"
                    SelectedItem="{Binding SelectedSortOption}" />

                <ToggleButton
                    x:Name="MoreFiltersToggle"
                    MinWidth="130"
                    Margin="0,0,8,4"
                    VerticalAlignment="Center"
                    ToolTip="{loc:Str Filter_MoreToolTip}"
                    Style="{StaticResource FilterDropDownToggle}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Symbol="Filter24" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Text="{Binding MoreFiltersLabel}" />
                    </StackPanel>
                </ToggleButton>
            </WrapPanel>
        </DockPanel>

        <!--
             The rest of the filters, opened and closed by Filters in the row above. On a wide page it
             is a column of its own down the left and the results move over; on a narrow one it lies
             over the left of the results and a click elsewhere closes it (Behaviors/FilterSidePanel).
        -->
        <!-- The host is what FilterSidePanel sizes and clips, so on a wide page the results follow
             its width as it opens and closes; the panel inside keeps its own width throughout. -->
        <Grid
            x:Name="FiltersHost"
            Grid.Row="1"
            Grid.RowSpan="3"
            Grid.Column="0"
            HorizontalAlignment="Left"
            Visibility="Collapsed">
            <Border
                x:Name="FiltersPanel"
                Width="300"
                HorizontalAlignment="Right"
                Style="{StaticResource FilterSidePanelSurface}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,10">
                        <DockPanel Margin="0,0,0,10">
                            <ui:Button
                                x:Name="FiltersCloseButton"
                                DockPanel.Dock="Right"
                                Padding="4"
                                Appearance="Transparent"
                                ToolTip="{loc:Str Common_Close}">
                                <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                            </ui:Button>
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Text="{loc:Str Filter_More}" />
                        </DockPanel>

                        <!-- Each filter is a section that opens like a group does: its header names the filter and
                             shows what it is set to, and opening it lists every choice. No dropdowns to aim at in a
                             narrow panel, and what is set reads at a glance down the headers. -->
                        <!-- Everything that describes the mod itself: Fika, ads, dependencies, addons, installed. -->
                        <Expander Style="{StaticResource FilterSection}" IsExpanded="True">
                            <Expander.Header>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{loc:Str Filter_ShowHeader}" TextWrapping="Wrap" />
                            </Expander.Header>
                            <ItemsControl ItemsSource="{Binding AttributeOptions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            Margin="0,2"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                            ToolTip="{Binding ToolTip}">
                                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <Expander
                            Style="{StaticResource FilterSection}"
                            ToolTip="{loc:Str Browse_CategoryFilterToolTip}">
                            <Expander.Header>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{loc:Str Filter_SectionCategory}" TextWrapping="Wrap" />
                            </Expander.Header>
                            <ListBox Style="{StaticResource FilterOptionList}" ItemsSource="{Binding CategoryOptions}" SelectedItem="{Binding SelectedCategory}" />
                        </Expander>

                        <Expander
                            Style="{StaticResource FilterSection}"
                            ToolTip="{loc:Str Browse_FeaturedFilterToolTip}">
                            <Expander.Header>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{loc:Str Filter_SectionFeatured}" TextWrapping="Wrap" />
                            </Expander.Header>
                            <ListBox Style="{StaticResource FilterOptionList}" ItemsSource="{Binding FeaturedFilterOptions}" SelectedItem="{Binding SelectedFeaturedFilter}" />
                        </Expander>

                        <!-- The options are plain ints and "12" says nothing on its own, hence the template. -->
                        <Expander
                            Style="{StaticResource FilterSection}"
                            ToolTip="{loc:Str Common_PageSizeToolTip}">
                            <Expander.Header>
                                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{loc:Str Filter_SectionPageSize}" TextWrapping="Wrap" />
                            </Expander.Header>
                            <ListBox Style="{StaticResource FilterOptionList}" ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding PageSize}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat={loc:Str Common_PageSizeFormat}}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Expander>

                        <!-- Same as Installed's: the defaults are saved from the page, not restated in Options. -->
                        <ui:Button
                            Margin="0,6,0,6"
                            HorizontalAlignment="Stretch"
                            Content="{loc:Str Common_SaveAsDefault}"
                            ToolTip="{loc:Str Browse_SaveAsDefaultToolTip}"
                            Command="{Binding SaveAsDefaultCommand}" />
                        <ui:Button
                            HorizontalAlignment="Stretch"
                            Content="{loc:Str Common_ClearFilters}"
                            ToolTip="{loc:Str Common_ClearFiltersToolTip}"
                            Command="{Binding ClearFiltersCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="1" Grid.Column="1">
            <TextBlock
                Margin="0,0,0,8"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding StatusMessage}" />
            <!--
                 The filters narrowing the list, one pill each, the way Steam's workshop search shows them
                 (Chris, 2026-10-06): each X drops that one filter, and Clear filters drops them all.
             Always laid out, with Clear filters hidden rather than collapsed when nothing is set, so
             the results don't jump down the moment the first filter goes on.
            -->
            <DockPanel Margin="0,0,0,8">
                <ItemsControl DockPanel.Dock="Left" Focusable="False" ItemsSource="{Binding ActiveFilters}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource FilterPill}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding Label}" />
                                    <Button
                                        Margin="4,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource FilterPillRemove}"
                                        ToolTip="{loc:Str Filter_PillRemoveToolTip}"
                                        Command="{Binding RemoveCommand}">
                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="11" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:Button
                    Margin="0,0,0,6"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Content="{loc:Str Common_ClearFilters}"
                    ToolTip="{loc:Str Common_ClearFiltersToolTip}"
                    Command="{Binding ClearFiltersCommand}"
                    Style="{StaticResource FilterPillButton}" />
            </DockPanel>
        </StackPanel>

        <!-- Results grid; column count is set from code-behind based on width. -->
        <ListBox
            x:Name="ResultsListBox"
            Grid.Row="2"
            Grid.Column="1"
            Padding="4"
            BorderThickness="0"
            Background="Transparent"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ItemsSource="{Binding Results}"
            SelectionChanged="ResultsListBox_SelectionChanged"
            SizeChanged="ResultsListBox_SizeChanged">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{Binding Columns}" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <!-- Clears default item chrome so only the Card's own styling shows. -->
                    <Setter Property="Margin" Value="6" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    <!-- Ensures the item fills its UniformGrid cell. -->
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                    <Setter Property="VerticalAlignment" Value="Stretch" />
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- Mod card, stretched to fill its grid cell and clipped to bounds. -->
                    <ui:Card
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        ClipToBounds="True">
                        <!-- Fills the card. The right-hand column is a gutter the status icon and
                             install button live in, so neither can overlap the title or badges. -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Throttled thumbnail loader. -->
                                <Image
                                    Grid.Column="0"
                                    Width="48"
                                    Height="48"
                                    Margin="0,0,10,0"
                                    Stretch="UniformToFill"
                                    behaviors:ThumbnailLoader.Source="{Binding Thumbnail}" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{Binding Name}"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{Binding Author, StringFormat={loc:Str Browse_ByAuthorFormat}}"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{Binding Author, Converter={StaticResource NullToCollapsed}}" />
                                    <TextBlock
                                        Text="{Binding Guid}"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Text="{Binding Downloads, Mode=OneWay, StringFormat={loc:Str Common_DownloadsFormat}}"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        TextTrimming="CharacterEllipsis" />
                                    <!-- Collapsed rather than shown as "0 endorsements": the feature
                                         is new enough that almost every mod is on zero, and an empty
                                         row on every card would just add height. ModCardViewModel
                                         nulls the count at zero so NullToCollapsed can do this. -->
                                    <TextBlock
                                        Text="{Binding Endorsements, Mode=OneWay, StringFormat={loc:Str Browse_EndorsementsFormat}}"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{Binding Endorsements, Converter={StaticResource NullToCollapsed}}" />
                                    <!-- Runs rather than separate TextBlocks because the SPT segment
                                         is colored by compatibility with the installed version while
                                         the rest isn't, and the whole line has to trim as one when
                                         the card is narrow. De-emphasis here uses Foreground since
                                         Run has no Opacity. -->
                                    <TextBlock
                                        FontSize="11"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding SptVersionTooltip}">
                                        <Run
                                            Text="{Binding SptVersionDisplay, Mode=OneWay}"
                                            Style="{StaticResource CompatibilityText}" />
                                        <Run Text=" • " Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Run Text="{Binding DisplayReleaseVersion, Mode=OneWay, StringFormat='v{0}'}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </TextBlock>
                                    <!-- Shown only when the ticked SPT filter is hiding a version
                                         that actually runs on the installed SPT - explains a red
                                         card rather than leaving it looking simply incompatible.

                                         Wraps rather than trims, unlike every line above it: those
                                         are identity (name, GUID, counts) where the first half
                                         still identifies the mod, but this one's whole point is the
                                         version number and it sits at the end of the sentence. At
                                         three or four columns it was being cut off at "...for your
                                         inst", which says nothing at all. The UniformGrid sizes
                                         every cell to the tallest, so the second line costs a row
                                         of height across the page - worth it for the one note on
                                         the card that exists purely to be read. -->
                                    <TextBlock
                                        Text="{Binding AlternateCompatibleVersionNote}"
                                        FontSize="11"
                                        FontStyle="Italic"
                                        Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                        TextWrapping="Wrap"
                                        ToolTip="{Binding AlternateCompatibleVersionNote}"
                                        Visibility="{Binding AlternateCompatibleVersionNote, Converter={StaticResource NullToCollapsed}}" />
                                    <!--
                                        The badge area, held at three badge rows whatever this
                                        particular mod carries.

                                        The UniformGrid sizes every cell to the tallest card on the
                                        page, so one card with three rows of badges made every card
                                        on that page taller - and since each page has a different
                                        tallest card, the pager underneath the grid moved every time
                                        you turned a page. Reserving the space up front costs a
                                        little height on sparse pages and buys a Browse page that
                                        never resizes under the cursor.

                                        Three rows is what five badges take at the narrowest column
                                        count: category, Fika, ads, dependencies and addons. The
                                        keeper column is a minimum rather than a clamp - a card that
                                        somehow needs a fourth row grows rather than clipping a
                                        badge, which is the bug this whole run has been fixing.

                                        Height comes from three real Badges at zero width rather
                                        than a hard-coded number, so it stays right if the badge
                                        style ever changes. IsHitTestVisible="False" keeps them out
                                        of the way of the card's own click.
                                    -->
                                    <Grid Margin="0,4,0,0">
                                        <StackPanel IsHitTestVisible="False">
                                            <ui:Badge Width="0" Margin="0,0,0,4" FontSize="11" Content=" " Visibility="Hidden" />
                                            <ui:Badge Width="0" Margin="0,0,0,4" FontSize="11" Content=" " Visibility="Hidden" />
                                            <ui:Badge Width="0" FontSize="11" Content=" " Visibility="Hidden" />
                                        </StackPanel>

                                        <StackPanel VerticalAlignment="Top">
                                            <!--
                                                WrapPanels, not StackPanels: a badge is a fixed label
                                                that can't shorten itself, so a horizontal stack runs
                                                the last one off the edge of the card - three of these
                                                left "Contains ads" reading "Contains ad". Gaps are
                                                trailing margins so whichever badge starts a line sits
                                                flush left, and the 4 at the bottom is the gap between
                                                wrapped lines.

                                                Two panels rather than one so the mod's own tags stay
                                                above what it needs from you, and so the dependency
                                                badge arriving late can't reshuffle the tags around it.
                                            -->
                                            <WrapPanel>
                                                <ui:Badge
                                                    Margin="0,0,6,4"
                                                    Appearance="Info"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Content="{Binding CategoryTag}"
                                                    Visibility="{Binding CategoryTag, Converter={StaticResource NullToCollapsed}}" />
                                                <ui:Badge
                                                    Margin="0,0,6,4"
                                                    Appearance="Info"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Content="{loc:Str Common_FlagFikaCompatible}"
                                                    Visibility="{Binding IsFikaCompatible, Converter={StaticResource TrueToVisible}}" />
                                                <ui:Badge
                                                    Margin="0,0,6,4"
                                                    Appearance="Info"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Content="{loc:Str Common_FlagContainsAds}"
                                                    Visibility="{Binding ContainsAds, Converter={StaticResource TrueToVisible}}" />
                                            </WrapPanel>

                                            <!-- Both collapse when they don't apply, so whichever one
                                                 shows starts at the left edge. The dependency badge is
                                                 resolved asynchronously per card; the addon one is
                                                 answered from the cached addon catalog, so unlike the
                                                 badge beside it that one is right on the first render. -->
                                            <WrapPanel>
                                                <ui:Badge
                                                    Margin="0,0,6,4"
                                                    Appearance="Caution"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Content="{loc:Str Browse_BadgeHasDependencies}"
                                                    Visibility="Collapsed"
                                                    behaviors:DependencyBadgeLoader.Mod="{Binding Mod}" />
                                                <ui:Badge
                                                    Margin="0,0,6,4"
                                                    Appearance="Info"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                    Content="{Binding AddonBadgeText}"
                                                    ToolTip="{loc:Str Browse_AddonBadgeToolTip}"
                                                    Visibility="{Binding HasAddons, Converter={StaticResource TrueToVisible}}" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <!-- Install/update status icon, same set the Installed and Dependencies pages use,
                                 with the pin under it when this install has the mod pinned. -->
                            <StackPanel
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                                <ui:SymbolIcon
                                    FontSize="20"
                                    Symbol="{Binding StatusGlyph}"
                                    Style="{StaticResource StatusIcon}"
                                    ToolTip="{Binding StatusTooltip}"
                                    Visibility="{Binding IsInstalled, Converter={StaticResource TrueToVisible}}" />

                                <ui:SymbolIcon
                                    FontSize="16"
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    Symbol="Pin24"
                                    Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                    ToolTip="{loc:Str Common_PinnedToolTip}"
                                    Visibility="{Binding IsPinned, Converter={StaticResource TrueToVisible}}" />
                            </StackPanel>

                            <!-- Install button, shown only for mods not yet installed. Follows Monitor
                                 mode's setting; the button to its left does the other thing for this
                                 one mod. -->
                            <StackPanel
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal"
                                Visibility="{Binding IsInstalled, Converter={StaticResource FalseToVisible}}">
                                <ui:Button
                                    Margin="0,0,4,0"
                                    Padding="6"
                                    Appearance="Transparent"
                                    Command="{Binding DataContext.InstallAlternateCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding AlternateToolTip, Source={x:Static app:AppServices.ModPageGate}}">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="{Binding AlternateSymbol, Source={x:Static app:AppServices.ModPageGate}}" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <ui:Button
                                    Padding="6"
                                    Appearance="Transparent"
                                    Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding InstallToolTip, Source={x:Static app:AppServices.ModPageGate}}">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="{Binding MainSymbol, Source={x:Static app:AppServices.ModPageGate}}" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>

                            <!-- Redownload button, takes the install button's place once the mod is installed. -->
                            <StackPanel
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Orientation="Horizontal"
                                Visibility="{Binding IsInstalled, Converter={StaticResource TrueToVisible}}">
                                <ui:Button
                                    Margin="0,0,4,0"
                                    Padding="6"
                                    Appearance="Transparent"
                                    Command="{Binding DataContext.RedownloadAlternateCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding AlternateToolTip, Source={x:Static app:AppServices.ModPageGate}}">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="{Binding AlternateSymbol, Source={x:Static app:AppServices.ModPageGate}}" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <ui:Button
                                    Padding="6"
                                    Appearance="Transparent"
                                    Command="{Binding DataContext.RedownloadCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding RedownloadToolTip, Source={x:Static app:AppServices.ModPageGate}}">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="{Binding MainSymbol, Source={x:Static app:AppServices.ModPageGate}}" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </ui:Card>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!--
            Startup panel, over the results area and only on the first load of a session.

            Before this the window opened and then sat empty while the catalog loaded, with nothing
            saying anything was happening - and on a first run, with no cache to read, that is a
            long silence while ~3000 mods are fetched a page at a time. The progress counters it
            reads have been on the catalog loader all along with nothing bound to them.

            It sits in the same grid row as the ListBox and paints the window background, so the
            empty list doesn't show through, and it takes no space once it collapses.
        -->
        <Border
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Panel.ZIndex="20"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            Visibility="{Binding IsStartingUp, Converter={StaticResource TrueToVisible}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing
                    Width="48"
                    Height="48"
                    HorizontalAlignment="Center"
                    IsIndeterminate="True" />

                <TextBlock
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{Binding StartupStage}" />

                <!-- Only a live fetch knows a total, so this stays collapsed on a launch that
                     reads the cache and appears on the first run, which is the slow one. -->
                <!-- One sentence, not four Runs: "of" and "mods" were fragments no translator
                     could place, and several languages would not put them in that order. -->
                <TextBlock
                    Margin="0,4,0,0"
                    HorizontalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Visibility="{Binding TotalCount, Source={x:Static app:AppServices.ModCache}, Converter={StaticResource HasCount}}">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="{loc:Str Browse_StartupProgressFormat}">
                            <Binding Path="LoadedCount" Source="{x:Static app:AppServices.ModCache}" Mode="OneWay" />
                            <Binding Path="TotalCount" Source="{x:Static app:AppServices.ModCache}" Mode="OneWay" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>

                <TextBlock
                    Margin="0,16,0,0"
                    HorizontalAlignment="Center"
                    TextWrapping="Wrap"
                    MaxWidth="380"
                    TextAlignment="Center"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Text="{loc:Str Browse_FirstLaunchNote}"
                    Visibility="{Binding TotalCount, Source={x:Static app:AppServices.ModCache}, Converter={StaticResource HasCount}}" />
            </StackPanel>
        </Border>

        <StackPanel
            Grid.Row="3"
            Grid.Column="1"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,8,0,0">
            <ui:Button
                Content="{loc:Str Common_Previous}"
                Command="{Binding PreviousPageCommand}" />

            <!-- One TextBlock rather than "Page 3" beside "of 10": a page count is one sentence,
                 and the two halves cannot be reordered independently. The second half loses its
                 dimmer foreground in the merge. -->
            <TextBlock
                Margin="12,0,12,0"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                <TextBlock.Text>
                    <MultiBinding StringFormat="{loc:Str Common_PagerFormat}">
                        <Binding Path="CurrentPage" Mode="OneWay" />
                        <Binding Path="TotalPages" Mode="OneWay" />
                    </MultiBinding>
                </TextBlock.Text>
            </TextBlock>
            <ui:Button
                Margin="12,0,0,0"
                Content="{loc:Str Common_Next}"
                Command="{Binding NextPageCommand}" />
        </StackPanel>
    </Grid>
</Page>
