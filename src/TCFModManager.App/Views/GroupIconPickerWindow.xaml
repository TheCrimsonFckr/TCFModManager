<ui:FluentWindow
    x:Class="TCFModManager.App.Views.GroupIconPickerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    xmlns:controls="clr-namespace:TCFModManager.App.Controls"
    Width="460"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    ExtendsContentIntoTitleBar="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="WindowTitleBar"
            Grid.Row="0"
            ShowMinimize="False"
            ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="24,12,24,0">
            <ui:TextBox
                x:Name="SearchBox"
                Margin="0,0,0,12"
                PlaceholderText="{loc:Str GroupIcon_SearchPlaceholder}"
                TextChanged="SearchBox_TextChanged" />

            <ItemsControl x:Name="IconList" Focusable="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:Button
                            Width="48"
                            Height="48"
                            Margin="0,0,6,6"
                            Padding="0"
                            Appearance="{Binding Appearance}"
                            ToolTip="{Binding Name}"
                            Tag="{Binding Key}"
                            Click="Icon_Click">
                            <controls:GroupIconView Width="24" Height="24" Key="{Binding Key}" />
                        </ui:Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock
                x:Name="NothingFound"
                Margin="0,0,0,12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{loc:Str GroupIcon_NothingFound}"
                Visibility="Collapsed" />
        </StackPanel>

        <WrapPanel Grid.Row="2" Style="{StaticResource DialogButtonBar}">
            <ui:Button
                Style="{StaticResource DialogButton}"
                IsCancel="True"
                Content="{loc:Str Common_Cancel}" />

            <ui:Button
                Style="{StaticResource DialogButton}"
                Content="{loc:Str GroupIcon_None}"
                Click="None_Click" />
        </WrapPanel>
    </Grid>
</ui:FluentWindow>
