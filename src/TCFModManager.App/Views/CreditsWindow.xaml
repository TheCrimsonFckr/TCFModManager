<ui:FluentWindow
    x:Class="TCFModManager.App.Views.CreditsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    Width="520"
    MinWidth="420"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    ExtendsContentIntoTitleBar="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">
    <!--
        Who has helped build the app: the people listed in Help/Contributors.cs, and nobody else.

        Every TextBlock sets its own Foreground; nothing here may inherit the system foreground.
    -->
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="WindowTitleBar"
            Grid.Row="0"
            Title="{loc:Str Credits_Title}" />

        <!-- Capped: the window sizes to its content, and the list only grows. -->
        <ScrollViewer
            Grid.Row="1"
            MaxHeight="460"
            VerticalScrollBarVisibility="Auto"
            HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24,8,24,0">
                <TextBlock
                    TextWrapping="Wrap"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{loc:Str Credits_Intro}" />

                <TextBlock
                    Margin="0,18,0,6"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Text="{loc:Str Credits_ContributorsHeader}" />

                <ItemsControl x:Name="ContributorList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource HoverRow}" Padding="8,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                            Text="{Binding Name}" />

                                        <TextBlock
                                            Margin="0,2,0,0"
                                            TextWrapping="Wrap"
                                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                            Text="{Binding Detail}" />
                                    </StackPanel>

                                    <ui:Button
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        Appearance="Transparent"
                                        Icon="{ui:SymbolIcon Open24}"
                                        ToolTip="{Binding Link}"
                                        Visibility="{Binding HasLink, Converter={StaticResource BoolToVis}}"
                                        Click="OpenLink_Click" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <ui:Button
            Grid.Row="2"
            Margin="24,16,24,24"
            MinWidth="100"
            HorizontalAlignment="Right"
            HorizontalContentAlignment="Center"
            Appearance="Primary"
            IsDefault="True"
            IsCancel="True"
            Content="{loc:Str Common_Close}"
            Click="Close_Click" />
    </Grid>
</ui:FluentWindow>
