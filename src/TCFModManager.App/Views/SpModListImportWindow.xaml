<ui:FluentWindow
    x:Class="TCFModManager.App.Views.SpModListImportWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    Width="760"
    Height="760"
    MinWidth="560"
    MinHeight="480"
    ShowInTaskbar="False"
    ExtendsContentIntoTitleBar="True"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType">
    <!--
        Imports an sp-mod Mod List: paste its address, read it, review it, then create the list.
        Nothing is stored until the last button - the window's job is to show what the list will
        hold, sorted into what each entry is, before any of it exists (OPEN-18 R8).

        Every TextBlock and SymbolIcon sets its own Foreground: nothing here may inherit the system
        control foreground, which is black whatever the theme is.
    -->
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            x:Name="WindowTitleBar"
            Grid.Row="0"
            Title="{loc:Str SpModImport_Title}" />

        <!-- Step 1: the address. -->
        <StackPanel
            x:Name="LinkPanel"
            Grid.Row="1"
            Margin="24,12,24,0">
            <TextBlock
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="{loc:Str SpModImport_LinkHeader}" />

            <TextBlock
                TextWrapping="Wrap"
                Margin="0,4,0,12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{loc:Str SpModImport_LinkDescription}" />

            <ui:TextBox
                x:Name="LinkBox"
                Icon="{ui:SymbolIcon Link24}"
                PlaceholderText="{loc:Str SpModImport_LinkPlaceholder}"
                TextChanged="LinkBox_TextChanged"
                KeyDown="LinkBox_KeyDown" />

            <TextBlock
                x:Name="LinkError"
                TextWrapping="Wrap"
                Margin="2,10,0,0"
                Visibility="Collapsed"
                Foreground="{DynamicResource SystemFillColorCriticalBrush}" />

            <ui:Button
                Margin="0,16,0,0"
                Appearance="Transparent"
                Icon="{ui:SymbolIcon Open24}"
                Content="{loc:Str SpModImport_FindLists}"
                ToolTip="{loc:Str SpModImport_FindListsToolTip}"
                Click="FindLists_Click" />
        </StackPanel>

        <!-- While sp-mod is being asked. Cancel stops it. -->
        <StackPanel
            x:Name="BusyPanel"
            Grid.Row="1"
            Margin="24"
            VerticalAlignment="Center"
            HorizontalAlignment="Center"
            Visibility="Collapsed">
            <ui:ProgressRing
                Width="40"
                Height="40"
                IsIndeterminate="True" />

            <TextBlock
                x:Name="BusyText"
                Margin="0,16,0,0"
                TextAlignment="Center"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <!-- Step 2: the review. -->
        <Grid
            x:Name="ReviewPanel"
            Grid.Row="1"
            Margin="24,8,24,0"
            Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock
                        x:Name="ListNameText"
                        FontSize="20"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                    <TextBlock
                        x:Name="ListFactsText"
                        Margin="0,4,0,0"
                        TextWrapping="Wrap"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <ui:Button
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    VerticalAlignment="Top"
                    Appearance="Transparent"
                    Icon="{ui:SymbolIcon Open24}"
                    Content="{loc:Str SpModImport_OpenOnSpMod}"
                    Click="OpenOnSpMod_Click" />
            </Grid>

            <TextBlock
                x:Name="NoticesText"
                Grid.Row="1"
                Margin="0,10,0,0"
                TextWrapping="Wrap"
                Visibility="Collapsed"
                Foreground="{DynamicResource SystemFillColorCautionBrush}" />

            <!-- Shown when the list's target SPT isn't this install's. -->
            <StackPanel
                x:Name="SptPanel"
                Grid.Row="2"
                Margin="0,12,0,0"
                Visibility="Collapsed">
                <ui:InfoBar
                    x:Name="SptBar"
                    Severity="Informational"
                    IsClosable="False"
                    IsOpen="True" />

                <ui:ToggleSwitch
                    x:Name="RetargetSwitch"
                    Margin="4,8,0,0"
                    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    Click="RetargetSwitch_Click" />
            </StackPanel>

            <!--
                Top, not the default: a ui:Card in a "*" row is laid out centred, so a short list
                would hang in the middle of the window. The card is still measured against the
                cell, so a long one scrolls inside it.
            -->
            <ui:Card
                Grid.Row="3"
                Margin="0,12,0,0"
                Padding="4"
                VerticalAlignment="Top">
                <ScrollViewer
                    x:Name="SectionsScroller"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="SectionsList" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8,8,8,12">
                                    <TextBlock
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="{Binding Title}" />

                                    <TextBlock
                                        Margin="0,2,0,6"
                                        TextWrapping="Wrap"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                        Visibility="{Binding HasNote, Converter={StaticResource BoolToVis}}"
                                        Text="{Binding Note}" />

                                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource HoverRow}" Padding="8,6">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>

                                                        <CheckBox
                                                            Grid.Column="0"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center"
                                                            Visibility="{Binding CanTick, Converter={StaticResource BoolToVis}}"
                                                            IsChecked="{Binding Ticked}" />

                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock
                                                                TextWrapping="Wrap"
                                                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                                Text="{Binding Name}" />

                                                            <TextBlock
                                                                Margin="0,2,0,0"
                                                                TextWrapping="Wrap"
                                                                FontSize="12"
                                                                Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                Text="{Binding Detail}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </ui:Card>
        </Grid>

        <Grid Grid.Row="2" Margin="24,16,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="SummaryText"
                Grid.Column="0"
                Margin="2,0,12,0"
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

            <ui:Button
                Grid.Column="1"
                MinWidth="100"
                HorizontalContentAlignment="Center"
                Content="{loc:Str Common_Cancel}"
                Click="CancelButton_Click" />

            <ui:Button
                x:Name="PrimaryButton"
                Grid.Column="2"
                MinWidth="130"
                Margin="10,0,0,0"
                HorizontalContentAlignment="Center"
                Appearance="Primary"
                IsEnabled="False"
                Content="{loc:Str SpModImport_Read}"
                Click="PrimaryButton_Click" />
        </Grid>
    </Grid>
</ui:FluentWindow>
