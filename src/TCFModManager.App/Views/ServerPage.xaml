<Page
    x:Class="TCFModManager.App.Views.ServerPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    xmlns:play="clr-namespace:TCFModManager.App.Views.Play"
    xmlns:behaviors="clr-namespace:TCFModManager.App.Behaviors"
    Title="{loc:Str Nav_Server}">
    <StackPanel x:Name="Root" Margin="16,16,16,0">

        <play:ServerCard behaviors:TourTarget.Key="server.server" />

        <play:ModToolsCard behaviors:TourTarget.Key="server.tools" />

        <play:HeadlessCard behaviors:TourTarget.Key="server.headless" />

        <play:MessageCard />

    </StackPanel>
</Page>
