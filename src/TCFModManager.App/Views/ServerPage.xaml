    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:loc="clr-namespace:TCFModManager.App.Localization"
    xmlns:play="clr-namespace:TCFModManager.App.Views.Play"
    Title="{loc:Str Nav_Server}">
    <StackPanel x:Name="Root" Margin="16">

        <play:ServerCard />

        <play:ModToolsCard />

        <play:HeadlessCard />

        <play:MessageCard />

    </StackPanel>
</Page>
