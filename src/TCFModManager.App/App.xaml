<Application
    x:Class="TCFModManager.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Only the seed the resource dictionary loads with. The theme actually used is
                     applied by AppTheme in App.OnStartup, which runs before any window is created,
                     so whichever value sits here is never the one on screen. -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!--
                How a clickable row reacts to the pointer, defined once so every list agrees -
                whether it hand-rolls its rows out of a Border or lets a ListBox do it.

                The Windows accent colour at low alpha rather than a solid accent fill: laid over
                whatever is behind it, it tints in both light and dark without either washing out or
                swallowing the text on the row. A solid accent would need its own foreground colour
                to stay readable, which is a much bigger change for no more clarity.

                The Color is a DynamicResource so it re-resolves when the theme - or the user's
                Windows accent - changes, rather than freezing at whatever it was at startup.

                Note the resting Background in the styles below is a Setter rather than being left to
                each row: a local Background="..." on a Border outranks a style trigger, and the
                hover would silently do nothing.
            -->
            <SolidColorBrush
                x:Key="RowHoverBrush"
                Color="{DynamicResource SystemAccentColor}"
                Opacity="0.10" />

            <!-- The selected row in the Configs list. Stronger than the hover so the file you have
                 open still reads as the current one while the pointer is somewhere else. -->
            <SolidColorBrush
                x:Key="RowSelectedBrush"
                Color="{DynamicResource SystemAccentColor}"
                Opacity="0.24" />

            <!--
                The accent at full strength, for the edge of a selected row. Paired with
                RowSelectedBrush - the same accent at a quarter - so a picked row reads as a card
                that has been chosen rather than a block of colour, and keeps its own text colours.
            -->
            <SolidColorBrush x:Key="SelectedRowStroke" Color="{DynamicResource SystemAccentColor}" />

            <!-- A row that sits on a card-coloured surface: group-view mod rows. -->
            <Style x:Key="ClickableCardRow" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Cursor" Value="Hand" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
                Group-view mod rows since OPEN-12 A1: ClickableCardRow, plus the ticked state Multi
                select gives a card - the accent edge and tint, read from the row's own IsSelected.
                The border is always there and transparent, so ticking a row never moves its content.
            -->
            <Style x:Key="TickableCardRow" TargetType="Border" BasedOn="{StaticResource ClickableCardRow}">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="{StaticResource RowSelectedBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource SelectedRowStroke}" />
                    </DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
                The same tint on a row you can't click. Dependencies rows are read-only - the only
                thing you can press in one is a conditional Install button - so this deliberately
                leaves the cursor alone: it tracks what you are looking at across a wide row without
                claiming the row does something.
            -->
            <Style x:Key="HoverRow" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="CornerRadius" Value="4" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
                The two halves of a multi-select filter dropdown - a ToggleButton that looks like a
                ComboBox, and the popup body under it. Browse's SPT version filter was the first of
                these and carried both inline; there are four now across Browse and Installed, which
                is three copies too many of a control template to keep in step by hand.

                The ToggleButton's template is replaced outright rather than extended, so it stops
                looking like a button and starts looking like the ComboBoxes it sits between: same
                background, border and corner radius, and the caller supplies the summary text and
                the chevron as its content.
            -->
            <!--
                Status icon colour, and the compatibility text colour beside it.

                These were converters returning a resolved Brush, which is why they lagged a live
                theme switch: a Brush handed back from an IValueConverter is whatever the theme was
                when the binding last ran, and nothing re-runs it when the theme changes. A Setter
                carrying a DynamicResource re-resolves, so the colour follows the theme.

                No BasedOn, and that is safe here rather than the usual trap: SymbolIcon derives
                FontIcon -> IconElement -> FrameworkElement, and WPF-UI registers no default style
                anywhere in that chain (checked against the decompiled assembly), so there is no
                control style being replaced and no template to strip.

                The unset case is the tertiary text brush, which is what the old converter fell back
                to for NoCompatibleVersion, Unknown, Disabled and anything unrecognised - so only
                the four coloured states need a trigger.
            -->
            <Style x:Key="StatusIcon" TargetType="ui:SymbolIcon">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Status}" Value="Installed">
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="UpdateAvailable">
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="NotInstalled">
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Status}" Value="Conflict">
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--
                The Dependencies page's tree header shows the worst status of everything under it,
                which lives on a different property. Same vocabulary, same colours - see
                DependencyTreeViewModel.Worst.
            -->
            <Style x:Key="WorstStatusIcon" TargetType="ui:SymbolIcon" BasedOn="{StaticResource StatusIcon}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Worst}" Value="Installed">
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Worst}" Value="UpdateAvailable">
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Worst}" Value="NotInstalled">
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Worst}" Value="Conflict">
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--
                Browse's "compatible with your SPT version" line. Three-state: true, false, and null
                for a mod whose constraint could not be read - which stays the neutral brush.

                TargetType is Run, not TextBlock: the coloured part is one inline of a sentence that
                also carries the release version, so the colour has to sit on the Run itself.
            -->
            <Style x:Key="CompatibilityText" TargetType="Run">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsCompatibleWithInstalledSpt}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsCompatibleWithInstalledSpt}" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--
                The Data files window's status line. The one place this pattern matters for
                legibility rather than tidiness: it swaps between the critical colour and ORDINARY
                TEXT, so a value frozen from the previous theme could leave a normal message sitting
                on the wrong side of a light/dark switch.
            -->
            <Style x:Key="ErrorText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasError}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="FilterDropDownToggle" TargetType="ToggleButton">
                <!--
                    Foreground is set here because this Style has no BasedOn and so REPLACES WPF-UI's
                    ToggleButton style rather than extending it - including its themed foreground,
                    leaving a stock WPF ToggleButton whose text defaults to black. Unreadable in dark
                    mode, and invisible in light mode where black happens to be right. The summary
                    TextBlock inside each dropdown sets its own as well, per this codebase's rule.

                    Made to behave like the ComboBoxes beside it (WPF-UI 4.3's DefaultComboBoxStyle,
                    read from its BAML): the chevron is part of the template and turns 180 degrees
                    over 167ms as the panel opens and back as it closes, and the hover fill is the
                    ComboBox's. While open the toggle takes no clicks: a click on it then lands
                    outside the StaysOpen=False popup, which closes it - left hit-testable, the same
                    click would also re-check the toggle and open it straight back up.
                -->
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="MinWidth" Value="150" />
                <Setter Property="Padding" Value="{DynamicResource ComboBoxPadding}" />
                <Setter Property="Background" Value="{DynamicResource ComboBoxBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border
                                x:Name="Face"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource ControlCornerRadius}">
                                <Grid Margin="{TemplateBinding Padding}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" VerticalAlignment="Center" />
                                    <ui:SymbolIcon
                                        x:Name="ChevronIcon"
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        RenderTransformOrigin="0.5,0.5"
                                        Foreground="{DynamicResource ComboBoxDropDownGlyphForeground}"
                                        Symbol="ChevronDown24">
                                        <ui:SymbolIcon.RenderTransform>
                                            <RotateTransform Angle="0" />
                                        </ui:SymbolIcon.RenderTransform>
                                    </ui:SymbolIcon>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Face" Property="Background" Value="{DynamicResource ComboBoxBackgroundPointerOver}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="IsHitTestVisible" Value="False" />
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="ChevronIcon"
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                    From="0"
                                                    To="180"
                                                    Duration="00:00:00.167" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="ChevronIcon"
                                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                    From="180"
                                                    To="0"
                                                    Duration="00:00:00.167" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                The panel itself, opening the way a ComboBox's list does (WPF-UI 4.3's DropDownBorder):
                slid down 90px into place over 167ms, easing out. Loaded fires each time the popup
                opens, since its content is put into a fresh window every time. The slide happens
                inside the popup's own window, so the part still above it is simply not drawn yet.
            -->
            <Style x:Key="FilterDropDownPopup" TargetType="Border">
                <Setter Property="RenderTransform">
                    <Setter.Value>
                        <TranslateTransform Y="0" />
                    </Setter.Value>
                </Setter>
                <Setter Property="Padding" Value="0,4,0,6" />
                <Setter Property="Background" Value="{DynamicResource ComboBoxDropDownBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ComboBoxDropDownBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{DynamicResource PopupCornerRadius}" />
                <Setter Property="Effect">
                    <Setter.Value>
                        <DropShadowEffect BlurRadius="20" Direction="270" Opacity="0.135" ShadowDepth="10" Color="#202020" />
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                    From="-90"
                                    To="0"
                                    Duration="00:00:00.167">
                                    <DoubleAnimation.EasingFunction>
                                        <CircleEase EasingMode="EaseOut" />
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Style.Triggers>
            </Style>

            <!--
                Collapsed cards on the Installed List view and the Dependencies trees.

                BasedOn is load-bearing: a Style with no BasedOn REPLACES the control's default style
                rather than extending it, which strips CardExpander of its background, border, corner
                radius and padding and leaves bare rows on the page background. Every style here that
                targets a WPF-UI control needs it; the Border styles don't, because Border has no
                themed default to lose.

                Note the tint follows the whole control, so an expanded card stays tinted while the
                pointer is anywhere over its body - scoping it to the header alone would mean
                replacing CardExpander's template for very little gain.
            -->
            <Style
                x:Key="HoverCardExpander"
                TargetType="ui:CardExpander"
                BasedOn="{StaticResource {x:Type ui:CardExpander}}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- A row with no resting fill of its own: the Configs list. Draws both its hover and
                 its selected state, since its container's chrome is turned off. -->
            <Style x:Key="ClickableRow" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Cursor" Value="Hand" />

                <!-- The border is always there and transparent until the row is selected, so
                     picking one changes its colour and never its size. Giving it a thickness only
                     in the trigger would shift every row's content by a pixel as you clicked. -->
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Style.Triggers>
                    <!-- Selection is drawn here rather than by the ListBoxItem, because that
                         container has had its own chrome turned off to stop a grey edge showing
                         around this row. Order matters: the hover trigger comes second so pointing
                         at a row still reads as pointing at it, even when it is the selected one. -->
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter Property="Background" Value="{StaticResource RowSelectedBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource SelectedRowStroke}" />
                    </DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
                The same selected state again, for a card that carries its own IsSelected rather
                than sitting in a ListBox: Installed's Cards view in Multi select mode, where the
                tick is what a bulk enable, disable or remove will act on.

                A separate style from SelectableCardExpander because the binding is different - this
                one reads the card view model's own property, that one the container's - and giving
                either style both triggers would leave the other list raising binding errors for a
                property its rows do not have.

                Leaving Multi select clears every tick (InstalledViewModel.OnSelectionModeChanged),
                so this can never linger on a card outside that mode.
            -->
            <Style
                x:Key="TickableCardExpander"
                TargetType="ui:CardExpander"
                BasedOn="{StaticResource {x:Type ui:CardExpander}}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="{StaticResource RowSelectedBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource SelectedRowStroke}" />
                    </DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
                The same selected state on a ui:CardExpander: the version list in the mod update
                dialog, where the picked row is the version Update or Redownload will fetch.
                Deliberately not folded into HoverCardExpander - that one is also used by rows in a
                plain ItemsControl, which have no ListBoxItem for the trigger to bind against.

                Only BorderBrush and Background are set. CardExpander's template hard-codes its
                border thickness, so the edge is always drawn and only its colour changes; hover
                comes second so pointing at a row still reads as pointing at it, selected or not.
            -->
            <Style
                x:Key="SelectableCardExpander"
                TargetType="ui:CardExpander"
                BasedOn="{StaticResource {x:Type ui:CardExpander}}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter Property="Background" Value="{StaticResource RowSelectedBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource SelectedRowStroke}" />
                    </DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
