<Application
    x:Class="TCFModManager.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Only the seed the resource dictionary loads with. The theme actually used is
                     applied by AppTheme in App.OnStartup, which runs before any window is created,
                     so whichever value sits here is never the one on screen. -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <!--
                How a clickable row reacts to the pointer, defined once so every list agrees -
                whether it hand-rolls its rows out of a Border or lets a ListBox do it.

                The Windows accent colour at low alpha rather than a solid accent fill: laid over
                whatever is behind it, it tints in both light and dark without either washing out or
                swallowing the text on the row. A solid accent would need its own foreground colour
                to stay readable, which is a much bigger change for no more clarity.

                The Color is a DynamicResource so it re-resolves when the theme - or the user's
                Windows accent - changes, rather than freezing at whatever it was at startup.

                Note the resting Background in the styles below is a Setter rather than being left to
                each row: a local Background="..." on a Border outranks a style trigger, and the
                hover would silently do nothing.
            -->
            <SolidColorBrush
                x:Key="RowHoverBrush"
                Color="{DynamicResource SystemAccentColor}"
                Opacity="0.10" />

            <!-- The selected row in the Configs list. Stronger than the hover so the file you have
                 open still reads as the current one while the pointer is somewhere else. -->
            <SolidColorBrush
                x:Key="RowSelectedBrush"
                Color="{DynamicResource SystemAccentColor}"
                Opacity="0.24" />

            <!-- A row that sits on a card-coloured surface: group-view mod rows. -->
            <Style x:Key="ClickableCardRow" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Cursor" Value="Hand" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
                The same tint on a row you can't click. Dependencies rows are read-only - the only
                thing you can press in one is a conditional Install button - so this deliberately
                leaves the cursor alone: it tracks what you are looking at across a wide row without
                claiming the row does something.
            -->
            <Style x:Key="HoverRow" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="CornerRadius" Value="4" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
                Collapsed cards on the Installed List view and the Dependencies trees.

                BasedOn is load-bearing: a Style with no BasedOn REPLACES the control's default style
                rather than extending it, which strips CardExpander of its background, border, corner
                radius and padding and leaves bare rows on the page background. Every style here that
                targets a WPF-UI control needs it; the Border styles don't, because Border has no
                themed default to lose.

                Note the tint follows the whole control, so an expanded card stays tinted while the
                pointer is anywhere over its body - scoping it to the header alone would mean
                replacing CardExpander's template for very little gain.
            -->
            <Style
                x:Key="HoverCardExpander"
                TargetType="ui:CardExpander"
                BasedOn="{StaticResource {x:Type ui:CardExpander}}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- A row with no resting fill of its own: the Configs list. Draws both its hover and
                 its selected state, since its container's chrome is turned off. -->
            <Style x:Key="ClickableRow" TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Cursor" Value="Hand" />
                <Style.Triggers>
                    <!-- Selection is drawn here rather than by the ListBoxItem, because that
                         container has had its own chrome turned off to stop a grey edge showing
                         around this row. Order matters: the hover trigger comes second so pointing
                         at a row still reads as pointing at it, even when it is the selected one. -->
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter Property="Background" Value="{StaticResource RowSelectedBrush}" />
                    </DataTrigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource RowHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
