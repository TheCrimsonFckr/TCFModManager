<Page
    x:Class="TCFModManager.App.Views.DependenciesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
    xmlns:converters="clr-namespace:TCFModManager.App.Converters"
    Title="Dependencies"
    Loaded="DependenciesPage_Loaded">
    <Page.Resources>
        <converters:ModStatusToBrushConverter x:Key="StatusBrush" />
        <controls:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:CountToVisibilityConverter x:Key="HasItems" />
    </Page.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <ui:Button
                DockPanel.Dock="Right"
                Content="Refresh"
                Icon="{ui:SymbolIcon ArrowSync24}"
                Command="{Binding RefreshCommand}"
                IsEnabled="{Binding IsNotBusy}" />
            <TextBlock
                VerticalAlignment="Center"
                Foreground="White"
                Opacity="0.8"
                TextWrapping="Wrap"
                Text="Every installed mod that declares dependencies, and whether each one is satisfied. Mods needing attention are listed first and start expanded." />
        </DockPanel>

        <TextBlock
            Grid.Row="1"
            Margin="0,0,0,12"
            TextWrapping="Wrap"
            Opacity="0.7"
            Foreground="White"
            Text="{Binding StatusMessage}" />

        <!-- Shown once a scan has finished and found nothing to report. -->
        <TextBlock
            Grid.Row="2"
            MaxWidth="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            TextAlignment="Center"
            TextWrapping="Wrap"
            Foreground="White"
            Opacity="0.6"
            Text="Nothing installed declares a dependency."
            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />

        <ScrollViewer
            Grid.Row="2"
            VerticalScrollBarVisibility="Auto"
            Visibility="{Binding Trees.Count, Converter={StaticResource HasItems}}">
            <ItemsControl ItemsSource="{Binding Trees}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- One expander per installed mod, holding its flattened dependency rows. -->
                        <ui:CardExpander Margin="0,0,0,8" IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                            <ui:CardExpander.Header>
                                <Grid Margin="0,0,12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ui:SymbolIcon
                                        Grid.Column="0"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        Symbol="{Binding Glyph}"
                                        Foreground="{Binding Worst, Converter={StaticResource StatusBrush}}" />

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding ModName, Mode=OneWay}" />
                                            <Run Text="{Binding ModVersion, StringFormat=' {0}', Mode=OneWay}" Foreground="#99FFFFFF" />
                                        </TextBlock>
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="11"
                                            Opacity="0.7"
                                            Text="{Binding Summary}" />
                                    </StackPanel>
                                </Grid>
                            </ui:CardExpander.Header>

                            <ItemsControl ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- Indent reflects depth in the tree; a nested dependency sits under its parent. -->
                                        <Grid Margin="{Binding Indent}" Height="34">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ui:SymbolIcon
                                                Grid.Column="0"
                                                Margin="0,0,10,0"
                                                VerticalAlignment="Center"
                                                FontSize="16"
                                                Symbol="{Binding Glyph}"
                                                Foreground="{Binding Status, Converter={StaticResource StatusBrush}}" />

                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Name, Mode=OneWay}" />
                                                <Run Text="{Binding StatusText, StringFormat=' - {0}', Mode=OneWay}" Foreground="#99FFFFFF" />
                                            </TextBlock>

                                            <!-- Only rows that are actually missing or outdated get an action. -->
                                            <ui:Button
                                                Grid.Column="2"
                                                Padding="10,2"
                                                VerticalAlignment="Center"
                                                Appearance="Secondary"
                                                Content="{Binding InstallButtonText}"
                                                Command="{Binding DataContext.InstallCommand, RelativeSource={RelativeSource AncestorType={x:Type Page}}}"
                                                CommandParameter="{Binding}"
                                                Visibility="{Binding CanInstall, Converter={StaticResource BoolToVisibility}}"
                                                IsEnabled="{Binding IsNotQueued}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ui:CardExpander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
